        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E3E6EA"
              }
            },
            "radius": 12
          }
        ],
        "visualHeader": [
          {
            "show": false
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ]
      }
    },
    "page": {
