    },
    "pivotTable": {
      "*": {
        "columnHeaders": [
          {
            "alignment": "Center",
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColor": {
              "solid": {
                "color": "#0B1F33"
              }
            }
          }
        ]
      }
    }
