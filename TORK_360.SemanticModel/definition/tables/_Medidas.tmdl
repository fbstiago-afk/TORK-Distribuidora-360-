	/// Ponte Preço–Volume–Mix da receita líquida contra o mesmo intervalo do ano anterior, com SKUs novos e descontinuados separados. Eixo vertical truncado, sinalizado na nota.
	measure 'HTML | Ponte PVM' =
			VAR _l0 = [Receita Líquida LY]
			VAR _p = [PVM Preço]
			VAR _v = [PVM Volume]
			VAR _m = [PVM Mix]
			VAR _n = [PVM Novos]
			VAR _d = [PVM Descontinuados]
			VAR _l1 = _l0 + _p
			VAR _l2 = _l1 + _v
			VAR _l3 = _l2 + _m
			VAR _l4 = _l3 + _n
			VAR _l5 = _l4 + _d
			VAR _max = MAX ( MAX ( MAX ( _l0, _l1 ), MAX ( _l2, _l3 ) ), MAX ( _l4, _l5 ) )
			VAR _min = MIN ( MIN ( MIN ( _l0, _l1 ), MIN ( _l2, _l3 ) ), MIN ( _l4, _l5 ) )
			VAR _lo = MAX ( 0, _min - ( _max - _min ) * 0.6 )
			VAR _sc = DIVIDE ( 160, _max - _lo )
			RETURN
			    IF ( ISBLANK ( _l0 ), [HTML | CSS] & "<div class='tk' style='display:flex;align-items:center;justify-content:center;color:#6C737D;font-size:12px;text-align:center;padding:20px'>Sem ano anterior comparável no período selecionado. O PVM precisa de um intervalo com base em 2024 ou 2025.</div>",
			        [HTML | CSS] & "<div class='tk'>" & "<svg class='tk-sv' viewBox='0 0 700 250' preserveAspectRatio='xMidYMid meet' font-family='Montserrat,Segoe UI,Arial'><line x1='16' y1='206' x2='684' y2='206' stroke='#C5CBD3' stroke-width='1'/>" & "<rect x='20.0' y='" & FORMAT ( ( 206 - ( ( _l0 ) - _lo ) * _sc ), "0.0", "en-US" ) & "' width='54' height='" & FORMAT ( MAX ( 1.5, 206 - ( 206 - ( ( _l0 ) - _lo ) * _sc ) ), "0.0", "en-US" ) & "' rx='3' fill='" & "#6C737D" & "'/>" & "<line x1='74.0' x2='121.0' y1='" & FORMAT ( ( 206 - ( ( _l0 ) - _lo ) * _sc ), "0.0", "en-US" ) & "' y2='" & FORMAT ( ( 206 - ( ( _l0 ) - _lo ) * _sc ), "0.0", "en-US" ) & "' stroke='#9AA3AE' stroke-width='1' stroke-dasharray='3 2'/>" & "<text x='47.0' y='" & FORMAT ( ( 206 - ( ( _l0 ) - _lo ) * _sc ) - 6, "0.0", "en-US" ) & "' text-anchor='middle' font-size='11' font-weight='700' fill='#0B1F33'>" & SWITCH ( TRUE (), ISBLANK ( _l0 ), "–", ABS ( _l0 ) >= 1e9, "R$ " & FORMAT ( _l0 / 1e9, "#,0.00", "pt-BR" ) & " bi", ABS ( _l0 ) >= 1e6, "R$ " & FORMAT ( _l0 / 1e6, "#,0.0", "pt-BR" ) & " mi", ABS ( _l0 ) >= 1e3, "R$ " & FORMAT ( _l0 / 1e3, "#,0", "pt-BR" ) & " mil", "R$ " & FORMAT ( _l0, "#,0", "pt-BR" ) ) & "</text>" & "<text x='47.0' y='221' text-anchor='middle' font-size='10' font-weight='700' fill='#16212E'>Receita AA</text>" & "<text x='47.0' y='234' text-anchor='middle' font-size='9.5' font-weight='500' fill='#6C737D'>" & "mesmo intervalo" & "</text>" & "<rect x='121.0' y='" & FORMAT ( ( 206 - ( ( MAX ( _l0, _l1 ) ) - _lo ) * _sc ), "0.0", "en-US" ) & "' width='54' height='" & FORMAT ( MAX ( 1.5, ( 206 - ( ( MIN ( _l0, _l1 ) ) - _lo ) * _sc ) - ( 206 - ( ( MAX ( _l0, _l1 ) ) - _lo ) * _sc ) ), "0.0", "en-US" ) & "' rx='3' fill='" & IF ( _p >= 0, "#14804A", "#E31E24" ) & "'/>" & "<line x1='175.0' x2='222.0' y1='" & FORMAT ( ( 206 - ( ( _l1 ) - _lo ) * _sc ), "0.0", "en-US" ) & "' y2='" & FORMAT ( ( 206 - ( ( _l1 ) - _lo ) * _sc ), "0.0", "en-US" ) & "' stroke='#9AA3AE' stroke-width='1' stroke-d