/// Tabela de medidas do modelo TORK 360°.
table _Medidas
	lineageTag: 71a36248-494d-56f2-8878-31809b87ee45

	/// DataCorteAnalise. Padrão 08/10/2026 (realizado). No modo demonstração usa o horizonte sintético completo (31/10/2026).
	measure 'Data Corte' = IF ( SELECTEDVALUE ( pModo[ModoID], 1 ) = 2, DATE ( 2026, 10, 31 ), DATE ( 2026, 10, 8 ) )
		formatString: dd/MM/yyyy
		displayFolder: 00 Configuração
		lineageTag: 4d3f5c91-09c8-5c37-af51-3f845a9e8054

	/// Primeira data do contexto de filtro.
	measure 'Período Início' = MIN ( dCalendario[Data] )
		formatString: dd/MM/yyyy
		displayFolder: 00 Configuração
		lineageTag: b983fbf1-57e4-5d0b-89b0-07b08878cfb6

	/// Última data do contexto, limitada à data de corte.
	measure 'Período Fim' =
			VAR _c = [Data Corte]
			VAR _m = MAX ( dCalendario[Data] )
			RETURN IF ( _m > _c, _c, _m )
		formatString: dd/MM/yyyy
		displayFolder: 00 Configuração
		lineageTag: 3c311595-378d-5481-8c78-3047a177c337

	/// Dias corridos entre início e fim do período (até o corte).
	measure 'Dias no Período' =
			VAR _i = [Período Início]
			VAR _f = [Período Fim]
			RETURN IF ( _f >= _i, DATEDIFF ( _i, _f, DAY ) + 1 )
		formatString: #,0
		displayFolder: 00 Configuração
		lineageTag: b817e41c-6ac4-58a5-bf3b-ef61a6ca346b

	/// Dias do período convertidos em meses médios (30,4375 dias).
	measure 'Meses no Período' = DIVIDE ( [Dias no Período], 30.4375 )
		formatString: #,0.0
		displayFolder: 00 Configuração
		lineageTag: fd7f78c7-a7bb-5ca3-a688-e2dd9ce193f9

	/// Dias úteis do contexto até a data de corte (feriados fixos nacionais apenas).
	measure 'Dias Úteis no Período' =
			VAR _c = [Data Corte]
			RETURN SUMX ( FILTER ( dCalendario, dCalendario[Data] <= _c ), dCalendario[DiaUtil] )
		formatString: #,0
		displayFolder: 00 Configuração
		lineageTag: dac1ef13-d274-5540-bbe1-8e1271bd90dc

	/// Janela de inatividade selecionada (30/60/90 dias). Padrão 60.
	measure 'Dias Inatividade' = SELECTEDVALUE ( pInatividade[Dias], 60 )
		formatString: #,0
		displayFolder: 00 Configuração
		lineageTag: 7bc1acf5-1ef4-5b58-b412-d553f7db6dfe

	/// Multiplicador de demanda do cenário (base 1,00; otimista 1,15; pessimista 0,85).
	measure 'Fator Cenário' = SELECTEDVALUE ( pCenario[Fator], 1 )
		formatString: 0.00
		displayFolder: 00 Configuração
		lineageTag: 9e0a5f23-39b5-5c81-9e01-ac0fbaae73fc

	/// Horizonte da simulação de estoque em dias. Padrão 30.
	measure 'Horizonte Projeção' = SELECTEDVALUE ( pHorizonte[Dias], 30 )
		formatString: #,0
		displayFolder: 00 Configuração
		lineageTag: cebc6764-7956-5170-8d22-257228435bee

	/// Limiar de queda mês contra mês que dispara o destaque no gráfico. Padrão 10%.
	measure 'Limite Queda' = SELECTEDVALUE ( pQueda[Percentual], 0.10 )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 00 Configuração
		lineageTag: f1bcadbe-2876-50c8-964c-78eb07190a23

	/// Coeficiente de variação mensal máximo da classe X.
	measure 'XYZ Limite X' = 0.30
		formatString: 0.00
		displayFolder: 00 Configuração
		lineageTag: 785093e4-757c-52ba-80a6-094a5022a384

	/// Coeficiente de variação mensal máximo da classe Y; acima é Z.
	measure 'XYZ Limite Y' = 0.60
		formatString: 0.00
		displayFolder: 00 Configuração
		lineageTag: d6ba57db-4da1-5c36-8369-8ee737dece75

	/// Cobertura acima da qual o saldo é tratado como excesso.
	measure 'Cobertura Excesso Dias' = 120
		formatString: #,0
		displayFolder: 00 Configuração
		lineageTag: e533c473-fff7-5f57-b050-a8c831be569e

	/// Quantidade × preço de tabela, até a data de corte.
	measure 'Receita Bruta' =
			VAR _c = [Data Corte]
			RETURN CALCULATE ( SUM ( fVendas[ReceitaBruta] ), KEEPFILTERS ( fVendas[DataVenda] <= _c ) )
		formatString: "R$" #,0;-"R$" #,0;"R$" #,0
		displayFolder: 01 Vendas
		lineageTag: 0f5c32fa-c96c-5401-9fe6-edb07cb364e7

	/// Desconto concedido sobre o preço de tabela.
	measure Descontos =
			VAR _c = [Data Corte]
			RETURN CALCULATE ( SUM ( fVendas[DescontoValor] ), KEEPFILTERS ( fVendas[DataVenda] <= _c ) )
		formatString: "R$" #,0;-"R$" #,0;"R$" #,0
		displayFolder: 01 Vendas
		lineageTag: fabbd9c0-0637-583d-883c-986a3d43b99e

	/// Faturamento líquido (quantidade × preço de venda), até a data de corte.
	measure 'Receita Líquida' =
			VAR _c = [Data Corte]
			RETURN CALCULATE ( SUM ( fVendas[ReceitaLiquida] ), KEEPFILTERS ( fVendas[DataVenda] <= _c ) )
		formatString: "R$" #,0;-"R$" #,0;"R$" #,0
		displayFolder: 01 Vendas
		lineageTag: b7042ceb-57c3-5d3b-a033-2efa05a757a2

	/// Unidades vendidas até a data de corte.
	measure Quantidade =
			VAR _c = [Data Corte]
			RETURN CALCULATE ( SUM ( fVendas[Quantidade] ), KEEPFILTERS ( fVendas[DataVenda] <= _c ) )
		formatString: #,0
		displayFolder: 01 Vendas
		lineageTag: 7aa688d4-ba7b-5562-90e0-2cb68dc484bb

	/// Pedidos distintos. Na base cada pedido tem um único item.
	measure Pedidos =
			VAR _c = [Data Corte]
			RETURN CALCULATE ( DISTINCTCOUNT ( fVendas[PedidoID] ), KEEPFILTERS ( fVendas[DataVenda] <= _c ) )
		formatString: #,0
		displayFolder: 01 Vendas
		lineageTag: 97021a3f-3c04-53dc-93e5-ac8467975661

	/// Receita líquida por pedido.
	measure 'Ticket Médio' = DIVIDE ( [Receita Líquida], [Pedidos] )
		formatString: "R$" #,0.00;-"R$" #,0.00;"R$" #,0.00
		displayFolder: 01 Vendas
		lineageTag: a2e2b259-a0be-5371-924d-f2e457f65461

	/// Preço médio ponderado por unidade.
	measure 'Preço Médio' = DIVIDE ( [Receita Líquida], [Quantidade] )
		formatString: "R$" #,0.00;-"R$" #,0.00;"R$" #,0.00
		displayFolder: 01 Vendas
		lineageTag: 700d136b-3e75-5e36-9084-1a16d3fdb720

	/// Desconto médio ponderado pela receita bruta.
	measure 'Desconto %' = DIVIDE ( [Descontos], [Receita Bruta] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 01 Vendas
		lineageTag: 4b6491ee-0e81-59da-aa5b-c66ec20a8916

	/// Mesmo intervalo do ano anterior, truncado na data de corte (comparação de períodos equivalentes).
	measure 'Receita Líquida LY' =
			VAR _c = [Data Corte]
			RETURN
			    CALCULATE (
			        [Receita Líquida],
			        SAMEPERIODLASTYEAR ( FILTER ( VALUES ( dCalendario[Data] ), dCalendario[Data] <= _c ) )
			    )
		formatString: "R$" #,0;-"R$" #,0;"R$" #,0
		displayFolder: 01 Vendas
		lineageTag: f35d1980-587d-54d7-abc5-41f2678bdf3b

	/// Variação contra o mesmo intervalo do ano anterior.
	measure 'Receita YoY %' =
			VAR _a = [Receita Líquida]
			VAR _b = [Receita Líquida LY]
			RETURN IF ( NOT ISBLANK ( _a ) && NOT ISBLANK ( _b ), DIVIDE ( _a - _b, _b ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 01 Vendas
		lineageTag: 2431af2a-0172-5383-8115-3ca9f9eeec2c

	measure 'Quantidade LY' =
			VAR _c = [Data Corte]
			RETURN
			    CALCULATE (
			        [Quantidade],
			        SAMEPERIODLASTYEAR ( FILTER ( VALUES ( dCalendario[Data] ), dCalendario[Data] <= _c ) )
			    )
		formatString: #,0
		displayFolder: 01 Vendas
		lineageTag: da09db9d-86fe-598f-a366-eca1f8eb107e

	measure 'Quantidade YoY %' =
			VAR _a = [Quantidade]
			VAR _b = [Quantidade LY]
			RETURN IF ( NOT ISBLANK ( _a ) && NOT ISBLANK ( _b ), DIVIDE ( _a - _b, _b ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 01 Vendas
		lineageTag: b4705756-19de-5174-9f3b-26c73413dd26

	/// Mesmo intervalo de dias do mês anterior.
	measure 'Receita Líquida Mês Anterior' =
			VAR _c = [Data Corte]
			RETURN
			    CALCULATE (
			        [Receita Líquida],
			        DATEADD ( FILTER ( VALUES ( dCalendario[Data] ), dCalendario[Data] <= _c ), -1, MONTH )
			    )
		formatString: "R$" #,0;-"R$" #,0;"R$" #,0
		displayFolder: 01 Vendas
		lineageTag: b1b56fcc-3927-57b1-813f-251b84f158b0

	measure 'Receita MoM %' =
			VAR _a = [Receita Líquida]
			VAR _b = [Receita Líquida Mês Anterior]
			RETURN IF ( NOT ISBLANK ( _a ) && NOT ISBLANK ( _b ), DIVIDE ( _a - _b, _b ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 01 Vendas
		lineageTag: a9a0ddc7-5335-5c58-a47d-7ece8d46fe53

	/// Acumulado do ano até a última data do contexto e o corte.
	measure 'Receita YTD' = CALCULATE ( [Receita Líquida], DATESYTD ( dCalendario[Data] ) )
		formatString: "R$" #,0;-"R$" #,0;"R$" #,0
		displayFolder: 01 Vendas
		lineageTag: c1254c5f-ba87-52b2-9ecb-d1ad2f97651e

	/// Meta do grão mês/vendedor, proporcional aos dias úteis do contexto até o corte. Não responde a filtros de cliente ou produto.
	measure 'Meta Faturamento' =
			VAR _c = [Data Corte]
			RETURN
			    SUMX (
			        VALUES ( dCalendario[AnoMes] ),
			        VAR _m = dCalendario[AnoMes]
			        VAR _meta = CALCULATE ( SUM ( fMetas[MetaFaturamento] ), TREATAS ( { _m }, dMes[AnoMes] ) )
			            VAR _duTot = CALCULATE ( SUM ( dCalendario[DiaUtil] ), ALL ( dCalendario ), dCalendario[AnoMes] = _m )
			            VAR _duCtx = SUMX ( FILTER ( CALCULATETABLE ( dCalendario ), dCalendario[Data] <= _c ), dCalendario[DiaUtil] )
			            RETURN DIVIDE ( _meta * _duCtx, _duTot )
			    )
		formatString: "R$" #,0;-"R$" #,0;"R$" #,0
		displayFolder: 02 Metas
		lineageTag: 093da017-b8e8-5d4f-b9d8-00bbf1b3be4f

	/// Meta integral dos meses do contexto, sem proporcionalizar.
	measure 'Meta Faturamento Mês Cheio' =
			VAR _c = [Data Corte]
			RETURN
			    SUMX (
			        VALUES ( dCalendario[AnoMes] ),
			        VAR _m = dCalendario[AnoMes]
			        VAR _meta = CALCULATE ( SUM ( fMetas[MetaFaturamento] ), TREATAS ( { _m }, dMes[AnoMes] ) )
			            RETURN _meta
			    )
		formatString: "R$" #,0;-"R$" #,0;"R$" #,0
		displayFolder: 02 Metas
		lineageTag: 3d43597b-0a77-5ce9-9d09-fdc5f104c0e3

	/// Meta de margem proporcional aos dias úteis até o corte.
	measure 'Meta Margem' =
			VAR _c = [Data Corte]
			RETURN
			    SUMX (
			        VALUES ( dCalendario[AnoMes] ),
			        VAR _m = dCalendario[AnoMes]
			        VAR _meta = CALCULATE ( SUM ( fMetas[MetaMargem] ), TREATAS ( { _m }, dMes[AnoMes] ) )
			            VAR _duTot = CALCULATE ( SUM ( dCalendario[DiaUtil] ), ALL ( dCalendario ), dCalendario[AnoMes] = _m )
			            VAR _duCtx = SUMX ( FILTER ( CALCULATETABLE ( dCalendario ), dCalendario[Data] <= _c ), dCalendario[DiaUtil] )
			            RETURN DIVIDE ( _meta * _duCtx, _duTot )
			    )
		formatString: "R$" #,0;-"R$" #,0;"R$" #,0
		displayFolder: 02 Metas
		lineageTag: bc35d23d-4147-5d95-ab91-5ef4aad5a464

	/// Realizado menos meta proporcional.
	measure 'Gap Meta' = IF ( NOT ISBLANK ( [Meta Faturamento] ), [Receita Líquida] - [Meta Faturamento] )
		formatString: "R$" #,0;-"R$" #,0;"R$" #,0
		displayFolder: 02 Metas
		lineageTag: 5050594b-f4ee-53e5-b5d0-6415f122e5a6

	/// Realizado sobre meta proporcional ao período decorrido.
	measure 'Atingimento Meta %' = DIVIDE ( [Receita Líquida], [Meta Faturamento] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 02 Metas
		lineageTag: 19360f0f-451c-5eda-845b-60be29da2bfa

	/// Ritmo recente: receita dos 60 dias até o corte dividida pelos dias úteis da janela.
	measure 'Receita Média por Dia Útil 60d' =
			VAR _c = [Data Corte]
			VAR _rec = CALCULATE ( SUM ( fVendas[ReceitaLiquida] ), REMOVEFILTERS ( dCalendario ), fVendas[DataVenda] > _c - 60, fVendas[DataVenda] <= _c )
			VAR _du = SUMX ( FILTER ( ALL ( dCalendario ), dCalendario[Data] > _c - 60 && dCalendario[Data] <= _c ), dCalendario[DiaUtil] )
			RETURN DIVIDE ( _rec, _du )
		formatString: "R$" #,0;-"R$" #,0;"R$" #,0
		displayFolder: 02 Metas
		lineageTag: 46e43542-2c9d-5f3b-82a9-c9af68e47a8b

	/// SIMULAÇÃO. Realizado no mês do corte + ritmo por dia útil dos últimos 60 dias × dias úteis restantes. Ignora o filtro de período.
	measure 'Projeção Fechamento Mês' =
			VAR _c = [Data Corte]
			VAR _ini = DATE ( YEAR ( _c ), MONTH ( _c ), 1 )
			VAR _fim = EOMONTH ( _c, 0 )
			VAR _mtd = CALCULATE ( SUM ( fVendas[ReceitaLiquida] ), REMOVEFILTERS ( dCalendario ), fVendas[DataVenda] >= _ini, fVendas[DataVenda] <= _c )
			VAR _duRest = SUMX ( FILTER ( ALL ( dCalendario ), dCalendario[Data] > _c && dCalendario[Data] <= _fim ), dCalendario[DiaUtil] )
			RETURN _mtd + [Receita Média por Dia Útil 60d] * _duRest
		formatString: "R$" #,0;-"R$" #,0;"R$" #,0
		displayFolder: 02 Metas
		lineageTag: 824982db-a7d3-50ce-8133-b0de1aaaad09

	/// Meta integral do mês que contém a data de corte.
	measure 'Meta Mês do Corte' =
			VAR _c = [Data Corte]
			VAR _m = FORMAT ( _c, "yyyy-MM" )
			RETURN CALCULATE ( SUM ( fMetas[MetaFaturamento] ), TREATAS ( { _m }, dMes[AnoMes] ) )
		formatString: "R$" #,0;-"R$" #,0;"R$" #,0
		displayFolder: 02 Metas
		lineageTag: 18b2741d-a9e1-503a-a089-ece3cea59ced

	measure 'Projeção vs Meta %' = DIVIDE ( [Projeção Fechamento Mês], [Meta Mês do Corte] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 02 Metas
		lineageTag: a20c4f67-112b-52c8-96cb-d28b5a70c4a6

	/// Custo da mercadoria vendida.
	measure CMV =
			VAR _c = [Data Corte]
			RETURN CALCULATE ( SUM ( fVendas[CMV] ), KEEPFILTERS ( fVendas[DataVenda] <= _c ) )
		formatString: "R$" #,0;-"R$" #,0;"R$" #,0
		displayFolder: 03 Margem
		lineageTag: 33a7d4cc-4660-5292-93fc-c53841a44ca6

	/// Frete rateado por item vendido.
	measure Frete =
			VAR _c = [Data Corte]
			RETURN CALCULATE ( SUM ( fVendas[FreteRateado] ), KEEPFILTERS ( fVendas[DataVenda] <= _c ) )
		formatString: "R$" #,0;-"R$" #,0;"R$" #,0
		displayFolder: 03 Margem
		lineageTag: a4ebf1b6-50ce-51c4-b633-7380563504c8

	/// Comissão de vendas.
	measure Comissão =
			VAR _c = [Data Corte]
			RETURN CALCULATE ( SUM ( fVendas[Comissao] ), KEEPFILTERS ( fVendas[DataVenda] <= _c ) )
		formatString: "R$" #,0;-"R$" #,0;"R$" #,0
		displayFolder: 03 Margem
		lineageTag: 072ae35f-5e18-5465-85c1-3d3457d43b77

	/// Receita líquida menos CMV.
	measure 'Margem Bruta' = [Receita Líquida] - [CMV]
		formatString: "R$" #,0;-"R$" #,0;"R$" #,0
		displayFolder: 03 Margem
		lineageTag: 44ae7557-2d4d-58fd-a895-4d9cdc16e3c0

	measure 'Margem Bruta %' = DIVIDE ( [Margem Bruta], [Receita Líquida] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 03 Margem
		lineageTag: 98b41ef6-95f7-563c-b632-5db63ddd81cc

	/// Margem de contribuição operacional observável. Não é EBITDA: a base não tem despesas fixas.
	measure 'Margem Contribuição' = [Receita Líquida] - [CMV] - [Frete] - [Comissão]
		formatString: "R$" #,0;-"R$" #,0;"R$" #,0
		displayFolder: 03 Margem
		lineageTag: 6610b8fe-0ab1-57d7-908a-6e2fd10701da

	measure 'MC %' = DIVIDE ( [Margem Contribuição], [Receita Líquida] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 03 Margem
		lineageTag: e28e2ba6-5d6d-5944-8754-8723faa3cd6f

	measure 'Margem Contribuição LY' =
			VAR _c = [Data Corte]
			RETURN
			    CALCULATE (
			        [Margem Contribuição],
			        SAMEPERIODLASTYEAR ( FILTER ( VALUES ( dCalendario[Data] ), dCalendario[Data] <= _c ) )
			    )
		formatString: "R$" #,0;-"R$" #,0;"R$" #,0
		displayFolder: 03 Margem
		lineageTag: dd77d4eb-c8d2-5934-b963-b771065ae75d

	measure 'MC YoY %' =
			VAR _a = [Margem Contribuição]
			VAR _b = [Margem Contribuição LY]
			RETURN IF ( NOT ISBLANK ( _a ) && NOT ISBLANK ( _b ), DIVIDE ( _a - _b, _b ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 03 Margem
		lineageTag: a61ed344-9817-521e-bffd-5d916647de5b

	measure 'MC % LY' =
			VAR _c = [Data Corte]
			RETURN
			    CALCULATE (
			        [MC %],
			        SAMEPERIODLASTYEAR ( FILTER ( VALUES ( dCalendario[Data] ), dCalendario[Data] <= _c ) )
			    )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 03 Margem
		lineageTag: 64096aab-2692-5a5a-b90a-dfdd68b30a80

	/// Variação da MC % em pontos percentuais contra o mesmo intervalo do ano anterior.
	measure 'MC Variação pp' =
			VAR _a = [MC %]
			VAR _b = [MC % LY]
			RETURN IF ( NOT ISBLANK ( _a ) && NOT ISBLANK ( _b ), ( _a - _b ) * 100 )
		formatString: +0.0;-0.0;0.0
		displayFolder: 03 Margem
		lineageTag: b2df72d0-10bc-57e4-9a9a-9260c5a1be01

	measure 'Margem Bruta % LY' =
			VAR _c = [Data Corte]
			RETURN
			    CALCULATE (
			        [Margem Bruta %],
			        SAMEPERIODLASTYEAR ( FILTER ( VALUES ( dCalendario[Data] ), dCalendario[Data] <= _c ) )
			    )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 03 Margem
		lineageTag: 7482ea59-ec14-55d9-bd05-0087a89685c8

	measure 'Desconto % LY' =
			VAR _c = [Data Corte]
			RETURN
			    CALCULATE (
			        [Desconto %],
			        SAMEPERIODLASTYEAR ( FILTER ( VALUES ( dCalendario[Data] ), dCalendario[Data] <= _c ) )
			    )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 03 Margem
		lineageTag: bf416832-c62f-5a59-871d-1291fc5a96f6

	/// Efeito em R$ da variação de MC % sobre a receita atual: (MC % − MC % LY) × receita líquida.
	measure 'Impacto Margem' =
			VAR _pp = [MC %] - [MC % LY]
			RETURN IF ( NOT ISBLANK ( [MC % LY] ), _pp * [Receita Líquida] )
		formatString: "R$" #,0;-"R$" #,0;"R$" #,0
		displayFolder: 03 Margem
		lineageTag: 5ee5ce4f-e67e-5bd8-bb87-d33534a9fcc9

	/// Clientes com ao menos uma compra no período.
	measure 'Clientes Ativos' =
			VAR _c = [Data Corte]
			RETURN CALCULATE ( DISTINCTCOUNT ( fVendas[ClienteID] ), KEEPFILTERS ( fVendas[DataVenda] <= _c ) )
		formatString: #,0
		displayFolder: 04 Clientes
		lineageTag: d798cbd4-1508-57a6-a28b-4aff6e14a664

	measure 'Clientes Ativos LY' =
			VAR _c = [Data Corte]
			RETURN
			    CALCULATE (
			        [Clientes Ativos],
			        SAMEPERIODLASTYEAR ( FILTER ( VALUES ( dCalendario[Data] ), dCalendario[Data] <= _c ) )
			    )
		formatString: #,0
		displayFolder: 04 Clientes
		lineageTag: b7056ec2-5e2c-528e-accd-f6e3a040e911

	measure 'Clientes Ativos YoY %' =
			VAR _a = [Clientes Ativos]
			VAR _b = [Clientes Ativos LY]
			RETURN IF ( NOT ISBLANK ( _a ) && NOT ISBLANK ( _b ), DIVIDE ( _a - _b, _b ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 04 Clientes
		lineageTag: 94628de0-d9e5-55fa-aba6-39bb5af8ff28

	/// Clientes cadastrados até o fim do período, na carteira dos vendedores e filiais filtrados.
	measure 'Clientes Carteira' =
			VAR _f = [Período Fim]
			RETURN
			    CALCULATE (
			        COUNTROWS ( dCliente ),
			        KEEPFILTERS ( dCliente[DataCadastro] <= _f ),
			        TREATAS ( VALUES ( dVendedor[VendedorID] ), dCliente[VendedorID] ),
			        TREATAS ( VALUES ( dFilial[FilialID] ), dCliente[FilialID] )
			    )
		formatString: #,0
		displayFolder: 04 Clientes
		lineageTag: 6328ca93-ff54-5b8c-9171-93c43cd1149d

	/// Clientes que compraram no período sobre a carteira cadastrada.
	measure 'Positivação %' = DIVIDE ( [Clientes Ativos], [Clientes Carteira] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 04 Clientes
		lineageTag: c49d7452-88d1-51e9-bc73-6398d064586e

	/// Clientes cuja primeira compra de toda a série ocorreu no período.
	measure 'Clientes Novos' =
			VAR _i = [Período Início]
			VAR _f = [Período Fim]
			RETURN CALCULATE ( [Clientes Ativos], KEEPFILTERS ( dCliente[PrimeiraCompra] >= _i && dCliente[PrimeiraCompra] <= _f ) )
		formatString: #,0
		displayFolder: 04 Clientes
		lineageTag: 7b8097bf-f635-5a60-ae06-febaa7d061e7

	/// Clientes ativos no período cuja última compra anterior ao início do período tinha mais de N dias (N = janela de inatividade).
	measure 'Clientes Reativados' =
			VAR _i = [Período Início]
			VAR _n = [Dias Inatividade]
			VAR _c = [Data Corte]
			VAR _ativos = CALCULATETABLE ( SUMMARIZE ( fVendas, dCliente[ClienteID] ), KEEPFILTERS ( fVendas[DataVenda] <= _c ) )
			RETURN
			    COUNTROWS (
			        FILTER (
			            _ativos,
			            VAR _ant = CALCULATE ( MAX ( fVendas[DataVenda] ), REMOVEFILTERS ( dCalendario ), fVendas[DataVenda] < _i )
			            RETURN NOT ISBLANK ( _ant ) && DATEDIFF ( _ant, _i, DAY ) > _n
			        )
			    )
		formatString: #,0
		displayFolder: 04 Clientes
		lineageTag: ba8cfeee-b1f1-5406-bf3d-60c88097057d

	/// Clientes que já compraram e estão há mais de N dias sem comprar na data final do período.
	measure 'Clientes Inativos' =
			VAR _f = [Período Fim]
			VAR _n = [Dias Inatividade]
			RETURN
			    COUNTROWS (
			        FILTER (
			            VALUES ( dCliente[ClienteID] ),
			            VAR _ult = CALCULATE ( MAX ( fVendas[DataVenda] ), REMOVEFILTERS ( dCalendario ), fVendas[DataVenda] <= _f )
			            RETURN NOT ISBLANK ( _ult ) && DATEDIFF ( _ult, _f, DAY ) > _n
			        )
			    )
		formatString: #,0
		displayFolder: 04 Clientes
		lineageTag: cd9f9a6a-753b-581e-8377-a85614b41f9c

	/// Data do último pedido até o fim do período.
	measure 'Última Compra' =
			VAR _f = [Período Fim]
			RETURN CALCULATE ( MAX ( fVendas[DataVenda] ), REMOVEFILTERS ( dCalendario ), fVendas[DataVenda] <= _f )
		formatString: dd/MM/yyyy
		displayFolder: 04 Clientes
		lineageTag: 80b0f026-8982-509c-8b97-72c7ded8cf3f

	measure 'Recência Dias' =
			VAR _u = [Última Compra]
			RETURN IF ( NOT ISBLANK ( _u ), DATEDIFF ( _u, [Período Fim], DAY ) )
		formatString: #,0
		displayFolder: 04 Clientes
		lineageTag: 24e12a95-3e87-507e-9b40-49e7fbd1c631

	/// Pedidos por cliente ativo por mês.
	measure 'Frequência Mensal' = DIVIDE ( DIVIDE ( [Pedidos], [Clientes Ativos] ), [Meses no Período] )
		formatString: #,0.0
		displayFolder: 04 Clientes
		lineageTag: a46e4f82-f201-5f05-a143-3a4076eaf290

	/// Média de SKUs distintos comprados por cliente ativo no período.
	measure 'Mix Médio SKUs' =
			VAR _c = [Data Corte]
			RETURN
			    AVERAGEX (
			        CALCULATETABLE ( SUMMARIZE ( fVendas, dCliente[ClienteID] ), KEEPFILTERS ( fVendas[DataVenda] <= _c ) ),
			        CALCULATE ( DISTINCTCOUNT ( fVendas[ProdutoID] ), KEEPFILTERS ( fVendas[DataVenda] <= _c ) )
			    )
		formatString: #,0.0
		displayFolder: 04 Clientes
		lineageTag: 36bee183-9592-5b90-84d1-df4f6932e19a

	/// Média de categorias distintas compradas por cliente ativo.
	measure 'Categorias por Cliente' =
			VAR _c = [Data Corte]
			RETURN
			    AVERAGEX (
			        CALCULATETABLE ( SUMMARIZE ( fVendas, dCliente[ClienteID] ), KEEPFILTERS ( fVendas[DataVenda] <= _c ) ),
			        CALCULATE ( COUNTROWS ( SUMMARIZE ( fVendas, dProduto[Categoria] ) ), KEEPFILTERS ( fVendas[DataVenda] <= _c ) )
			    )
		formatString: #,0.0
		displayFolder: 04 Clientes
		lineageTag: f61b001a-c9a0-57a7-935a-2edfbc43409d

	/// Receita líquida do período dividida pelos meses do período.
	measure 'Compra Mensal Normalizada' = DIVIDE ( [Receita Líquida], [Meses no Período] )
		formatString: "R$" #,0;-"R$" #,0;"R$" #,0
		displayFolder: 04 Clientes
		lineageTag: 31d62391-c15d-50ce-8281-8c874795aa99

	/// ESTIMADO. Hipótese sintética cadastral, não é mercado medido.
	measure 'Potencial Mensal Estimado' =
			CALCULATE (
			    SUM ( dCliente[PotencialMensalEstimado] ),
			    TREATAS ( VALUES ( dVendedor[VendedorID] ), dCliente[VendedorID] ),
			    TREATAS ( VALUES ( dFilial[FilialID] ), dCliente[FilialID] )
			)
		formatString: "R$" #,0;-"R$" #,0;"R$" #,0
		displayFolder: 04 Clientes
		lineageTag: d2c42055-ccd7-511e-a97c-205ec720186f

	/// ESTIMADO. Compra mensal normalizada dos clientes ativos sobre o potencial mensal deles. Acima de 100% indica potencial subestimado, não participação real.
	measure 'Share Estimado %' =
			VAR _c = [Data Corte]
			VAR _cli = CALCULATETABLE ( SUMMARIZE ( fVendas, dCliente[ClienteID] ), KEEPFILTERS ( fVendas[DataVenda] <= _c ) )
			VAR _pot = CALCULATE ( SUM ( dCliente[PotencialMensalEstimado] ), _cli )
			RETURN DIVIDE ( [Compra Mensal Normalizada], _pot )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 04 Clientes
		lineageTag: 41295977-8547-5346-8c61-3e5c85e0d3e8

	/// ESTIMADO. Soma, por cliente ativo, do potencial mensal menos a compra mensal, quando positivo. Não é demanda confirmada.
	measure 'Gap Potencial Estimado' =
			VAR _c = [Data Corte]
			VAR _meses = [Meses no Período]
			RETURN
			    SUMX (
			        CALCULATETABLE ( SUMMARIZE ( fVendas, dCliente[ClienteID] ), KEEPFILTERS ( fVendas[DataVenda] <= _c ) ),
			        VAR _pot = CALCULATE ( SUM ( dCliente[PotencialMensalEstimado] ) )
			        VAR _compra = DIVIDE ( CALCULATE ( SUM ( fVendas[ReceitaLiquida] ), KEEPFILTERS ( fVendas[DataVenda] <= _c ) ), _meses )
			        RETURN MAX ( 0, _pot - _compra )
			    )
		formatString: "R$" #,0;-"R$" #,0;"R$" #,0
		displayFolder: 04 Clientes
		lineageTag: aa22e0b9-8f26-546e-b754-e33dda7eccd1

	/// Participação dos 10 maiores clientes na receita do contexto.
	measure 'Concentração Top 10 %' =
			VAR _t = ADDCOLUMNS ( VALUES ( dCliente[ClienteID] ), "@r", [Receita Líquida] )
			VAR _top = TOPN ( 10, _t, [@r], DESC )
			RETURN DIVIDE ( SUMX ( _top, [@r] ), SUMX ( _t, [@r] ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 04 Clientes
		lineageTag: c42e11de-01a1-57c2-b759-e91ccd736712

	/// Interações comerciais registradas até o corte. Sem vínculo causal com pedidos.
	measure Visitas =
			VAR _c = [Data Corte]
			RETURN CALCULATE ( COUNTROWS ( fVisitas ), KEEPFILTERS ( fVisitas[DataVisita] <= _c ) )
		formatString: #,0
		displayFolder: 04 Clientes
		lineageTag: 3b627438-1ae9-551e-bfb1-acde45693a5b

	/// Clientes ativos no período ignorando filtros de produto.
	measure 'Clientes Ativos Todas Categorias' = CALCULATE ( [Clientes Ativos], REMOVEFILTERS ( dProduto ) )
		formatString: #,0
		displayFolder: 04 Clientes
		lineageTag: c918b86e-f358-5bd4-aae1-0b724f598205

	/// Clientes ativos em outras categorias que não compraram a categoria da linha no período.
	measure 'Clientes Sem a Categoria' =
			VAR _a = [Clientes Ativos Todas Categorias]
			RETURN IF ( NOT ISBLANK ( _a ), _a - [Clientes Ativos] )
		formatString: #,0
		displayFolder: 04 Clientes
		lineageTag: dd15a5b5-5b83-5a41-af86-3a0c5e331b32

	measure 'Penetração Categoria %' = DIVIDE ( [Clientes Ativos], [Clientes Ativos Todas Categorias] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 04 Clientes
		lineageTag: 8ff1fd76-5856-5294-b278-90fe2423a930

	measure 'Receita por Comprador' = DIVIDE ( [Receita Líquida], [Clientes Ativos] )
		formatString: "R$" #,0;-"R$" #,0;"R$" #,0
		displayFolder: 04 Clientes
		lineageTag: 74909b67-8fd6-567c-be59-346065d7618a

	/// HIPOTÉTICO. Não compradores × metade da receita média por comprador da categoria. É um teto de referência, não previsão.
	measure 'Cross-sell Potencial Hipotético' =
			VAR _n = [Clientes Sem a Categoria]
			RETURN IF ( HASONEVALUE ( dProduto[Categoria] ), _n * [Receita por Comprador] * 0.5 )
		formatString: "R$" #,0;-"R$" #,0;"R$" #,0
		displayFolder: 04 Clientes
		lineageTag: fd345b85-3f40-5ac4-8912-7c2487968922

	/// Último sábado com snapshot até o fim do período. Saldos nunca são somados entre semanas.
	measure 'Data Último Snapshot' =
			VAR _f = [Período Fim]
			RETURN CALCULATE ( MAX ( fEstoque[Data] ), REMOVEFILTERS ( dCalendario ), fEstoque[Data] <= _f )
		formatString: dd/MM/yyyy
		displayFolder: 05 Estoque
		lineageTag: b3a92373-c258-5fe1-899b-3091a2c57fad

	measure 'Defasagem Snapshot Dias' = DATEDIFF ( [Data Último Snapshot], [Período Fim], DAY )
		formatString: #,0
		displayFolder: 05 Estoque
		lineageTag: 9a603b93-5b5a-551e-ac5d-4ab913d4ac4c

	/// Saldo em unidades no último snapshot.
	measure 'Estoque Qtd' =
			VAR _s = [Data Último Snapshot]
			RETURN CALCULATE ( SUM ( fEstoque[EstoqueFinal] ), REMOVEFILTERS ( dCalendario ), fEstoque[Data] = _s )
		formatString: #,0
		displayFolder: 05 Estoque
		lineageTag: ead5f8b7-285c-57fb-ac9e-e721d439208c

	/// Valor do estoque a custo médio no último snapshot.
	measure 'Estoque Valor' =
			VAR _s = [Data Último Snapshot]
			RETURN CALCULATE ( SUM ( fEstoque[ValorEstoque] ), REMOVEFILTERS ( dCalendario ), fEstoque[Data] = _s )
		formatString: "R$" #,0;-"R$" #,0;"R$" #,0
		displayFolder: 05 Estoque
		lineageTag: fbdf491e-796d-52b3-a5e5-97ffad7e7fad

	measure 'Estoque Segurança' =
			VAR _s = [Data Último Snapshot]
			RETURN CALCULATE ( SUM ( fEstoque[EstoqueSeguranca] ), REMOVEFILTERS ( dCalendario ), fEstoque[Data] = _s )
		formatString: #,0
		displayFolder: 05 Estoque
		lineageTag: b93bb144-9864-5dd0-9bef-bb6a8d2eed79

	measure 'Ponto Reposição' =
			VAR _s = [Data Último Snapshot]
			RETURN CALCULATE ( SUM ( fEstoque[PontoReposicao] ), REMOVEFILTERS ( dCalendario ), fEstoque[Data] = _s )
		formatString: #,0
		displayFolder: 05 Estoque
		lineageTag: 3247d63b-9531-57cb-b2f2-4cfc9550f696

	/// Unidades vendidas nos 90 dias até o snapshot.
	measure 'Qtd Vendida 90d' =
			VAR _s = [Data Último Snapshot]
			RETURN CALCULATE ( SUM ( fVendas[Quantidade] ), REMOVEFILTERS ( dCalendario ), fVendas[DataVenda] > _s - 90, fVendas[DataVenda] <= _s )
		formatString: #,0
		displayFolder: 05 Estoque
		lineageTag: 00cb07b5-2b83-5f54-a5b4-4121abe4007b

	measure 'CMV 90d' =
			VAR _s = [Data Último Snapshot]
			RETURN CALCULATE ( SUM ( fVendas[CMV] ), REMOVEFILTERS ( dCalendario ), fVendas[DataVenda] > _s - 90, fVendas[DataVenda] <= _s )
		formatString: "R$" #,0;-"R$" #,0;"R$" #,0
		displayFolder: 05 Estoque
		lineageTag: 11376320-3f1d-5c7c-9ac8-40eacda6e68b

	/// Unidades por dia nos 90 dias até o snapshot.
	measure 'Venda Média Diária' = DIVIDE ( [Qtd Vendida 90d], 90 )
		formatString: #,0.0
		displayFolder: 05 Estoque
		lineageTag: 3ffde179-dc01-5289-95c5-1a314691d4a9

	/// Valor em estoque sobre o CMV diário dos últimos 90 dias. Em uma linha de SKU equivale a saldo ÷ venda média diária.
	measure 'Cobertura Dias' =
			VAR _v = [Estoque Valor]
			VAR _d = DIVIDE ( [CMV 90d], 90 )
			RETURN IF ( NOT ISBLANK ( _v ), DIVIDE ( _v, _d ) )
		formatString: #,0
		displayFolder: 05 Estoque
		lineageTag: 8248b948-1212-5993-b03f-63107b586ae7

	/// CMV dos 12 meses até o snapshot sobre o estoque médio semanal do mesmo intervalo.
	measure 'Giro Anual' =
			VAR _s = [Data Último Snapshot]
			VAR _cmv = CALCULATE ( SUM ( fVendas[CMV] ), REMOVEFILTERS ( dCalendario ), fVendas[DataVenda] > _s - 365, fVendas[DataVenda] <= _s )
			VAR _datas = CALCULATETABLE ( VALUES ( fEstoque[Data] ), REMOVEFILTERS ( dCalendario ), fEstoque[Data] > _s - 365, fEstoque[Data] <= _s )
			VAR _medio = AVERAGEX ( _datas, CALCULATE ( SUM ( fEstoque[ValorEstoque] ), REMOVEFILTERS ( dCalendario ) ) )
			RETURN DIVIDE ( _cmv, _medio )
		formatString: 0.0"x"
		displayFolder: 05 Estoque
		lineageTag: 38e590c2-63fe-52c1-9b05-575ee1208974

	/// Combinações SKU × filial no último snapshot.
	measure 'Itens Estoque' =
			VAR _s = [Data Último Snapshot]
			RETURN CALCULATE ( COUNT ( fEstoque[EstoqueFinal] ), REMOVEFILTERS ( dCalendario ), fEstoque[Data] = _s )
		formatString: #,0
		displayFolder: 05 Estoque
		lineageTag: 4931fe0f-ca5b-5afc-a42e-106cf09f6b5a

	/// OBSERVADO. SKU × filial com saldo zero no último snapshot.
	measure 'Itens em Ruptura' =
			VAR _s = [Data Último Snapshot]
			RETURN
			    CALCULATE (
			        COUNTROWS ( FILTER ( fEstoque, fEstoque[EstoqueFinal] = 0 ) ),
			        REMOVEFILTERS ( dCalendario ),
			        fEstoque[Data] = _s
			    ) + 0
		formatString: #,0
		displayFolder: 05 Estoque
		lineageTag: c7706158-d8d5-5978-81c0-6973e912abf0

	measure 'Ruptura Observada %' = DIVIDE ( [Itens em Ruptura], [Itens Estoque] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 05 Estoque
		lineageTag: 05bb7ff9-a629-5389-b925-cf6b85e2e737

	/// SKU × filial com saldo positivo abaixo do estoque de segurança.
	measure 'Itens Abaixo Segurança' =
			VAR _s = [Data Último Snapshot]
			RETURN
			    CALCULATE (
			        COUNTROWS ( FILTER ( fEstoque, fEstoque[EstoqueFinal] > 0 && fEstoque[EstoqueFinal] < fEstoque[EstoqueSeguranca] ) ),
			        REMOVEFILTERS ( dCalendario ),
			        fEstoque[Data] = _s
			    ) + 0
		formatString: #,0
		displayFolder: 05 Estoque
		lineageTag: 2dd155cf-8afd-54a2-90cf-b007e64f3443

	/// SKU × filial no ponto de reposição ou abaixo.
	measure 'Itens Abaixo Ponto Reposição' =
			VAR _s = [Data Último Snapshot]
			RETURN
			    CALCULATE (
			        COUNTROWS ( FILTER ( fEstoque, fEstoque[EstoqueFinal] <= fEstoque[PontoReposicao] ) ),
			        REMOVEFILTERS ( dCalendario ),
			        fEstoque[Data] = _s
			    ) + 0
		formatString: #,0
		displayFolder: 05 Estoque
		lineageTag: e17bcddf-462d-5825-8ae5-deb649de67b2

	/// Valor do saldo que excede 120 dias de cobertura, por SKU × filial. Itens sem venda em 90 dias entram integralmente.
	measure 'Estoque Excesso Valor' =
			VAR _s = [Data Último Snapshot]
			VAR _t =
			    ADDCOLUMNS (
			        SUMMARIZE (
			            CALCULATETABLE ( fEstoque, REMOVEFILTERS ( dCalendario ), fEstoque[Data] = _s ),
			            dProduto[ProdutoID],
			            dFilial[FilialID]
			        ),
			        "@q", CALCULATE ( SUM ( fEstoque[EstoqueFinal] ), REMOVEFILTERS ( dCalendario ), fEstoque[Data] = _s ),
			        "@v", CALCULATE ( SUM ( fEstoque[ValorEstoque] ), REMOVEFILTERS ( dCalendario ), fEstoque[Data] = _s ),
			        "@d", DIVIDE ( CALCULATE ( SUM ( fVendas[Quantidade] ), REMOVEFILTERS ( dCalendario ), fVendas[DataVenda] > _s - 90, fVendas[DataVenda] <= _s ), 90 )
			    )
			VAR _lim = [Cobertura Excesso Dias]
			RETURN
			    SUMX (
			        _t,
			        VAR _exc = [@q] - [@d] * _lim
			        RETURN IF ( [@q] > 0 && _exc > 0, DIVIDE ( _exc, [@q] ) * [@v] )
			    )
		formatString: "R$" #,0;-"R$" #,0;"R$" #,0
		displayFolder: 05 Estoque
		lineageTag: 76185ba2-02f4-5ac7-8966-a01108e621bc

	/// Valor em estoque de SKU × filial sem nenhuma venda nos 90 dias até o snapshot.
	measure 'Estoque Parado Valor' =
			VAR _s = [Data Último Snapshot]
			VAR _t =
			    ADDCOLUMNS (
			        SUMMARIZE (
			            CALCULATETABLE ( fEstoque, REMOVEFILTERS ( dCalendario ), fEstoque[Data] = _s ),
			            dProduto[ProdutoID],
			            dFilial[FilialID]
			        ),
			        "@q", CALCULATE ( SUM ( fEstoque[EstoqueFinal] ), REMOVEFILTERS ( dCalendario ), fEstoque[Data] = _s ),
			        "@v", CALCULATE ( SUM ( fEstoque[ValorEstoque] ), REMOVEFILTERS ( dCalendario ), fEstoque[Data] = _s ),
			        "@d", DIVIDE ( CALCULATE ( SUM ( fVendas[Quantidade] ), REMOVEFILTERS ( dCalendario ), fVendas[DataVenda] > _s - 90, fVendas[DataVenda] <= _s ), 90 )
			    )
			RETURN SUMX ( FILTER ( _t, [@q] > 0 && [@d] + 0 = 0 ), [@v] )
		formatString: "R$" #,0;-"R$" #,0;"R$" #,0
		displayFolder: 05 Estoque
		lineageTag: 3298b933-7a56-5d57-9100-63b75136ef7a

	/// Unidades de pedidos de compra abertos no snapshot com entrega prevista dentro do horizonte. Data prevista não é entrega garantida. Itera as linhas de compra do contexto, o que é mais rápido que filtros de data por SKU × filial.
	measure 'Recebimentos Previstos Qtd' =
			VAR _s = [Data Último Snapshot]
			VAR _h = [Horizonte Projeção]
			RETURN
			    CALCULATE (
			        SUMX (
			            FILTER (
			                fCompras,
			                fCompras[DataPedido] <= _s
			                    && ( ISBLANK ( fCompras[DataEntregaReal] ) || fCompras[DataEntregaReal] > _s )
			                    && fCompras[DataPrevistaEntrega] <= _s + _h
			            ),
			            fCompras[QuantidadePedida]
			        ),
			        REMOVEFILTERS ( dCalendario )
			    )
		formatString: #,0
		displayFolder: 05 Estoque
		lineageTag: 4879e097-d482-5701-b7be-a91bf6f4d76f

	/// SIMULAÇÃO. Saldo do snapshot + recebimentos previstos − venda média diária × fator do cenário × horizonte.
	measure 'Estoque Projetado Qtd' =
			VAR _q = [Estoque Qtd]
			RETURN IF ( NOT ISBLANK ( _q ), _q + [Recebimentos Previstos Qtd] - [Venda Média Diária] * [Fator Cenário] * [Horizonte Projeção] )
		formatString: #,0
		displayFolder: 05 Estoque
		lineageTag: c2ce1b26-4c49-5524-8c87-27a01a564d61

	/// SIMULAÇÃO. Dias até zerar o saldo no ritmo do cenário, sem contar recebimentos.
	measure 'Dias até Ruptura' =
			VAR _q = [Estoque Qtd]
			VAR _d = [Venda Média Diária] * [Fator Cenário]
			RETURN IF ( NOT ISBLANK ( _q ) && _d > 0, DIVIDE ( _q, _d ) )
		formatString: #,0
		displayFolder: 05 Estoque
		lineageTag: 5960617a-3d6c-5dd8-b054-21a161ca3416

	/// SIMULAÇÃO. SKU × filial cujo saldo projetado fica negativo dentro do horizonte, no cenário escolhido.
	measure 'Itens Ruptura Projetada' =
			VAR _s = [Data Último Snapshot]
			VAR _t =
			    ADDCOLUMNS (
			        SUMMARIZE (
			            CALCULATETABLE ( fEstoque, REMOVEFILTERS ( dCalendario ), fEstoque[Data] = _s ),
			            dProduto[ProdutoID],
			            dFilial[FilialID]
			        ),
			        "@q", CALCULATE ( SUM ( fEstoque[EstoqueFinal] ), REMOVEFILTERS ( dCalendario ), fEstoque[Data] = _s ),
			        "@v", CALCULATE ( SUM ( fEstoque[ValorEstoque] ), REMOVEFILTERS ( dCalendario ), fEstoque[Data] = _s ),
			        "@d", DIVIDE ( CALCULATE ( SUM ( fVendas[Quantidade] ), REMOVEFILTERS ( dCalendario ), fVendas[DataVenda] > _s - 90, fVendas[DataVenda] <= _s ), 90 )
			    )
			VAR _h = [Horizonte Projeção]
			VAR _fat = [Fator Cenário]
			RETURN
			    COUNTROWS (
			        FILTER (
			            ADDCOLUMNS ( _t, "@rec", [Recebimentos Previstos Qtd] ),
			            [@d] > 0 && [@q] + [@rec] - [@d] * _fat * _h < 0
			        )
			    ) + 0
		formatString: #,0
		displayFolder: 05 Estoque
		lineageTag: cdb33716-1e92-5c03-bdfb-1788dbcb4284

	/// ESTIMADO. Para SKU × filial com cobertura menor que o lead time padrão do fornecedor: dias descobertos × receita diária dos últimos 90 dias.
	measure 'Receita em Risco Ruptura' =
			VAR _s = [Data Último Snapshot]
			VAR _t =
			    ADDCOLUMNS (
			        SUMMARIZE (
			            CALCULATETABLE ( fEstoque, REMOVEFILTERS ( dCalendario ), fEstoque[Data] = _s ),
			            dProduto[ProdutoID],
			            dFilial[FilialID]
			        ),
			        "@q", CALCULATE ( SUM ( fEstoque[EstoqueFinal] ), REMOVEFILTERS ( dCalendario ), fEstoque[Data] = _s ),
			        "@d", DIVIDE ( CALCULATE ( SUM ( fVendas[Quantidade] ), REMOVEFILTERS ( dCalendario ), fVendas[DataVenda] > _s - 90, fVendas[DataVenda] <= _s ), 90 ),
			        "@r", DIVIDE ( CALCULATE ( SUM ( fVendas[ReceitaLiquida] ), REMOVEFILTERS ( dCalendario ), fVendas[DataVenda] > _s - 90, fVendas[DataVenda] <= _s ), 90 ),
			        "@lt", CALCULATE ( MAX ( dProduto[LeadTimePadraoDias] ) )
			    )
			RETURN
			    SUMX (
			        FILTER ( _t, [@d] > 0 && DIVIDE ( [@q], [@d] ) < [@lt] ),
			        ( [@lt] - DIVIDE ( [@q], [@d] ) ) * [@r]
			    )
		formatString: "R$" #,0;-"R$" #,0;"R$" #,0
		displayFolder: 05 Estoque
		lineageTag: 345a66b8-23b1-58eb-8140-4dbc23a2919c

	/// SKU × filial com venda recente e cobertura menor que o lead time padrão do fornecedor.
	measure 'Itens Cobertura < Lead Time' =
			VAR _s = [Data Último Snapshot]
			VAR _t =
			    ADDCOLUMNS (
			        SUMMARIZE (
			            CALCULATETABLE ( fEstoque, REMOVEFILTERS ( dCalendario ), fEstoque[Data] = _s ),
			            dProduto[ProdutoID],
			            dFilial[FilialID]
			        ),
			        "@q", CALCULATE ( SUM ( fEstoque[EstoqueFinal] ), REMOVEFILTERS ( dCalendario ), fEstoque[Data] = _s ),
			        "@v", CALCULATE ( SUM ( fEstoque[ValorEstoque] ), REMOVEFILTERS ( dCalendario ), fEstoque[Data] = _s ),
			        "@d", DIVIDE ( CALCULATE ( SUM ( fVendas[Quantidade] ), REMOVEFILTERS ( dCalendario ), fVendas[DataVenda] > _s - 90, fVendas[DataVenda] <= _s ), 90 )
			    )
			RETURN
			    COUNTROWS (
			        FILTER (
			            ADDCOLUMNS ( _t, "@lt", CALCULATE ( MAX ( dProduto[LeadTimePadraoDias] ) ) ),
			            [@d] > 0 && DIVIDE ( [@q], [@d] ) < [@lt]
			        )
			    ) + 0
		formatString: #,0
		displayFolder: 05 Estoque
		lineageTag: 6284e194-9c11-5bcc-a859-16ae1f80f2ee

	/// Classificação do saldo no snapshot: Ruptura (zero), Crítico (abaixo da segurança), Repor (até o ponto de reposição), Parado (sem venda em 90 dias), Excesso (mais de 120 dias), Saudável.
	measure 'Status Estoque' =
			VAR _q = [Estoque Qtd]
			VAR _d = [Venda Média Diária]
			VAR _cob = DIVIDE ( _q, _d )
			VAR _seg = [Estoque Segurança]
			VAR _pr = [Ponto Reposição]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _q ), BLANK (),
			        _q = 0, "Ruptura",
			        _q < _seg, "Crítico",
			        _q <= _pr, "Repor",
			        ISBLANK ( _d ) || _d = 0, "Parado",
			        _cob > [Cobertura Excesso Dias], "Excesso",
			        "Saudável"
			    )
		displayFolder: 05 Estoque
		lineageTag: 318ad46b-39db-5d44-960f-0426b640a9ad

	measure 'Status Estoque Ordem' = SWITCH ( [Status Estoque], "Ruptura", 1, "Crítico", 2, "Repor", 3, "Parado", 4, "Excesso", 5, "Saudável", 6 )
		formatString: #,0
		isHidden
		displayFolder: 05 Estoque
		lineageTag: 42ffc5c1-3c36-563e-98d8-415ac91322da

	/// 1 quando há SKU × filial em ruptura ou abaixo do estoque de segurança no snapshot. Usada como filtro do visual de itens críticos. Escrita direto sobre fEstoque para não avaliar o status completo em cada combinação.
	measure 'Estoque Linha Crítica' =
			VAR _s = [Data Último Snapshot]
			RETURN
			    IF (
			        CALCULATE (
			            COUNTROWS ( FILTER ( fEstoque, fEstoque[EstoqueFinal] = 0 || fEstoque[EstoqueFinal] < fEstoque[EstoqueSeguranca] ) ),
			            REMOVEFILTERS ( dCalendario ),
			            fEstoque[Data] = _s
			        ) > 0,
			        1
			    )
		formatString: #,0
		isHidden
		displayFolder: 05 Estoque
		lineageTag: f2ecae62-6466-5887-9aa4-4352a22987af

	/// Coeficiente de variação da quantidade mensal nos meses fechados do contexto. Meses sem venda contam como zero. Em branco com menos de 6 meses ou demanda zero.
	measure 'CV Demanda' =
			VAR _c = [Data Corte]
			VAR _mc = YEAR ( _c ) * 12 + MONTH ( _c )
			VAR _fechado = _c >= EOMONTH ( _c, 0 )
			VAR _meses = FILTER ( VALUES ( dCalendario[MesIndice] ), dCalendario[MesIndice] < _mc || ( dCalendario[MesIndice] = _mc && _fechado ) )
			VAR _t = ADDCOLUMNS ( _meses, "@q", [Quantidade] + 0 )
			VAR _n = COUNTROWS ( _t )
			VAR _media = AVERAGEX ( _t, [@q] )
			RETURN IF ( _n >= 6 && _media > 0, DIVIDE ( STDEVX.P ( _t, [@q] ), _media ) )
		formatString: 0.00
		displayFolder: 05 Estoque
		lineageTag: 3c3bb8d0-371b-5fbc-a63f-5f8c96e46d16

	/// X estável, Y variável, Z errática, pelo CV mensal. n/d quando a amostra é insuficiente.
	measure 'Classe XYZ' =
			VAR _cv = [CV Demanda]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( [Quantidade] ), BLANK (),
			        ISBLANK ( _cv ), "n/d",
			        _cv <= [XYZ Limite X], "X",
			        _cv <= [XYZ Limite Y], "Y",
			        "Z"
			    )
		displayFolder: 05 Estoque
		lineageTag: 319e886d-c727-5eb9-9812-68228eafb6aa

	/// ABC dinâmica pela receita líquida do período, sobre todo o portfólio e respeitando os filtros que não são de produto: A até 80% acumulado, B até 95%, C o restante. Só em linhas de um único SKU.
	measure 'Classe ABC' =
			VAR _r = [Receita Líquida]
			VAR _t = ADDCOLUMNS ( ALL ( dProduto[ProdutoID] ), "@r", CALCULATE ( [Receita Líquida], ALLEXCEPT ( dProduto, dProduto[ProdutoID] ) ) )
			VAR _tot = SUMX ( _t, [@r] )
			VAR _antes = SUMX ( FILTER ( _t, [@r] > _r ), [@r] )
			RETURN
			    IF (
			        HASONEVALUE ( dProduto[ProdutoID] ) && _r > 0,
			        SWITCH ( TRUE (), _antes < 0.8 * _tot, "A", _antes < 0.95 * _tot, "B", "C" )
			    )
		displayFolder: 05 Estoque
		lineageTag: 3bd90100-e3d7-5240-a18f-e47c09331bcc

	/// Valor recebido de pedidos de compra emitidos no período e entregues até o corte.
	measure 'Compras Valor Recebido' =
			VAR _c = [Data Corte]
			RETURN CALCULATE ( SUM ( fCompras[ValorCompra] ), KEEPFILTERS ( fCompras[DataEntregaReal] <= _c && NOT ISBLANK ( fCompras[DataEntregaReal] ) ) )
		formatString: "R$" #,0;-"R$" #,0;"R$" #,0
		displayFolder: 06 Supply
		lineageTag: 66f1d532-297b-5d3d-acdc-7c533c3c3c38

	/// Posição na data de corte: pedidos emitidos e ainda não entregues, a preço de compra. Ignora o filtro de período.
	measure 'Compras Pendentes Valor' =
			VAR _c = [Data Corte]
			RETURN
			    CALCULATE (
			        SUMX ( fCompras, fCompras[QuantidadePedida] * fCompras[PrecoCompraUnitario] ),
			        REMOVEFILTERS ( dCalendario ),
			        fCompras[DataPedido] <= _c,
			        ISBLANK ( fCompras[DataEntregaReal] ) || fCompras[DataEntregaReal] > _c
			    )
		formatString: "R$" #,0;-"R$" #,0;"R$" #,0
		displayFolder: 06 Supply
		lineageTag: 07e6a6dd-a811-55a2-bcf6-c79adc4938c8

	measure 'Compras Pendentes Pedidos' =
			VAR _c = [Data Corte]
			RETURN
			    CALCULATE (
			        COUNTROWS ( fCompras ),
			        REMOVEFILTERS ( dCalendario ),
			        fCompras[DataPedido] <= _c,
			        ISBLANK ( fCompras[DataEntregaReal] ) || fCompras[DataEntregaReal] > _c
			    ) + 0
		formatString: #,0
		displayFolder: 06 Supply
		lineageTag: 99fb1363-a66f-5cfa-a1e0-76d100605149

	/// Pedidos de compra emitidos no período e entregues até o corte: base elegível de OTIF.
	measure 'Compras Entregues' =
			VAR _c = [Data Corte]
			RETURN CALCULATE ( COUNTROWS ( fCompras ), KEEPFILTERS ( fCompras[DataEntregaReal] <= _c && NOT ISBLANK ( fCompras[DataEntregaReal] ) ) )
		formatString: #,0
		displayFolder: 06 Supply
		lineageTag: bedaad3e-e270-5ca2-8d9e-216df365978a

	/// Pedidos entregues sem atraso sobre pedidos entregues.
	measure 'On Time %' =
			VAR _c = [Data Corte]
			VAR _ok = CALCULATE ( COUNTROWS ( fCompras ), KEEPFILTERS ( fCompras[DataEntregaReal] <= _c && NOT ISBLANK ( fCompras[DataEntregaReal] ) ), KEEPFILTERS ( fCompras[AtrasoDias] <= 0 ) )
			RETURN DIVIDE ( _ok + 0, [Compras Entregues] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 06 Supply
		lineageTag: a8d9e5dd-ca88-50b5-97b2-6a549b8dfc9c

	/// Pedidos entregues completos sobre pedidos entregues.
	measure 'In Full %' =
			VAR _c = [Data Corte]
			VAR _ok = CALCULATE ( COUNTROWS ( fCompras ), KEEPFILTERS ( fCompras[DataEntregaReal] <= _c && NOT ISBLANK ( fCompras[DataEntregaReal] ) ), KEEPFILTERS ( fCompras[PedidoCompleto] = 1 ) )
			RETURN DIVIDE ( _ok + 0, [Compras Entregues] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 06 Supply
		lineageTag: a7b93950-5905-500a-9760-787e8c6572f8

	/// Pedidos entregues no prazo e completos sobre pedidos entregues.
	measure 'OTIF %' =
			VAR _c = [Data Corte]
			VAR _ok = CALCULATE ( COUNTROWS ( fCompras ), KEEPFILTERS ( fCompras[DataEntregaReal] <= _c && NOT ISBLANK ( fCompras[DataEntregaReal] ) ), KEEPFILTERS ( fCompras[AtrasoDias] <= 0 ), KEEPFILTERS ( fCompras[PedidoCompleto] = 1 ) )
			RETURN DIVIDE ( _ok + 0, [Compras Entregues] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 06 Supply
		lineageTag: ccd88b06-38ad-5bbe-972f-38f9c7d64f2c

	measure 'OTIF % LY' =
			VAR _c = [Data Corte]
			RETURN
			    CALCULATE (
			        [OTIF %],
			        SAMEPERIODLASTYEAR ( FILTER ( VALUES ( dCalendario[Data] ), dCalendario[Data] <= _c ) )
			    )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 06 Supply
		lineageTag: baa95914-4b5a-55ec-a7ff-e93be070c9c2

	/// Média de dias entre pedido e entrega real.
	measure 'Lead Time Real' =
			VAR _c = [Data Corte]
			RETURN CALCULATE ( AVERAGE ( fCompras[LeadTimeRealDias] ), KEEPFILTERS ( fCompras[DataEntregaReal] <= _c && NOT ISBLANK ( fCompras[DataEntregaReal] ) ) )
		formatString: #,0.0
		displayFolder: 06 Supply
		lineageTag: f52de776-bb62-5046-a5c3-58c2469710f7

	measure 'Lead Time Real LY' =
			VAR _c = [Data Corte]
			RETURN
			    CALCULATE (
			        [Lead Time Real],
			        SAMEPERIODLASTYEAR ( FILTER ( VALUES ( dCalendario[Data] ), dCalendario[Data] <= _c ) )
			    )
		formatString: #,0.0
		displayFolder: 06 Supply
		lineageTag: 9d49c813-592c-5eb4-8ea4-1726a684b239

	/// Média de dias de atraso contra a data prevista, incluindo entregas sem atraso.
	measure 'Atraso Médio' =
			VAR _c = [Data Corte]
			RETURN CALCULATE ( AVERAGE ( fCompras[AtrasoDias] ), KEEPFILTERS ( fCompras[DataEntregaReal] <= _c && NOT ISBLANK ( fCompras[DataEntregaReal] ) ) )
		formatString: #,0.0
		displayFolder: 06 Supply
		lineageTag: c2cacee6-644d-5c8d-ba98-ec5be99a9982

	measure 'Atraso Médio LY' =
			VAR _c = [Data Corte]
			RETURN
			    CALCULATE (
			        [Atraso Médio],
			        SAMEPERIODLASTYEAR ( FILTER ( VALUES ( dCalendario[Data] ), dCalendario[Data] <= _c ) )
			    )
		formatString: #,0.0
		displayFolder: 06 Supply
		lineageTag: 5b049bb1-516c-512f-bbd0-348de34afd17

	measure 'Lead Time Padrão' = AVERAGE ( dFornecedor[LeadTimePadraoDias] )
		formatString: #,0.0
		displayFolder: 06 Supply
		lineageTag: 663c39d2-0204-5b07-91f0-ecbf524e9d26

	/// Score cadastral de qualidade (0–100).
	measure 'Score Qualidade' = AVERAGE ( dFornecedor[ScoreQualidade] )
		formatString: 0
		displayFolder: 06 Supply
		lineageTag: cf8d778e-aa76-53d4-817d-a2526ce34e14

	/// Score cadastral de preço (0–100). Cada SKU tem um único fornecedor na base, então não há preço relativo comparável.
	measure 'Score Preço' = AVERAGE ( dFornecedor[ScorePreco] )
		formatString: 0
		displayFolder: 06 Supply
		lineageTag: c58ea3e6-231a-5346-81be-7abbbafecec6

	/// Lead time real normalizado entre todos os fornecedores com entrega no período: 100 para o menor, 0 para o maior.
	measure 'Score Lead Time' =
			VAR _lt = [Lead Time Real]
			VAR _t = FILTER ( ADDCOLUMNS ( ALL ( dFornecedor[FornecedorID] ), "@lt", CALCULATE ( [Lead Time Real], ALLEXCEPT ( dFornecedor, dFornecedor[FornecedorID] ) ) ), NOT ISBLANK ( [@lt] ) )
			VAR _min = MINX ( _t, [@lt] )
			VAR _max = MAXX ( _t, [@lt] )
			RETURN IF ( NOT ISBLANK ( _lt ), IF ( _max = _min, 100, 100 * DIVIDE ( _max - _lt, _max - _min ) ) )
		formatString: 0
		displayFolder: 06 Supply
		lineageTag: c8d5ae54-d0cb-58b8-99dd-3d82cf0c7e7e

	/// 0,40 × OTIF + 0,25 × score de preço + 0,20 × score de qualidade + 0,15 × score de lead time, todos em escala 0–100.
	measure 'Supplier Score' =
			VAR _otif = [OTIF %] * 100
			RETURN
			    IF (
			        NOT ISBLANK ( [Compras Entregues] ),
			        0.40 * _otif + 0.25 * [Score Preço] + 0.20 * [Score Qualidade] + 0.15 * [Score Lead Time]
			    )
		formatString: 0.0
		displayFolder: 06 Supply
		lineageTag: 5c3ae4f1-81b4-5c0c-a049-bf7a8c357654

	/// Valor dos títulos emitidos no período até o corte. No conjunto completo é igual à receita líquida.
	measure 'Títulos Emitidos' =
			VAR _c = [Data Corte]
			RETURN CALCULATE ( SUM ( fFinanceiro[ValorTitulo] ), KEEPFILTERS ( fFinanceiro[DataEmissao] <= _c ) )
		formatString: "R$" #,0;-"R$" #,0;"R$" #,0
		displayFolder: 07 Financeiro
		lineageTag: 01f84819-7532-5afe-a3cd-ab5a65cbeb99

	/// Posição na data de corte: títulos emitidos e pagos depois do corte entram pelo valor integral; títulos sem pagamento entram pelo saldo. Ignora o filtro de período.
	measure 'Saldo em Aberto' =
			VAR _c = [Data Corte]
			RETURN
			    CALCULATE ( SUM ( fFinanceiro[ValorTitulo] ), REMOVEFILTERS ( dCalendario ), fFinanceiro[DataEmissao] <= _c, fFinanceiro[DataPagamento] > _c )
			        + CALCULATE ( SUM ( fFinanceiro[SaldoAberto] ), REMOVEFILTERS ( dCalendario ), fFinanceiro[DataEmissao] <= _c, ISBLANK ( fFinanceiro[DataPagamento] ) )
		formatString: "R$" #,0;-"R$" #,0;"R$" #,0
		displayFolder: 07 Financeiro
		lineageTag: d62fd01c-7ab9-59fe-a569-c4b846954d3d

	/// Saldo em aberto com vencimento anterior à data de corte.
	measure Vencido =
			VAR _c = [Data Corte]
			RETURN
			    CALCULATE ( SUM ( fFinanceiro[ValorTitulo] ), REMOVEFILTERS ( dCalendario ), fFinanceiro[DataEmissao] <= _c, fFinanceiro[DataPagamento] > _c, fFinanceiro[DataVencimento] < _c )
			        + CALCULATE ( SUM ( fFinanceiro[SaldoAberto] ), REMOVEFILTERS ( dCalendario ), fFinanceiro[DataEmissao] <= _c, ISBLANK ( fFinanceiro[DataPagamento] ), fFinanceiro[DataVencimento] < _c )
		formatString: "R$" #,0;-"R$" #,0;"R$" #,0
		displayFolder: 07 Financeiro
		lineageTag: 7d3a6497-cd32-51d4-8c11-29b158253637

	/// Vencido sobre o saldo em aberto na data de corte.
	measure 'Vencido %' = DIVIDE ( [Vencido], [Saldo em Aberto] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 07 Financeiro
		lineageTag: ae4969af-589d-5afd-88f8-e00df6e915be

	measure 'Vencido > 90 dias' =
			VAR _c = [Data Corte]
			RETURN
			    CALCULATE ( SUM ( fFinanceiro[ValorTitulo] ), REMOVEFILTERS ( dCalendario ), fFinanceiro[DataEmissao] <= _c, fFinanceiro[DataPagamento] > _c, fFinanceiro[DataVencimento] < _c - 90 )
			        + CALCULATE ( SUM ( fFinanceiro[SaldoAberto] ), REMOVEFILTERS ( dCalendario ), fFinanceiro[DataEmissao] <= _c, ISBLANK ( fFinanceiro[DataPagamento] ), fFinanceiro[DataVencimento] < _c - 90 )
		formatString: "R$" #,0;-"R$" #,0;"R$" #,0
		displayFolder: 07 Financeiro
		lineageTag: 01b05f85-8b59-59a9-96ed-784827f34ec2

	/// Saldo em aberto na data de corte ÷ receita líquida diária dos últimos 90 dias.
	measure DSO =
			VAR _c = [Data Corte]
			VAR _rec = CALCULATE ( SUM ( fVendas[ReceitaLiquida] ), REMOVEFILTERS ( dCalendario ), fVendas[DataVenda] > _c - 90, fVendas[DataVenda] <= _c )
			RETURN DIVIDE ( [Saldo em Aberto], DIVIDE ( _rec, 90 ) )
		formatString: #,0
		displayFolder: 07 Financeiro
		lineageTag: 08c84412-991e-559f-a69c-7d39f9d6c41c

	/// Efeito preço: (preço atual − preço LY) × quantidade atual, nos SKUs vendidos nos dois períodos.
	measure 'PVM Preço' =
			VAR _t =
			    ADDCOLUMNS (
			        VALUES ( dProduto[ProdutoID] ),
			        "@r1", [Receita Líquida],
			        "@q1", [Quantidade],
			        "@r0", [Receita Líquida LY],
			        "@q0", [Quantidade LY]
			    )
			VAR _comp = FILTER ( _t, [@q1] > 0 && [@q0] > 0 )
			VAR _Q1 = SUMX ( _comp, [@q1] )
			VAR _Q0 = SUMX ( _comp, [@q0] )
			VAR _R0 = SUMX ( _comp, [@r0] )
			VAR _preco = SUMX ( _comp, ( DIVIDE ( [@r1], [@q1] ) - DIVIDE ( [@r0], [@q0] ) ) * [@q1] )
			VAR _volume = ( _Q1 - _Q0 ) * DIVIDE ( _R0, _Q0 )
			VAR _mix = SUMX ( _comp, ( [@q1] - [@q0] ) * DIVIDE ( [@r0], [@q0] ) ) - _volume
			VAR _novos = SUMX ( FILTER ( _t, [@q1] > 0 && [@q0] + 0 = 0 ), [@r1] )
			VAR _desc = - SUMX ( FILTER ( _t, [@q0] > 0 && [@q1] + 0 = 0 ), [@r0] )
			VAR _temLY = NOT ISBLANK ( [Receita Líquida LY] )
			RETURN IF ( _temLY, _preco )
		formatString: "R$" #,0;-"R$" #,0;"R$" #,0
		displayFolder: 08 PVM
		lineageTag: 6a0bb730-1ce6-52b1-ac69-3c140c9f0a42

	/// Efeito volume: variação da quantidade total dos SKUs comparáveis × preço médio LY do conjunto.
	measure 'PVM Volume' =
			VAR _t =
			    ADDCOLUMNS (
			        VALUES ( dProduto[ProdutoID] ),
			        "@r1", [Receita Líquida],
			        "@q1", [Quantidade],
			        "@r0", [Receita Líquida LY],
			        "@q0", [Quantidade LY]
			    )
			VAR _comp = FILTER ( _t, [@q1] > 0 && [@q0] > 0 )
			VAR _Q1 = SUMX ( _comp, [@q1] )
			VAR _Q0 = SUMX ( _comp, [@q0] )
			VAR _R0 = SUMX ( _comp, [@r0] )
			VAR _preco = SUMX ( _comp, ( DIVIDE ( [@r1], [@q1] ) - DIVIDE ( [@r0], [@q0] ) ) * [@q1] )
			VAR _volume = ( _Q1 - _Q0 ) * DIVIDE ( _R0, _Q0 )
			VAR _mix = SUMX ( _comp, ( [@q1] - [@q0] ) * DIVIDE ( [@r0], [@q0] ) ) - _volume
			VAR _novos = SUMX ( FILTER ( _t, [@q1] > 0 && [@q0] + 0 = 0 ), [@r1] )
			VAR _desc = - SUMX ( FILTER ( _t, [@q0] > 0 && [@q1] + 0 = 0 ), [@r0] )
			VAR _temLY = NOT ISBLANK ( [Receita Líquida LY] )
			RETURN IF ( _temLY, _volume )
		formatString: "R$" #,0;-"R$" #,0;"R$" #,0
		displayFolder: 08 PVM
		lineageTag: e7af8b6d-da76-5a86-9a42-29d32a51607a

	/// Efeito mix: variação de quantidade por SKU a preço LY, menos o efeito volume.
	measure 'PVM Mix' =
			VAR _t =
			    ADDCOLUMNS (
			        VALUES ( dProduto[ProdutoID] ),
			        "@r1", [Receita Líquida],
			        "@q1", [Quantidade],
			        "@r0", [Receita Líquida LY],
			        "@q0", [Quantidade LY]
			    )
			VAR _comp = FILTER ( _t, [@q1] > 0 && [@q0] > 0 )
			VAR _Q1 = SUMX ( _comp, [@q1] )
			VAR _Q0 = SUMX ( _comp, [@q0] )
			VAR _R0 = SUMX ( _comp, [@r0] )
			VAR _preco = SUMX ( _comp, ( DIVIDE ( [@r1], [@q1] ) - DIVIDE ( [@r0], [@q0] ) ) * [@q1] )
			VAR _volume = ( _Q1 - _Q0 ) * DIVIDE ( _R0, _Q0 )
			VAR _mix = SUMX ( _comp, ( [@q1] - [@q0] ) * DIVIDE ( [@r0], [@q0] ) ) - _volume
			VAR _novos = SUMX ( FILTER ( _t, [@q1] > 0 && [@q0] + 0 = 0 ), [@r1] )
			VAR _desc = - SUMX ( FILTER ( _t, [@q0] > 0 && [@q1] + 0 = 0 ), [@r0] )
			VAR _temLY = NOT ISBLANK ( [Receita Líquida LY] )
			RETURN IF ( _temLY, _mix )
		formatString: "R$" #,0;-"R$" #,0;"R$" #,0
		displayFolder: 08 PVM
		lineageTag: 49a96385-f59a-5cf5-bb4b-63975e831e61

	/// Receita atual de SKUs sem venda no intervalo LY.
	measure 'PVM Novos' =
			VAR _t =
			    ADDCOLUMNS (
			        VALUES ( dProduto[ProdutoID] ),
			        "@r1", [Receita Líquida],
			        "@q1", [Quantidade],
			        "@r0", [Receita Líquida LY],
			        "@q0", [Quantidade LY]
			    )
			VAR _comp = FILTER ( _t, [@q1] > 0 && [@q0] > 0 )
			VAR _Q1 = SUMX ( _comp, [@q1] )
			VAR _Q0 = SUMX ( _comp, [@q0] )
			VAR _R0 = SUMX ( _comp, [@r0] )
			VAR _preco = SUMX ( _comp, ( DIVIDE ( [@r1], [@q1] ) - DIVIDE ( [@r0], [@q0] ) ) * [@q1] )
			VAR _volume = ( _Q1 - _Q0 ) * DIVIDE ( _R0, _Q0 )
			VAR _mix = SUMX ( _comp, ( [@q1] - [@q0] ) * DIVIDE ( [@r0], [@q0] ) ) - _volume
			VAR _novos = SUMX ( FILTER ( _t, [@q1] > 0 && [@q0] + 0 = 0 ), [@r1] )
			VAR _desc = - SUMX ( FILTER ( _t, [@q0] > 0 && [@q1] + 0 = 0 ), [@r0] )
			VAR _temLY = NOT ISBLANK ( [Receita Líquida LY] )
			RETURN IF ( _temLY, _novos )
		formatString: "R$" #,0;-"R$" #,0;"R$" #,0
		displayFolder: 08 PVM
		lineageTag: c02aa7b7-23fe-5d19-956d-c1e6ad6dc7d5

	/// Receita LY (negativa) de SKUs sem venda no período atual.
	measure 'PVM Descontinuados' =
			VAR _t =
			    ADDCOLUMNS (
			        VALUES ( dProduto[ProdutoID] ),
			        "@r1", [Receita Líquida],
			        "@q1", [Quantidade],
			        "@r0", [Receita Líquida LY],
			        "@q0", [Quantidade LY]
			    )
			VAR _comp = FILTER ( _t, [@q1] > 0 && [@q0] > 0 )
			VAR _Q1 = SUMX ( _comp, [@q1] )
			VAR _Q0 = SUMX ( _comp, [@q0] )
			VAR _R0 = SUMX ( _comp, [@r0] )
			VAR _preco = SUMX ( _comp, ( DIVIDE ( [@r1], [@q1] ) - DIVIDE ( [@r0], [@q0] ) ) * [@q1] )
			VAR _volume = ( _Q1 - _Q0 ) * DIVIDE ( _R0, _Q0 )
			VAR _mix = SUMX ( _comp, ( [@q1] - [@q0] ) * DIVIDE ( [@r0], [@q0] ) ) - _volume
			VAR _novos = SUMX ( FILTER ( _t, [@q1] > 0 && [@q0] + 0 = 0 ), [@r1] )
			VAR _desc = - SUMX ( FILTER ( _t, [@q0] > 0 && [@q1] + 0 = 0 ), [@r0] )
			VAR _temLY = NOT ISBLANK ( [Receita Líquida LY] )
			RETURN IF ( _temLY, _desc )
		formatString: "R$" #,0;-"R$" #,0;"R$" #,0
		displayFolder: 08 PVM
		lineageTag: fc47d126-3103-5c4f-9d21-18fb740cb2e9

	/// Soma dos efeitos. Deve ser igual a Receita Líquida − Receita Líquida LY.
	measure 'PVM Total' = [PVM Preço] + [PVM Volume] + [PVM Mix] + [PVM Novos] + [PVM Descontinuados]
		formatString: "R$" #,0;-"R$" #,0;"R$" #,0
		displayFolder: 08 PVM
		lineageTag: 8d56dfb9-232a-5948-90bb-4d54c7c94f9c

	/// Teste de reconciliação do PVM. Deve ser zero.
	measure 'PVM Diferença de Controle' = IF ( NOT ISBLANK ( [Receita Líquida LY] ), [PVM Total] - ( [Receita Líquida] - [Receita Líquida LY] ) )
		formatString: "R$" #,0.00;-"R$" #,0.00;"R$" #,0.00
		displayFolder: 08 PVM
		lineageTag: 491c9531-e26e-55c1-9f6a-1db8989c6550

	/// Folha de estilo comum dos componentes HTML/SVG. Sem scripts nem recursos externos.
