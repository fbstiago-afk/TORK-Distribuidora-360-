 1e3, "R$ " & FORMAT ( ABS ( _v ) / 1e3, "#,0", "pt-BR" ) & " mil", "R$ " & FORMAT ( ABS ( _v ), "#,0", "pt-BR" ) ) ) & "</text>" & "<text x='249.0' y='221' text-anchor='middle' font-size='10' font-weight='700' fill='#16212E'>Volume</text>" & "<text x='249.0' y='234' text-anchor='middle' font-size='9.5' font-weight='500' fill='#6C737D'>" & IF ( ISBLANK ( DIVIDE ( _v, _l0 ) ), "–", FORMAT ( DIVIDE ( _v, _l0 ), "0.0%", "pt-BR" ) ) & "</text>" & "<rect x='323.0' y='" & FORMAT ( ( 206 - ( ( MAX ( _l2, _l3 ) ) - _lo ) * _sc ), "0.0", "en-US" ) & "' width='54' height='" & FORMAT ( MAX ( 1.5, ( 206 - ( ( MIN ( _l2, _l3 ) ) - _lo ) * _sc ) - ( 206 - ( ( MAX ( _l2, _l3 ) ) - _lo ) * _sc ) ), "0.0", "en-US" ) & "' rx='3' fill='" & IF ( _m >= 0, "#14804A", "#E31E24" ) & "'/>" & "<line x1='377.0' x2='424.0' y1='" & FORMAT ( ( 206 - ( ( _l3 ) - _lo ) * _sc ), "0.0", "en-US" ) & "' y2='" & FORMAT ( ( 206 - ( ( _l3 ) - _lo ) * _sc ), "0.0", "en-US" ) & "' stroke='#9AA3AE' stroke-width='1' stroke-dasharray='3 2'/>" & "<text x='350.0' y='" & FORMAT ( ( 206 - ( ( MAX ( _l2, _l3 ) ) - _lo ) * _sc ) - 6, "0.0", "en-US" ) & "' text-anchor='middle' font-size='11' font-weight='700' fill='#0B1F33'>" & IF ( ISBLANK ( _m ), "–", IF ( _m >= 0, "+", "−" ) & SWITCH ( TRUE (), ISBLANK ( ABS ( _m ) ), "–", ABS ( ABS ( _m ) ) >= 1e9, "R$ " & FORMAT ( ABS ( _m ) / 1e9, "#,0.00", "pt-BR" ) & " bi", ABS ( ABS ( _m ) ) >= 1e6, "R$ " & FORMAT ( ABS ( _m ) / 1e6, "#,0.0", "pt-BR" ) & " mi", ABS ( ABS ( _m ) ) >= 1e3, "R$ " & FORMAT ( ABS ( _m ) / 1e3, "#,0", "pt-BR" ) & " mil", "R$ " & FORMAT ( ABS ( _m ), "#,0", "pt-BR" ) ) ) & "</text>" & "<text x='350.0' y='221' text-anchor='middle' font-size='10' font-weight='700' fill='#16212E'>Mix</text>" & "<text x='350.0' y='234' text-anchor='middle' font-size='9.5' font-weight='500' fill='#6C737D'>" & IF ( ISBLANK ( DIVIDE ( _m, _l0 ) ), "–", FORMAT ( DIVIDE ( _m, _l0 ), "0.0%", "pt-BR" ) ) & "</text>" & "<rect x='424.0' y='" & FORMAT ( ( 206 - ( ( MAX ( _l3, _