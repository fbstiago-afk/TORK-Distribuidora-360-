	/// Pareto do valor em excesso (acima de 120 dias de cobertura) por categoria: 10 maiores + Outros, com percentual acumulado. A soma das barras é igual ao excesso total do contexto.
	measure 'HTML | Pareto Excesso' =
			VAR _s = [Data Último Snapshot]
			VAR _lim = [Cobertura Excesso Dias]
			VAR _t =
			    ADDCOLUMNS (
			        SUMMARIZE ( CALCULATETABLE ( fEstoque, REMOVEFILTERS ( dCalendario ), fEstoque[Data] = _s ), dProduto[Categoria], dProduto[ProdutoID], dFilial[FilialID] ),
			        "@q", CALCULATE ( SUM ( fEstoque[EstoqueFinal] ), REMOVEFILTERS ( dCalendario ), fEstoque[Data] = _s ),
			        "@v", CALCULATE ( SUM ( fEstoque[ValorEstoque] ), REMOVEFILTERS ( dCalendario ), fEstoque[Data] = _s ),
			        "@d", DIVIDE ( CALCULATE ( SUM ( fVendas[Quantidade] ), REMOVEFILTERS ( dCalendario ), fVendas[DataVenda] > _s - 90, fVendas[DataVenda] <= _s ), 90 )
			    )
			VAR _t2 = ADDCOLUMNS ( _t, "@x", VAR _exc = [@q] - [@d] * _lim RETURN IF ( [@q] > 0 && _exc > 0, DIVIDE ( _exc, [@q] ) * [@v], 0 ) )
			VAR _cat = FILTER ( GROUPBY ( _t2, dProduto[Categoria], "@e", SUMX ( CURRENTGROUP (), [@x] ) ), [@e] > 0 )
			VAR _tot = SUMX ( _cat, [@e] )
			VAR _top = TOPN ( 10, _cat, [@e], DESC, dProduto[Categoria], ASC )
			VAR _topK =
			    ADDCOLUMNS (
			        _top,
			        "@k", VAR _e = [@e] VAR _id = dProduto[Categoria] RETURN COUNTROWS ( FILTER ( _top, [@e] > _e || ( [@e] = _e && dProduto[Categoria] < _id ) ) ) + 1,
			        "@lb", SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( dProduto[Categoria], "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" )
			    )
			VAR _sumTop = SUMX ( _top, [@e] )
			VAR _b0 = FILTER ( UNION ( SELECTCOLUMNS ( _topK, "@k", [@k], "@e", [@e], "@lb", [@lb] ), ROW ( "@k", 11, "@e", _tot - _sumTop, "@lb", "Outros" ) ), [@e] > 0.5 )
			VAR _bars = ADDCOLUMNS ( _b0, "@cum", VAR _k = [@k] RETURN DIVIDE ( SUMX ( FILTER ( _b0, [@k] <= _k ), [@e] ), _tot ) )
			VAR _maxE = MAXX ( _bars, [@e] )
			VAR _step = DIVIDE ( 492, COUNTROWS ( _bars ) )
			RETURN
			    IF ( _tot > 0, [HTML | CSS] & "<div class='tk'>" & "<svg class='tk-sv' viewBox='0 0 520 262' preserveAspectRatio='xMidYMid meet' font-family='Montserrat,Segoe UI,Arial'><line x1='10' y1='200' x2='510' y2='200' stroke='#C5CBD3'/>" & CONCATENATEX ( _bars,
			        VAR _x = 14 + ( [@k] - 1 ) * _step + _step * 0.15
			        VAR _h = DIVIDE ( [@e], _maxE ) * 150
			        RETURN "<rect x='" & FORMAT ( _x, "0.0", "en-US" ) & "' y='" & FORMAT ( 200 - _h, "0.0", "en-US" ) & "' width='" & FORMAT ( _step * 0.7, "0.0", "en-US" ) & "' height='" & FORMAT ( MAX ( 1, _h ), "0.0", "en-US" ) & "' rx='3' fill='" & IF ( [@lb] = "Outros", "#9AA3AE", "#0B1F33" ) & "'/>"
			            & "<text x='" & FORMAT ( _x + _step * 0.35, "0.0", "en-US" ) & "' y='" & FORMAT ( 200 - _h - 5, "0.0", "en-US" ) & "' text-anchor='middle' font-size='10' font-weight='700' fill='#0B1F33'>" & FORMAT ( [@e] / 1e6, "#,0.0", "pt-BR" ) & "</text>"
			            & "<text x='" & FORMAT ( _x + _step * 0.35, "0.0", "en-US" ) & "' y='214' text-anchor='middle' font-size='9.5' font-weight='600' fill='#16212E'>" & [@lb] & "</text>",
			        "", [@k], ASC ) & "<polyline fill='none' stroke='#E31E24' stroke-width='2' points='" & CONCATENATEX ( _bars, FORMAT ( 14 + ( [@k] - 0.5 ) * _step, "0.0", "en-US" ) & "," & FORMAT ( 200 - [@cum] * 150, "0.0", "en-US" ), " ", [@k], ASC ) & "'/>" & CONCATENATEX ( _bars, "<circle cx='" & FORMAT ( 14 + ( [@k] - 0.5 ) * _step, "0.0", "en-US" ) & "' cy='" & FORMAT ( 200 - [@cum] * 150, "0.0", "en-US" ) & "' r='3' fill='#E31E24'/><text x='" & FORMAT ( 14 + ( [@k] - 0.5 ) * _step, "0.0", "en-US" ) & "' y='" & FORMAT ( 200 - [@cum] * 150 - 7, "0.0", "en-US" ) & "' text-anchor='middle' font-size='9' font-weight='700' fill='#C8161C'>" & FORMAT ( [@cum], "0%", "pt-BR" ) & "</text>", "", [@k], ASC ) & "<text x='510' y='14' text-anchor='end' font-size='9.5' fill='#6C737D'>" & "Barras em R$ milhões · linha: % acumulado · maior categoria = " & FORMAT ( DIVIDE ( _maxE, _tot ), "0%", "pt-BR" ) & " do excesso" & "</text>" & "<text x='260' y='238' text-anchor='middle' font-size='9.5' fill='#6C737D'>" & "Excesso total de " & SWITCH ( TRUE (), ISBLANK ( _tot ), "–", ABS ( _tot ) >= 1e9, "R$ " & FORMAT ( _tot / 1e9, "#,0.00", "pt-BR" ) & " bi", ABS ( _tot ) >= 1e6, "R$ " & FORMAT ( _tot / 1e6, "#,0.0", "pt-BR" ) & " mi", ABS ( _tot ) >= 1e3, "R$ " & FORMAT ( _tot / 1e3, "#,0", "pt-BR" ) & " mil", "R$ " & FORMAT ( _tot, "#,0", "pt-BR" ) ) & " acima de " & _lim & " dias de cobertura · snapshot de " & FORMAT ( _s, "dd/MM/yyyy" ) & "</text></svg>" & "</div>",
			        [HTML | CSS] & "<div class='tk' style='display:flex;align-items:center;justify-content:center;color:#6C737D;font-size:12px'>Sem excesso de estoque no contexto selecionado</div>" )
		displayFolder: 10 Apresentação
		lineageTag: 0f4a1b82-0cec-5b5b-9b5c-59dcead96eb4

	/// Tooltip de cliente: receita, margem, share estimado, frequência, mix, recência e tendência mensal.
	measure 'HTML | Tooltip Cliente' = [HTML | CSS] & "<div class='tk tk-tt'><div class='tk-tn'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SELECTEDVALUE ( dCliente[NomeFantasia], "Vários clientes" ), "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ) & "</div><div class='tk-ts'>" & SELECTEDVALUE ( dCliente[SegmentoRFV], "Segmentos diversos" ) & " · " & SELECTEDVALUE ( dCliente[TipoCliente], "tipos diversos" ) & " · " & SELECTEDVALUE ( dCliente[Cidade], "várias cidades" ) & "</div><div class='tk-tg'>" & "<div><span>Receita</span><b>" & SWITCH ( TRUE (), ISBLANK ( [Receita Líquida] ), "–", ABS ( [Receita Líquida] ) >= 1e9, "R$ " & FORMAT ( [Receita Líquida] / 1e9, "#,0.00", "pt-BR" ) & " bi", ABS ( [Receita Líquida] ) >= 1e6, "R$ " & FORMAT ( [Receita Líquida] / 1e6, "#,0.0", "pt-BR" ) & " mi", ABS ( [Receita Líquida] ) >= 1e3, "R$ " & FORMAT ( [Receita Líquida] / 1e3, "#,0", "pt-BR" ) & " mil", "R$ " & FORMAT ( [Receita Líquida], "#,0", "pt-BR" ) ) & "</b></div>" & "<div><span>MC %</span><b>" & IF ( ISBLANK ( [MC %] ), "–", FORMAT ( [MC %], "0.0%", "pt-BR" ) ) & "</b></div>" & "<div><span>Share est.</span><b>" & IF ( ISBLANK ( [Share Estimado %] ), "–", FORMAT ( [Share Estimado %], "0%", "pt-BR" ) ) & "</b></div>" & "<div><span>Frequência/mês</span><b>" & IF ( ISBLANK ( [Frequência Mensal] ), "–", FORMAT ( [Frequência Mensal], "0.0", "pt-BR" ) ) & "</b></div>" & "<div><span>Mix de SKUs</span><b>" & IF ( ISBLANK ( [Mix Médio SKUs] ), "–", FORMAT ( [Mix Médio SKUs], "0", "pt-BR" ) ) & "</b></div>" & "<div><span>Recência</span><b>" & IF ( ISBLANK ( [Recência Dias] ), "–", [Recência Dias] & " d" ) & "</b></div>" & "</div>" & SUBSTITUTE ( SUBSTITUTE ( [SVG | Spark Receita], "tk-sp", "tk-tp" ), "#0B1F33", "#FFFFFF" ) & "<div class='tk-tf'>" & "Receita mensal · gap estimado de " & SWITCH ( TRUE (), ISBLANK ( [Gap Potencial Estimado] ), "–", ABS ( [Gap Potencial Estimado] ) >= 1e9, "R$ " & FORMAT ( [Gap Potencial Estimado] / 1e9, "#,0.00", "pt-BR" ) & " bi", ABS ( [Gap Potencial Estimado] ) >= 1e6, "R$ " & FORMAT ( [Gap Potencial Estimado] / 1e6, "#,0.0", "pt-BR" ) & " mi", ABS ( [Gap Potencial Estimado] ) >= 1e3, "R$ " & FORMAT ( [Gap Potencial Estimado] / 1e3, "#,0", "pt-BR" ) & " mil", "R$ " & FORMAT ( [Gap Potencial Estimado], "#,0", "pt-BR" ) ) & " ao mês" & "</div></div>"
		displayFolder: 10 Apresentação
		lineageTag: 71ffe3d4-5813-560e-b9c0-3c11e120a076

	/// Tooltip de produto: saldo, cobertura, status, venda média diária, lead time, margem e demanda mensal.
	measure 'HTML | Tooltip Produto' = [HTML | CSS] & "<div class='tk tk-tt'><div class='tk-tn'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SELECTEDVALUE ( dProduto[Produto], "Vários produtos" ), "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ) & "</div><div class='tk-ts'>" & SELECTEDVALUE ( dProduto[SKU], "SKUs diversos" ) & " · " & SELECTEDVALUE ( dProduto[Categoria], "categorias diversas" ) & " · ABC " & COALESCE ( [Classe ABC], "–" ) & " / XYZ " & COALESCE ( [Classe XYZ], "–" ) & "</div><div class='tk-tg'>" & "<div><span>Saldo</span><b>" & IF ( ISBLANK ( [Estoque Qtd] ), "–", FORMAT ( [Estoque Qtd], "#,0", "pt-BR" ) ) & "</b></div>" & "<div><span>Cobertura</span><b>" & IF ( ISBLANK ( [Cobertura Dias] ), "–", FORMAT ( [Cobertura Dias], "#,0", "pt-BR" ) & " d" ) & "</b></div>" & "<div><span>Status</span><b>" & COALESCE ( [Status Estoque], "–" ) & "</b></div>" & "<div><span>Venda/dia</span><b>" & IF ( ISBLANK ( [Venda Média Diária] ), "–", FORMAT ( [Venda Média Diária], "0.0", "pt-BR" ) ) & "</b></div>" & "<div><span>Lead time</span><b>" & IF ( HASONEVALUE ( dProduto[ProdutoID] ), MAX ( dProduto[LeadTimePadraoDias] ) & " d", "–" ) & "</b></div>" & "<div><span>MC %</span><b>" & IF ( ISBLANK ( [MC %] ), "–", FORMAT ( [MC %], "0.0%", "pt-BR" ) ) & "</b></div>" & "</div>" & SUBSTITUTE ( SUBSTITUTE ( [SVG | Spark Quantidade], "tk-sp", "tk-tp" ), "#0B1F33", "#FFFFFF" ) & "<div class='tk-tf'>" & "Unidades vendidas por mês · snapshot de " & FORMAT ( [Data Último Snapshot], "dd/MM/yyyy" ) & "</div></div>"
		displayFolder: 10 Apresentação
		lineageTag: 75d17714-b17f-510a-920d-eaa4267df9ee

	/// Tooltip de fornecedor: OTIF, pontualidade, completude, lead time, atraso e score.
	measure 'HTML | Tooltip Fornecedor' = [HTML | CSS] & "<div class='tk tk-tt'><div class='tk-tn'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SELECTEDVALUE ( dFornecedor[Fornecedor], "Vários fornecedores" ), "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ) & "</div><div class='tk-ts'>" & SELECTEDVALUE ( dFornecedor[CategoriaPrincipal], "categorias diversas" ) & " · " & SELECTEDVALUE ( dFornecedor[UF], "várias UFs" ) & " · score " & FORMAT ( [Supplier Score], "0", "pt-BR" ) & "</div><div class='tk-tg'>" & "<div><span>OTIF</span><b>" & IF ( ISBLANK ( [OTIF %] ), "–", FORMAT ( [OTIF %], "0%", "pt-BR" ) ) & "</b></div>" & "<div><span>No prazo</span><b>" & IF ( ISBLANK ( [On Time %] ), "–", FORMAT ( [On Time %], "0%", "pt-BR" ) ) & "</b></div>" & "<div><span>Completo</span><b>" & IF ( ISBLANK ( [In Full %] ), "–", FORMAT ( [In Full %], "0%", "pt-BR" ) ) & "</b></div>" & "<div><span>Lead time</span><b>" & FORMAT ( [Lead Time Real], "0.0", "pt-BR" ) & " d" & "</b></div>" & "<div><span>Atraso médio</span><b>" & FORMAT ( [Atraso Médio], "0.0", "pt-BR" ) & " d" & "</b></div>" & "<div><span>Entregas</span><b>" & IF ( ISBLANK ( [Compras Entregues] ), "–", FORMAT ( [Compras Entregues], "#,0", "pt-BR" ) ) & "</b></div>" & "</div>" & SUBSTITUTE ( SUBSTITUTE ( [SVG | Spark OTIF], "tk-sp", "tk-tp" ), "#0B1F33", "#FFFFFF" ) & "<div class='tk-tf'>" & "OTIF mensal · score = 40% OTIF + 25% preço + 20% qualidade + 15% lead time" & "</div></div>"
		displayFolder: 10 Apresentação
		lineageTag: d8046aed-6a81-50ab-bbb2-7875d7cb22ed

	/// Tooltip do ranking: vendedor, filial, categoria, canal ou segmento, com receita, meta (quando aplicável), variação anual, margem, clientes e ticket.
	measure 'HTML | Tooltip Vendedor' = [HTML | CSS] & "<div class='tk tk-tt'><div class='tk-tn'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( COALESCE ( SELECTEDVALUE ( dVendedor[Vendedor] ), SELECTEDVALUE ( dProduto[Categoria] ), SELECTEDVALUE ( fVendas[CanalVenda] ), SELECTEDVALUE ( dCliente[Segmento] ), SELECTEDVALUE ( dFilial[Filial] ), "Equipe comercial" ), "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ) & "</div><div class='tk-ts'>" & IF ( HASONEVALUE ( dVendedor[Vendedor] ), SELECTEDVALUE ( dVendedor[PerfilPerformance] ) & " · ", "" ) & "filial " & SELECTEDVALUE ( dFilial[Filial], "todas" ) & " · " & FORMAT ( [Período Início], "dd/MM/yy" ) & " a " & FORMAT ( [Período Fim], "dd/MM/yy" ) & "</div><div class='tk-tg'>" & "<div><span>Receita</span><b>" & SWITCH ( TRUE (), ISBLANK ( [Receita Líquida] ), "–", ABS ( [Receita Líquida] ) >= 1e9, "R$ " & FORMAT ( [Receita Líquida] / 1e9, "#,0.00", "pt-BR" ) & " bi", ABS ( [Receita Líquida] ) >= 1e6, "R$ " & FORMAT ( [Receita Líquida] / 1e6, "#,0.0", "pt-BR" ) & " mi", ABS ( [Receita Líquida] ) >= 1e3, "R$ " & FORMAT ( [Receita Líquida] / 1e3, "#,0", "pt-BR" ) & " mil", "R$ " & FORMAT ( [Receita Líquida], "#,0", "pt-BR" ) ) & "</b></div>" & "<div><span>Meta</span><b>" & IF ( ISFILTERED ( dProduto[Categoria] ) || ISFILTERED ( fVendas[CanalVenda] ) || ISFILTERED ( dCliente[Segmento] ), "n/a", IF ( ISBLANK ( [Atingimento Meta %] ), "–", FORMAT ( [Atingimento Meta %], "0.0%", "pt-BR" ) ) ) & "</b></div>" & "<div><span>vs AA</span><b>" & IF ( ISBLANK ( [Receita YoY %] ), "–", FORMAT ( [Receita YoY %], "+0.0%;-0.0%", "pt-BR" ) ) & "</b></div>" & "<div><span>MC %</span><b>" & IF ( ISBLANK ( [MC %] ), "–", FORMAT ( [MC %], "0.0%", "pt-BR" ) ) & "</b></div>" & "<div><span>Clientes</span><b>" & IF ( ISBLANK ( [Clientes Ativos] ), "–", FORMAT ( [Clientes Ativos], "#,0", "pt-BR" ) ) & "</b></div>" & "<div><span>Ticket</span><b>" & "R$ " & FORMAT ( [Ticket Médio], "#,0", "pt-BR" ) & "</b></div>" & "</div>" & SUBSTITUTE ( SUBSTITUTE ( [SVG | Spark Receita], "tk-sp", "tk-tp" ), "#0B1F33", "#FFFFFF" ) & "<div class='tk-tf'>" & "Receita mensal · meta só existe por vendedor e filial" & "</div></div>"
		displayFolder: 10 Apresentação
		lineageTag: 4ce86486-925a-5c8d-bec4-f592d1c81b70

	/// Série realizada do gráfico principal conforme a métrica escolhida (faturamento, margem de contribuição ou volume).
	measure 'Hero Atual' = SWITCH ( SELECTEDVALUE ( pMetrica[MetricaID], 1 ), 1, [Receita Líquida], 2, [Margem Contribuição], 3, [Quantidade] )
		displayFolder: 11 UX
		lineageTag: 31e2e1be-efad-5fc6-b395-e308af9c753f

		formatStringDefinition = SWITCH ( SELECTEDVALUE ( pMetrica[MetricaID], 1 ), 3, "#,0", """R$"" #,0" )

	/// Mesmo intervalo do ano anterior, truncado no corte.
	measure 'Hero Ano Anterior' = SWITCH ( SELECTEDVALUE ( pMetrica[MetricaID], 1 ), 1, [Receita Líquida LY], 2, [Margem Contribuição LY], 3, [Quantidade LY] )
		displayFolder: 11 UX
		lineageTag: ef09fee1-b5c4-5fa1-b9e8-fd73925985c6

		formatStringDefinition = SWITCH ( SELECTEDVALUE ( pMetrica[MetricaID], 1 ), 3, "#,0", """R$"" #,0" )

	/// Meta integral do mês. Disponível só para faturamento: a base não tem meta de margem de contribuição nem de volume.
	measure 'Hero Meta' = IF ( SELECTEDVALUE ( pMetrica[MetricaID], 1 ) = 1, [Meta Faturamento Mês Cheio] )
		displayFolder: 11 UX
		lineageTag: f4dd994d-a894-51b5-96f6-7a303bd39bd6

		formatStringDefinition = SWITCH ( SELECTEDVALUE ( pMetrica[MetricaID], 1 ), 3, "#,0", """R$"" #,0" )

	/// SIMULAÇÃO. Liga o último mês fechado à projeção de fechamento do mês do corte. Só para faturamento e em eixo mensal.
	measure 'Hero Projeção' =
			VAR _c = [Data Corte]
			VAR _mc = YEAR ( _c ) * 12 + MONTH ( _c )
			VAR _m = MAX ( dCalendario[MesIndice] )
			VAR _umMes = HASONEVALUE ( dCalendario[AnoMes] )
			RETURN
			    IF ( SELECTEDVALUE ( pMetrica[MetricaID], 1 ) = 1 && _umMes && _c < EOMONTH ( _c, 0 ),
			        SWITCH ( _m, _mc, [Projeção Fechamento Mês], _mc - 1, [Receita Líquida] ) )
		displayFolder: 11 UX
		lineageTag: a163a8c7-8792-5560-81ff-9ea2e6a0a9ef

		formatStringDefinition = SWITCH ( SELECTEDVALUE ( pMetrica[MetricaID], 1 ), 3, "#,0", """R$"" #,0" )

	/// Marca o mês fechado de maior valor entre os meses exibidos.
	measure 'Hero Máximo' =
			VAR _c = [Data Corte]
			VAR _mc = YEAR ( _c ) * 12 + MONTH ( _c )
			VAR _fechado = _c >= EOMONTH ( _c, 0 )
			VAR _atual = [Hero Atual]
			VAR _m = MAX ( dCalendario[MesIndice] )
			VAR _t =
			    FILTER (
			        ADDCOLUMNS ( FILTER ( CALCULATETABLE ( VALUES ( dCalendario[MesIndice] ), ALLSELECTED ( dCalendario ) ), dCalendario[MesIndice] < _mc || ( dCalendario[MesIndice] = _mc && _fechado ) ), "@v", CALCULATE ( [Hero Atual], ALLEXCEPT ( dCalendario, dCalendario[MesIndice] ) ) ),
			        NOT ISBLANK ( [@v] )
			    )
			VAR _max = MAXX ( _t, [@v] )
			RETURN IF ( HASONEVALUE ( dCalendario[AnoMes] ) && _m <= _mc && ( _m < _mc || _fechado ) && _atual = _max, _atual )
		displayFolder: 11 UX
		lineageTag: 1935a20b-3b14-536b-bef1-558e0bb6b8a6

		formatStringDefinition = SWITCH ( SELECTEDVALUE ( pMetrica[MetricaID], 1 ), 3, "#,0", """R$"" #,0" )

	/// Marca o mês fechado de menor valor entre os meses exibidos.
	measure 'Hero Mínimo' =
			VAR _c = [Data Corte]
			VAR _mc = YEAR ( _c ) * 12 + MONTH ( _c )
			VAR _fechado = _c >= EOMONTH ( _c, 0 )
			VAR _atual = [Hero Atual]
			VAR _m = MAX ( dCalendario[MesIndice] )
			VAR _t =
			    FILTER (
			        ADDCOLUMNS ( FILTER ( CALCULATETABLE ( VALUES ( dCalendario[MesIndice] ), ALLSELECTED ( dCalendario ) ), dCalendario[MesIndice] < _mc || ( dCalendario[MesIndice] = _mc && _fechado ) ), "@v", CALCULATE ( [Hero Atual], ALLEXCEPT ( dCalendario, dCalendario[MesIndice] ) ) ),
			        NOT ISBLANK ( [@v] )
			    )
			VAR _min = MINX ( _t, [@v] )
			RETURN IF ( HASONEVALUE ( dCalendario[AnoMes] ) && ( _m < _mc || _fechado ) && _atual = _min, _atual )
		displayFolder: 11 UX
		lineageTag: db47f0e8-6716-54bf-9ce1-c1f56c19c27d

		formatStringDefinition = SWITCH ( SELECTEDVALUE ( pMetrica[MetricaID], 1 ), 3, "#,0", """R$"" #,0" )

	/// Marca meses fechados cuja queda contra o mês anterior é igual ou maior que o limiar escolhido (padrão 10%).
	measure 'Hero Queda Crítica' =
			VAR _c = [Data Corte]
			VAR _mc = YEAR ( _c ) * 12 + MONTH ( _c )
			VAR _fechado = _c >= EOMONTH ( _c, 0 )
			VAR _m = MAX ( dCalendario[MesIndice] )
			VAR _atual = [Hero Atual]
			VAR _ant = CALCULATE ( [Hero Atual], DATEADD ( dCalendario[Data], -1, MONTH ) )
			VAR _var = DIVIDE ( _atual - _ant, _ant )
			RETURN IF ( HASONEVALUE ( dCalendario[AnoMes] ) && ( _m < _mc || _fechado ) && NOT ISBLANK ( _ant ) && _var <= - [Limite Queda], _atual )
		displayFolder: 11 UX
		lineageTag: 7f69cb8a-f03b-5cab-be4d-24fc4f447940

		formatStringDefinition = SWITCH ( SELECTEDVALUE ( pMetrica[MetricaID], 1 ), 3, "#,0", """R$"" #,0" )

	/// Variação contra o mesmo intervalo do mês anterior, para o tooltip do gráfico principal.
	measure 'Hero Variação Mês %' =
			VAR _atual = [Hero Atual]
			VAR _ant = CALCULATE ( [Hero Atual], DATEADD ( FILTER ( VALUES ( dCalendario[Data] ), dCalendario[Data] <= [Data Corte] ), -1, MONTH ) )
			RETURN IF ( NOT ISBLANK ( _atual ) && NOT ISBLANK ( _ant ), DIVIDE ( _atual - _ant, _ant ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 11 UX
		lineageTag: 53b6d2d7-3911-5660-be17-522ef6bd2e60

	measure 'Hero Variação AA %' =
			VAR _a = [Hero Atual]
			VAR _b = [Hero Ano Anterior]
			RETURN IF ( NOT ISBLANK ( _a ) && NOT ISBLANK ( _b ), DIVIDE ( _a - _b, _b ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 11 UX
		lineageTag: 5ed2d36b-75c6-5443-ba1a-cebd3e17543d

	/// Cor de barra: vermelho quando a receita cai contra o ano anterior, azul-marinho quando cresce, cinza sem base de comparação.
	measure 'UX | Cor Crescimento' =
			VAR _y = [Receita YoY %]
			RETURN SWITCH ( TRUE (), ISBLANK ( _y ), "#6C737D", _y < 0, "#E31E24", "#0B1F33" )
		isHidden
		displayFolder: 11 UX
		lineageTag: 2828f3ea-3069-5233-9983-cee979748268

	/// Cor por variação de MC %: vermelho ≤ −3 p.p., âmbar abaixo de zero, verde no positivo.
	measure 'UX | Cor Margem' =
			VAR _pp = [MC Variação pp]
			RETURN SWITCH ( TRUE (), ISBLANK ( _pp ), "#6C737D", _pp <= -3, "#E31E24", _pp < 0, "#E8A317", "#14804A" )
		isHidden
		displayFolder: 11 UX
		lineageTag: be9ea369-9890-5b0c-a9bf-859d97d0cb2d

	/// Cor da fonte do status de estoque.
	measure 'UX | Cor Status Estoque' = SWITCH ( [Status Estoque], "Ruptura", "#E31E24", "Crítico", "#C8161C", "Repor", "#B7791F", "Parado", "#6C737D", "Excesso", "#6C737D", "#14804A" )
		isHidden
		displayFolder: 11 UX
		lineageTag: 8e5ebf29-b257-5ce2-bdc9-4781030ba385

	measure 'UX | Cor Atingimento' =
			VAR _a = [Atingimento Meta %]
			RETURN SWITCH ( TRUE (), ISBLANK ( _a ), "#6C737D", _a >= 1, "#14804A", _a >= 0.95, "#B7791F", "#C8161C" )
		isHidden
		displayFolder: 11 UX
		lineageTag: e40e5c5f-9d27-5e60-96bb-05632f6595a5

	/// Rótulo com valor e variação contra o ano anterior.
	measure 'UX | Rótulo Receita' =
			VAR _v = [Receita Líquida]
			VAR _p = [Receita YoY %]
			RETURN IF ( NOT ISBLANK ( _v ), SWITCH ( TRUE (), ISBLANK ( _v ), "–", ABS ( _v ) >= 1e9, "R$ " & FORMAT ( _v / 1e9, "#,0.00", "pt-BR" ) & " bi", ABS ( _v ) >= 1e6, "R$ " & FORMAT ( _v / 1e6, "#,0.0", "pt-BR" ) & " mi", ABS ( _v ) >= 1e3, "R$ " & FORMAT ( _v / 1e3, "#,0", "pt-BR" ) & " mil", "R$ " & FORMAT ( _v, "#,0", "pt-BR" ) ) & " | " & IF ( ISBLANK ( _p ), "sem comparação", IF ( _p >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( _p ), "0.0%", "pt-BR" ) & " vs AA" ) )
		displayFolder: 11 UX
		lineageTag: b3d42738-c459-55f3-bd20-329d3070427a

	/// Título dinâmico do gráfico principal.
	measure 'UX | Título Tendência' =
			VAR _n = SWITCH ( SELECTEDVALUE ( pMetrica[MetricaID], 1 ), 1, "Faturamento líquido", 2, "Margem de contribuição", 3, "Volume em unidades" )
			VAR _y = [Hero Variação AA %]
			RETURN _n & IF ( ISBLANK ( _y ), ": evolução mensal", IF ( _y >= 0, " cresce ", " recua " ) & FORMAT ( ABS ( _y ), "0.0%", "pt-BR" ) & " contra o mesmo intervalo do ano anterior" )
		displayFolder: 11 UX
		lineageTag: 3085d0d3-2c6d-5251-92f1-e16f0dfb7a60

	measure 'Receita por Cliente Ativo' = DIVIDE ( [Receita Líquida], [Clientes Ativos] )
		formatString: "R$" #,0;-"R$" #,0;"R$" #,0
		displayFolder: 04 Clientes
		lineageTag: b3b304f4-2540-5e41-8d49-8733cc98738d

	/// Linha dinâmica da página inicial: data de corte e dimensão da base.
	measure 'HTML | Landing Info' =
			"<div style='font-family:Montserrat,Segoe UI,Arial,sans-serif;color:#C9D1DB;font-size:12.5px;font-weight:500;white-space:nowrap'>Dados realizados até <b style='color:#fff'>" & FORMAT ( [Data Corte], "dd/MM/yyyy" ) & "</b> · "
			    & FORMAT ( COUNTROWS ( dFilial ), "0" ) & " filiais · " & FORMAT ( COUNTROWS ( dCliente ), "#,0", "pt-BR" ) & " clientes · " & FORMAT ( COUNTROWS ( dProduto ), "#,0", "pt-BR" ) & " SKUs · base sintética de portfólio</div>"
		displayFolder: 10 Apresentação
		lineageTag: 0be930cf-e0d7-5d7d-ae8c-2751840d18b9

	/// Atraso médio apenas quando ao menos 95% dos pedidos do contexto já foram entregues. Evita o viés dos meses recentes, em que só as entregas rápidas já chegaram.
	measure 'Atraso Médio Maduro' =
			VAR _c = [Data Corte]
			VAR _ped = CALCULATE ( COUNTROWS ( fCompras ), KEEPFILTERS ( fCompras[DataPedido] <= _c ) )
			RETURN IF ( DIVIDE ( [Compras Entregues], _ped ) >= 0.95, [Atraso Médio] )
		formatString: #,0.0
		displayFolder: 06 Supply
		lineageTag: 1d5d0cd8-dfda-528e-b971-e0c988551c2e

	/// Status do item, só para linhas críticas. O teste barato de criticidade evita calcular a medida nas 2.800 combinações SKU × filial.
	measure 'Crítico | Status' = IF ( [Estoque Linha Crítica] = 1, [Status Estoque] )
		displayFolder: 05 Estoque
		lineageTag: 29c3792e-d92c-5c8e-a898-8caab30d6e6a

	/// Saldo no snapshot, só para linhas críticas. O teste barato de criticidade evita calcular a medida nas 2.800 combinações SKU × filial.
	measure 'Crítico | Saldo' = IF ( [Estoque Linha Crítica] = 1, [Estoque Qtd] )
		formatString: #,0
		displayFolder: 05 Estoque
		lineageTag: 0c89fda6-e3bb-5a2e-8d30-1220e7ef65cc

	/// Venda média diária de 90 dias, só para linhas críticas. O teste barato de criticidade evita calcular a medida nas 2.800 combinações SKU × filial.
	measure 'Crítico | Venda por Dia' = IF ( [Estoque Linha Crítica] = 1, [Venda Média Diária] )
		formatString: #,0.0
		displayFolder: 05 Estoque
		lineageTag: 9379a44d-f6b6-5b8f-975b-fbc79c01651b

	/// Recebimentos previstos no horizonte, só para linhas críticas. O teste barato de criticidade evita calcular a medida nas 2.800 combinações SKU × filial.
	measure 'Crítico | A Receber' = IF ( [Estoque Linha Crítica] = 1, [Recebimentos Previstos Qtd] )
		formatString: #,0
		displayFolder: 05 Estoque
		lineageTag: 1e756d5c-f522-51cf-92fc-1a3ecbb9614d

	/// Cor do status, só para linhas críticas. O teste barato de criticidade evita calcular a medida nas 2.800 combinações SKU × filial.
	measure 'Crítico | Cor Status' = IF ( [Estoque Linha Crítica] = 1, SWITCH ( [Status Estoque], "Ruptura", "#E31E24", "Crítico", "#C8161C", "Repor", "#B7791F", "Parado", "#6C737D", "Excesso", "#6C737D", "#14804A" ) )
		isHidden
		displayFolder: 05 Estoque
		lineageTag: 5c739dab-0ff2-56ff-95e1-17ecb77abc5c

	/// Barra de cobertura × lead time apenas para linhas críticas (ruptura ou abaixo da segurança).
	measure 'IMG | Barra Cobertura Crítico' = IF ( [Estoque Linha Crítica] = 1, [IMG | Barra Cobertura] )
		displayFolder: 10 Apresentação
		lineageTag: 64ec7271-f9e0-59c7-a9a3-1f4f4e87d4e3
		dataCategory: ImageUrl

	column Medida
		dataType: string
		isHidden
		lineageTag: 331060c3-c536-5f69-9800-d8e5727476da
