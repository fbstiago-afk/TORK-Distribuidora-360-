rray='3 2'/>" & "<text x='552.0' y='" & FORMAT ( ( 206 - ( ( MAX ( _l4, _l5 ) ) - _lo ) * _sc ) - 6, "0.0", "en-US" ) & "' text-anchor='middle' font-size='11' font-weight='700' fill='#0B1F33'>" & IF ( ISBLANK ( _d ), "–", IF ( _d >= 0, "+", "−" ) & SWITCH ( TRUE (), ISBLANK ( ABS ( _d ) ), "–", ABS ( ABS ( _d ) ) >= 1e9, "R$ " & FORMAT ( ABS ( _d ) / 1e9, "#,0.00", "pt-BR" ) & " bi", ABS ( ABS ( _d ) ) >= 1e6, "R$ " & FORMAT ( ABS ( _d ) / 1e6, "#,0.0", "pt-BR" ) & " mi", ABS ( ABS ( _d ) ) >= 1e3, "R$ " & FORMAT ( ABS ( _d ) / 1e3, "#,0", "pt-BR" ) & " mil", "R$ " & FORMAT ( ABS ( _d ), "#,0", "pt-BR" ) ) ) & "</text>" & "<text x='552.0' y='221' text-anchor='middle' font-size='10' font-weight='700' fill='#16212E'>Descontinuados</text>" & "<text x='552.0' y='234' text-anchor='middle' font-size='9.5' font-weight='500' fill='#6C737D'>" & IF ( ISBLANK ( DIVIDE ( _d, _l0 ) ), "–", FORMAT ( DIVIDE ( _d, _l0 ), "0.0%", "pt-BR" ) ) & "</text>" & "<rect x='626.0' y='" & FORMAT ( ( 206 - ( ( _l5 ) - _lo ) * _sc ), "0.0", "en-US" ) & "' width='54' height='" & FORMAT ( MAX ( 1.5, 206 - ( 206 - ( ( _l5 ) - _lo ) * _sc ) ), "0.0", "en-US" ) & "' rx='3' fill='" & "#0B1F33" & "'/>" & "<text x='653.0' y='" & FORMAT ( ( 206 - ( ( _l5 ) - _lo ) * _sc ) - 6, "0.0", "en-US" ) & "' text-anchor='middle' font-size='11' font-weight='700' fill='#0B1F33'>" & SWITCH ( TRUE (), ISBLANK ( _l5 ), "–", ABS ( _l5 ) >= 1e9, "R$ " & FORMAT ( _l5 / 1e9, "#,0.00", "pt-BR" ) & " bi", ABS ( _l5 ) >= 1e6, "R$ " & FORMAT ( _l5 / 1e6, "#,0.0", "pt-BR" ) & " mi", ABS ( _l5 ) >= 1e3, "R$ " & FORMAT ( _l5 / 1e3, "#,0", "pt-BR" ) & " mil", "R$ " & FORMAT ( _l5, "#,0", "pt-BR" ) ) & "</text>" & "<text x='653.0' y='221' text-anchor='middle' font-size='10' font-weight='700' fill='#16212E'>Receita atual</text>" & "<text x='653.0' y='234' text-anchor='middle' font-size='9.5' font-weight='500' fill='#6C737D'>" & IF ( ISBLANK ( DIVIDE ( _l5 - _l0, _l0 ) ), "–", FORMAT ( DIVIDE ( _l5 - _l0, _l0 ), "0.0%", "pt-BR" ) ) & "</text>" & "<text x='684' y='14' text-anchor='end' font-size='9.5' fill='#6C737D'>Eixo truncado para evidenciar os efeitos · percentuais sobre a receita do ano anterior</text></svg>" & "</div>" )
		displayFolder: 10 Apresentação
		lineageTag: b960f234-3000-5bbc-a8d3-c4113f2fa98c

	/// Matriz ABC × XYZ dinâmica. ABC pela receita do período sobre todo o portfólio (80% / 95%); XYZ pelo coeficiente de variação da quantidade mensal (X ≤ 0,30; Y ≤ 0,60; Z acima). Mostra só os SKUs do filtro de produto ativo.
	measure 'HTML | Heatmap ABC XYZ' =
			VAR _lx = [XYZ Limite X]
			VAR _ly = [XYZ Limite Y]
			VAR _all =
			    FILTER (
			        ADDCOLUMNS (
			            ALL ( dProduto[ProdutoID] ),
			            "@r", CALCULATE ( [Receita Líquida], ALLEXCEPT ( dProduto, dProduto[ProdutoID] ) ),
			            "@cv", CALCULATE ( [CV Demanda], ALLEXCEPT ( dProduto, dProduto[ProdutoID] ) )
			        ),
			        [@r] > 0
			    )
			VAR _tot = SUMX ( _all, [@r] )
			VAR _cls =
			    ADDCOLUMNS (
			        _all,
			        "@abc", VAR _r = [@r] VAR _antes = SUMX ( FILTER ( _all, [@r] > _r ), [@r] ) RETURN SWITCH ( TRUE (), _antes < 0.8 * _tot, "A", _antes < 0.95 * _tot, "B", "C" ),
			        "@xyz", SWITCH ( TRUE (), ISBLANK ( [@cv] ), "n/d", [@cv] <= _lx, "X", [@cv] <= _ly, "Y", "Z" )
			    )
			VAR _vis = NATURALINNERJOIN ( _cls, VALUES ( dProduto[ProdutoID] ) )
			VAR _totVis = SUMX ( _vis, [@r] )
			VAR _nd = COUNTROWS ( FILTER ( _vis, [@xyz] = "n/d" ) ) + 0
			VAR _nAX = COUNTROWS ( FILTER ( _vis, [@abc] = "A" && [@xyz] = "X" ) ) + 0
			VAR _rAX = DIVIDE ( SUMX ( FILTER ( _vis, [@abc] = "A" && [@xyz] = "X" ), [@r] ), _totVis ) + 0
			VAR _nAY = COUNTROWS ( FILTER ( _vis, [@abc] = "A" && [@xyz] = "Y" ) ) + 0
			VAR _rAY = DIVIDE ( SUMX ( FILTER ( _vis, [@abc] = "A" && [@xyz] = "Y" ), [@r] ), _totVis ) + 0
			VAR _nAZ = COUNTROWS ( FILTER ( _vis, [@abc] = "A" && [@xyz] = "Z" ) ) + 0
			VAR _rAZ = DIVIDE ( SUMX ( FILTER ( _vis, [@abc] = "A" && [@xyz] = "Z" ), [@r] ), _totVis ) + 0
			VAR _nBX = COUNTROWS ( FILTER ( _vis, [@abc] = "B" && [@xyz] = "X" ) ) + 0
			VAR _rBX = DIVIDE ( SUMX ( FILTER ( _vis, [@abc] = "B" && [@xyz] = "X" ), [@r] ), _totVis ) + 0
			VAR _nBY = COUNTROWS ( FILTER ( _vis, [@abc] = "B" && [@xyz] = "Y" ) ) + 0
			VAR _rBY = DIVIDE ( SUMX ( FILTER ( _vis, [@abc] = "B" && [@xyz] = "Y" ), [@r] ), _totVis ) + 0
			VAR _nBZ = COUNTROWS ( FILTER ( _vis, [@abc] = "B" && [@xyz] = "Z" ) ) + 0
			VAR _rBZ = DIVIDE ( SUMX ( FILTER ( _vis, [@abc] = "B" && [@xyz] = "Z" ), [@r] ), _totVis ) + 0
			VAR _nCX = COUNTROWS ( FILTER ( _vis, [@abc] = "C" && [@xyz] = "X" ) ) + 0
			VAR _rCX = DIVIDE ( SUMX ( FILTER ( _vis, [@abc] = "C" && [@xyz] = "X" ), [@r] ), _totVis ) + 0
			VAR _nCY = COUNTROWS ( FILTER ( _vis, [@abc] = "C" && [@xyz] = "Y" ) ) + 0
			VAR _rCY = DIVIDE ( SUMX ( FILTER ( _vis, [@abc] = "C" && [@xyz] = "Y" ), [@r] ), _totVis ) + 0
			VAR _nCZ = COUNTROWS ( FILTER ( _vis, [@abc] = "C" && [@xyz] = "Z" ) ) + 0
			VAR _rCZ = DIVIDE ( SUMX ( FILTER ( _vis, [@abc] = "C" && [@xyz] = "Z" ), [@r] ), _totVis ) + 0
			VAR _maxR = MAX ( MAX ( MAX ( MAX ( _rAX, _rAY ), MAX ( _rAZ, _rBX ) ), MAX ( MAX ( _rBY, _rBZ ), MAX ( _rCX, _rCY ) ) ), _rCZ )
			RETURN [HTML | CSS] & "<div class='tk'>" & "<svg class='tk-sv' viewBox='0 0 420 262' preserveAspectRatio='xMidYMid meet' font-family='Montserrat,Segoe UI,Arial'>" & "<text x='108' y='14' text-anchor='middle' font-size='11' font-weight='800' fill='#0B1F33'>X <tspan font-weight='500' fill='#6C737D'>estável</tspan></text>" & "<text x='230' y='14' text-anchor='middle' font-size='11' font-weight='800' fill='#0B1F33'>Y <tspan font-weight='500' fill='#6C737D'>variável</tspan></text>" & "<text x='352' y='14' text-anchor='middle' font-size='11' font-weight='800' fill='#0B1F33'>Z <tspan font-weight='500' fill='#6C737D'>errática</tspan></text>" & "<text x='24' y='62' text-anchor='middle' font-size='20' font-weight='800' fill='#0B1F33'>A</text>" & "<rect x='50' y='24' width='116' height='64' rx='8' fill='#0B1F33' fill-opacity='" & FORMAT ( 0.06 + 0.94 * DIVIDE ( _rAX, _maxR, 0 ), "0.0", "en-US" ) & "'/>" & "<text x='108' y='54' text-anchor='middle' font-size='19' font-weight='800' fill='" & IF ( DIVIDE ( _rAX, _maxR, 0 ) > 0.45, "#FFFFFF", "#0B1F33" ) & "'>" & FORMAT ( _nAX, "#,0", "pt-BR" ) & "</text>" & "<text x='108' y='72' text-anchor='middle' font-size='10' font-weight='600' fill='" & IF ( DIVIDE ( _rAX, _maxR, 0 ) > 0.45, "#DCE3EA", "#3C4654" ) & "'>" & FORMAT ( _rAX, "0.0%", "pt-BR" ) & " da receita" & "</text>" & "<rect x='172' y='24' width='116' height='64' rx='8' fill='#0B1F33' fill-opacity='" & FORMAT ( 0.06 + 0.94 * DIVIDE ( _rAY, _maxR, 0 ), "0.0", "en-US" ) & "'/>" & "<text x='230' y='54' text-anchor='middle' font-size='19' font-weight='800' fill='" & IF ( DIVIDE ( _rAY, _maxR, 0 ) > 0.45, "#FFFFFF", "#0B1F33" ) & "'>" & FORMAT ( _nAY, "#,0", "pt-BR" ) & "</text>" & "<text x='230' y='72' text-anchor='middle' font-size='10' font-weight='600' fill='" & IF ( DIVIDE ( _rAY, _maxR, 0 ) > 0.45, "#DCE3EA", "#3C4654" ) & "'>" & FORMAT ( _rAY, "0.0%", "pt-BR" ) & " da receita" & "</text>" & "<rect x='294' y='24' width='116' height='64' rx='8' fill='#0B1F33' fill-opacity='" & FORMAT ( 0.06 + 0.94 * DIVIDE ( _rAZ, _maxR, 0 ), "0.0", "en-US" ) & "'/>" & "<text x='352' y='54' text-anchor='middle' font-size='19' font-weight='800' fill='" & IF ( DIVIDE ( _rAZ, _maxR, 0 ) > 0.45, "#FFFFFF", "#0B1F33" ) & "'>" & FORMAT ( _nAZ, "#,0", "pt-BR" ) & "</text>" & "<text x='352' y='72' text-anchor='middle' font-size='10' font-weight='600' fill='" & IF ( DIVIDE ( _rAZ, _maxR, 0 ) > 0.45, "#DCE3EA", "#3C4654" ) & "'>" & FORMAT ( _rAZ, "0.0%", "pt-BR" ) & " da receita" & "</text>" & "<text x='24' y='132' text-anchor='middle' font-size='20' font-weight='800' fill='#0B1F33'>B</text>" & "<rect x='50' y='94' width='116' height='64' rx='8' fill='#0B1F33' fill-opacity='" & FORMAT ( 0.06 + 0.94 * DIVIDE ( _rBX, _maxR, 0 ), "0.0", "en-US" ) & "'/>" & "<text x='108' y='124' text-anchor='middle' font-size='19' font-weight='800' fill='" & IF ( DIVIDE ( _rBX, _maxR, 0 ) > 0.45, "#FFFFFF", "#0B1F33" ) & "'>" & FORMAT ( _nBX, "#,0", "pt-BR" ) & "</text>" & "<text x='108' y='142' text-anchor='middle' font-size='10' font-weight='600' fill='" & IF ( DIVIDE ( _rBX, _maxR, 0 ) > 0.45, "#DCE3EA", "#3C4654" ) & "'>" & FORMAT ( _rBX, "0.0%", "pt-BR" ) & " da receita" & "</text>" & "<rect x='172' y='94' width='116' height='64' rx='8' fill='#0B1F33' fill-opacity='" & FORMAT ( 0.06 + 0.94 * DIVIDE ( _rBY, _maxR, 0 ), "0.0", "en-US" ) & "'/>" & "<text x='230' y='124' text-anchor='middle' font-size='19' font-weight='800' fill='" & IF ( DIVIDE ( _rBY, _maxR, 0 ) > 0.45, "#FFFFFF", "#0B1F33" ) & "'>" & FORMAT ( _nBY, "#,0", "pt-BR" ) & "</text>" & "<text x='230' y='142' text-anchor='middle' font-size='10' font-weight='600' fill='" & IF ( DIVIDE ( _rBY, _maxR, 0 ) > 0.45, "#DCE3EA", "#3C4654" ) & "'>" & FORMAT ( _rBY, "0.0%", "pt-BR" ) & " da receita" & "</text>" & "<rect x='294' y='94' width='116' height='64' rx='8' fill='#0B1F33' fill-opacity='" & FORMAT ( 0.06 + 0.94 * DIVIDE ( _rBZ, _maxR, 0 ), "0.0", "en-US" ) & "'/>" & "<text x='352' y='124' text-anchor='middle' font-size='19' font-weight='800' fill='" & IF ( DIVIDE ( _rBZ, _maxR, 0 ) > 0.45, "#FFFFFF", "#0B1F33" ) & "'>" & FORMAT ( _nBZ, "#,0", "pt-BR" ) & "</text>" & "<text x='352' y='142' text-anchor='middle' font-size='10' font-weight='600' fill='" & IF ( DIVIDE ( _rBZ, _maxR, 0 ) > 0.45, "#DCE3EA", "#3C4654" ) & "'>" & FORMAT ( _rBZ, "0.0%", "pt-BR" ) & " da receita" & "</text>" & "<text x='24' y='202' text-anchor='middle' font-size='20' font-weight='800' fill='#0B1F33'>C</text>" & "<rect x='50' y='164' width='116' height='64' rx='8' fill='#0B1F33' fill-opacity='" & FORMAT ( 0.06 + 0.94 * DIVIDE ( _rCX, _maxR, 0 ), "0.0", "en-US" ) & "'/>" & "<text x='108' y='194' text-anchor='middle' font-size='19' font-weight='800' fill='" & IF ( DIVIDE ( _rCX, _maxR, 0 ) > 0.45, "#FFFFFF", "#0B1F33" ) & "'>" & FORMAT ( _nCX, "#,0", "pt-BR" ) & "</text>" & "<text x='108' y='212' text-anchor='middle' font-size='10' font-weight='600' fill='" & IF ( DIVIDE ( _rCX, _maxR, 0 ) > 0.45, "#DCE3EA", "#3C4654" ) & "'>" & FORMAT ( _rCX, "0.0%", "pt-BR" ) & " da receita" & "</text>" & "<rect x='172' y='164' width='116' height='64' rx='8' fill='#0B1F33' fill-opacity='" & FORMAT ( 0.06 + 0.94 * DIVIDE ( _rCY, _maxR, 0 ), "0.0", "en-US" ) & "'/>" & "<text x='230' y='194' text-anchor='middle' font-size='19' font-weight='800' fill='" & IF ( DIVIDE ( _rCY, _maxR, 0 ) > 0.45, "#FFFFFF", "#0B1F33" ) & "'>" & FORMAT ( _nCY, "#,0", "pt-BR" ) & "</text>" & "<text x='230' y='212' text-anchor='middle' font-size='10' font-weight='600' fill='" & IF ( DIVIDE ( _rCY, _maxR, 0 ) > 0.45, "#DCE3EA", "#3C4654" ) & "'>" & FORMAT ( _rCY, "0.0%", "pt-BR" ) & " da receita" & "</text>" & "<rect x='294' y='164' width='116' height='64' rx='8' fill='#0B1F33' fill-opacity='" & FORMAT ( 0.06 + 0.94 * DIVIDE ( _rCZ, _maxR, 0 ), "0.0", "en-US" ) & "'/>" & "<text x='352' y='194' text-anchor='middle' font-size='19' font-weight='800' fill='" & IF ( DIVIDE ( _rCZ, _maxR, 0 ) > 0.45, "#FFFFFF", "#0B1F33" ) & "'>" & FORMAT ( _nCZ, "#,0", "pt-BR" ) & "</text>" & "<text x='352' y='212' text-anchor='middle' font-size='10' font-weight='600' fill='" & IF ( DIVIDE ( _rCZ, _maxR, 0 ) > 0.45, "#DCE3EA", "#3C4654" ) & "'>" & FORMAT ( _rCZ, "0.0%", "pt-BR" ) & " da receita" & "</text>" & "<text x='210' y='250' text-anchor='middle' font-size='9.5' fill='#6C737D'>" & "Número de SKUs por célula · intensidade pela receita · " & FORMAT ( _nd, "#,0", "pt-BR" ) & " SKUs sem amostra de 6 meses" & "</text></svg>" & "</div>"
