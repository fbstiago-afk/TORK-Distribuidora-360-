	/// Sparkline mensal de [Receita Líquida] nos meses fechados do contexto.
	measure 'SVG | Spark Receita' =
			VAR _c = [Data Corte]
			VAR _mc = YEAR ( _c ) * 12 + MONTH ( _c )
			VAR _fechado = _c >= EOMONTH ( _c, 0 )
			VAR _t =
			    FILTER (
			        ADDCOLUMNS (
			            FILTER ( VALUES ( dCalendario[MesIndice] ), dCalendario[MesIndice] < _mc || ( dCalendario[MesIndice] = _mc && _fechado ) ),
			            "@v", [Receita Líquida]
			        ),
			        NOT ISBLANK ( [@v] )
			    )
			VAR _n = COUNTROWS ( _t )
			VAR _x0 = MINX ( _t, dCalendario[MesIndice] )
			VAR _x1 = MAXX ( _t, dCalendario[MesIndice] )
			VAR _y0 = MINX ( _t, [@v] )
			VAR _y1 = MAXX ( _t, [@v] )
			VAR _pts =
			    CONCATENATEX (
			        _t,
			        FORMAT ( 2 + DIVIDE ( dCalendario[MesIndice] - _x0, _x1 - _x0, 0 ) * 116, "0.0", "en-US" ) & ","
			            & FORMAT ( 24 - DIVIDE ( [@v] - _y0, _y1 - _y0, 0.5 ) * 20, "0.0", "en-US" ),
			        " ", dCalendario[MesIndice], ASC
			    )
			VAR _ult = MAXX ( FILTER ( _t, dCalendario[MesIndice] = _x1 ), [@v] )
			VAR _yu = FORMAT ( 24 - DIVIDE ( _ult - _y0, _y1 - _y0, 0.5 ) * 20, "0.0", "en-US" )
			RETURN IF ( _n >= 2, "<svg class='tk-sp' viewBox='0 0 120 28' preserveAspectRatio='none'><polygon points='2,28 " & _pts & " 118,28' fill='#0B1F33' fill-opacity='.10'/><polyline points='" & _pts & "' fill='none' stroke='#0B1F33' stroke-width='1.5' stroke-linejoin='round' vector-effect='non-scaling-stroke'/></svg>" )
		isHidden
		displayFolder: 10 Apresentação
		lineageTag: 04bf791a-064d-5e4c-94f1-e51315a90365

	/// Sparkline mensal de [Receita Líquida] como imagem SVG para tabela ou matriz nativa.
	measure 'IMG | Spark Receita' =
			VAR _c = [Data Corte]
			VAR _mc = YEAR ( _c ) * 12 + MONTH ( _c )
			VAR _fechado = _c >= EOMONTH ( _c, 0 )
			VAR _t =
			    FILTER (
			        ADDCOLUMNS (
			            FILTER ( VALUES ( dCalendario[MesIndice] ), dCalendario[MesIndice] < _mc || ( dCalendario[MesIndice] = _mc && _fechado ) ),
			            "@v", [Receita Líquida]
			        ),
			        NOT ISBLANK ( [@v] )
			    )
			VAR _n = COUNTROWS ( _t )
			VAR _x0 = MINX ( _t, dCalendario[MesIndice] )
			VAR _x1 = MAXX ( _t, dCalendario[MesIndice] )
			VAR _y0 = MINX ( _t, [@v] )
			VAR _y1 = MAXX ( _t, [@v] )
			VAR _pts =
			    CONCATENATEX (
			        _t,
			        FORMAT ( 2 + DIVIDE ( dCalendario[MesIndice] - _x0, _x1 - _x0, 0 ) * 116, "0.0", "en-US" ) & ","
			            & FORMAT ( 24 - DIVIDE ( [@v] - _y0, _y1 - _y0, 0.5 ) * 20, "0.0", "en-US" ),
			        " ", dCalendario[MesIndice], ASC
			    )
			VAR _ult = MAXX ( FILTER ( _t, dCalendario[MesIndice] = _x1 ), [@v] )
			VAR _yu = FORMAT ( 24 - DIVIDE ( _ult - _y0, _y1 - _y0, 0.5 ) * 20, "0.0", "en-US" )
			RETURN IF ( _n >= 2, "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='150' height='22' viewBox='0 0 120 28' preserveAspectRatio='none'><polygon points='2,28 " & _pts & " 118,28' fill='rgb(11,31,51)' fill-opacity='.10'/><polyline points='" & _pts & "' fill='none' stroke='rgb(11,31,51)' stroke-width='1.6' stroke-linejoin='round'/><circle cx='118' cy='" & _yu & "' r='2.4' fill='rgb(227,30,36)'/></svg>" )
		displayFolder: 10 Apresentação
		lineageTag: c55f033c-6ad2-5239-885b-7049e764235e
		dataCategory: ImageUrl

