 "' y2='" & FORMAT ( ( 206 - ( _mc ) * _sc ), "0.0", "en-US" ) & "' stroke='#9AA3AE' stroke-width='1' stroke-dasharray='3 2'/>" & "<text x='566.4' y='" & FORMAT ( ( 206 - ( _mb - _fr ) * _sc ) - 6, "0.0", "en-US" ) & "' text-anchor='middle' font-size='11' font-weight='700' fill='#0B1F33'>" & "−" & SWITCH ( TRUE (), ISBLANK ( _co ), "–", ABS ( _co ) >= 1e9, "R$ " & FORMAT ( _co / 1e9, "#,0.00", "pt-BR" ) & " bi", ABS ( _co ) >= 1e6, "R$ " & FORMAT ( _co / 1e6, "#,0.0", "pt-BR" ) & " mi", ABS ( _co ) >= 1e3, "R$ " & FORMAT ( _co / 1e3, "#,0", "pt-BR" ) & " mil", "R$ " & FORMAT ( _co, "#,0", "pt-BR" ) ) & "</text>" & "<text x='566.4' y='221' text-anchor='middle' font-size='10' font-weight='700' fill='#16212E'>Comissão</text>" & "<text x='566.4' y='234' text-anchor='middle' font-size='9.5' font-weight='500' fill='#6C737D'>" & IF ( ISBLANK ( DIVIDE ( _co, _rb ) ), "–", FORMAT ( DIVIDE ( _co, _rb ), "0.0%", "pt-BR" ) ) & "</text>" & "<rect x='626.0' y='" & FORMAT ( ( 206 - ( _mc ) * _sc ), "0.0", "en-US" ) & "' width='54' height='" & FORMAT ( MAX ( 1.5, 206 - ( 206 - ( _mc ) * _sc ) ), "0.0", "en-US" ) & "' rx='3' fill='" & "#14804A" & "'/>" & "<text x='653.0' y='" & FORMAT ( ( 206 - ( _mc ) * _sc ) - 6, "0.0", "en-US" ) & "' text-anchor='middle' font-size='11' font-weight='700' fill='#0B1F33'>" & SWITCH ( TRUE (), ISBLANK ( _mc ), "–", ABS ( _mc ) >= 1e9, "R$ " & FORMAT ( _mc / 1e9, "#,0.00", "pt-BR" ) & " bi", ABS ( _mc ) >= 1e6, "R$ " & FORMAT ( _mc / 1e6, "#,0.0", "pt-BR" ) & " mi", ABS ( _mc ) >= 1e3, "R$ " & FORMAT ( _mc / 1e3, "#,0", "pt-BR" ) & " mil", "R$ " & FORMAT ( _mc, "#,0", "pt-BR" ) ) & "</text>" & "<text x='653.0' y='221' text-anchor='middle' font-size='10' font-weight='700' fill='#16212E'>Margem contrib.</text>" & "<text x='653.0' y='234' text-anchor='middle' font-size='9.5' font-weight='500' fill='#6C737D'>" & IF ( ISBLANK ( DIVIDE ( _mc, _rb ) ), "–", FORMAT ( DIVIDE ( _mc, _rb ), "0.0%", "pt-BR" ) ) & "</text>" & "<text x='684' y='14' text-anchor='end' font-size='9.5' fill='#6C737D'>Percentuais sobre a receita bruta · economia da venda, não DRE contábil</text></svg>" & "</div>" )
// formato: texto

// Ponte Preço–Volume–Mix da receita líquida contra o mesmo intervalo do ano anterior, com SKUs novos e descontinuados separados. Eixo vertical truncado, sinalizado na nota.
[HTML | Ponte PVM] =
VAR _l0 = [Receita Líquida LY]
VAR _p = [PVM Preço]
VAR _v = [PVM Volume]
VAR _m = [PVM Mix]
VAR _n = [PVM Novos]
VAR _d = [PVM Descontinuados]
VAR _l1 = _l0 + _p
VAR _l2 = _l1 + _v
VAR _l3 = _l2 + _m
VAR _l4 = _l3 + _n
VAR _l5 = _l4 + _d
VAR _max = MAX ( MAX ( MAX ( _l0, _l1 ), MAX ( _l2, _l3 ) ), MAX ( _l4, _l5 ) )
VAR _min = MIN ( MIN ( MIN ( _l0, _l1 ), MIN ( _l2, _l3 ) ), MIN ( _l4, _l5 ) )
VAR _lo = MAX ( 0, _min - ( _max - _min ) * 0.6 )
VAR _sc = DIVIDE ( 160, _max - _lo )
RETURN
    IF ( ISBLANK ( _l0 ), [HTML | CSS] & "<div class='tk' style='display:flex;align-items:center;justify-content:center;color:#6C737D;font-size:12px;text-align:center;padding:20px'>Sem ano anterior comparável no período selecionado. O PVM precisa de um intervalo com base em 2024 ou 2025.</div>",
        [HTML | CSS] & "<div class='tk'>" & "<svg class='tk-sv' viewBox='0 0 700 250' preserveAspectRatio='xMidYMid meet' font-family='Montserrat,Segoe UI,Arial'><line x1='16' y1='206' x2='684' y2='206' stroke='#C5CBD3' stroke-width='1'/>" & "<rect x='20.0' y='" & FORMAT ( ( 206 - ( ( _l0 ) - _lo ) * _sc ), "0.0", "en-US" ) & "' width='54' height='" & FORMAT ( MAX ( 1.5, 206 - ( 206 - ( ( _l0 ) - _lo ) * _sc ) ), "0.0", "en-US" ) & "' rx='3' fill='" & "#6C737D" & "'/>" & "<line x1='74.0' x2='121.0' y1='" & FORMAT ( ( 206 - ( ( _l0 ) - _lo ) * _sc ), "0.0", "en-US" ) & "' y2='" & FORMAT ( ( 206 - ( ( _l0 ) - _lo ) * _sc ), "0.0", "en-US" ) & "' stroke='#9AA3AE' stroke-width='1' stroke-dasharray='3 2'/>" & "<text x='47.0' y='" & FORMAT ( ( 206 - ( ( _l0 ) - _lo ) * _sc ) - 6, "0.0", "en-US" ) & "' text-anchor='middle' font-size='11' font-weight='700' fill='#0B1F33'>" & SWITCH ( TRUE (), ISBLANK ( _l0 ), "–", ABS ( _l0 ) >= 1e9, "R$ " & FORMAT ( _l0 / 1e9, "#,0.00", "pt-BR" ) & " bi", ABS ( _l0 ) >= 1e6, "R$ " & FORMAT ( _l0 / 1e6, "#,0.0", "pt-BR" ) & " mi", ABS ( _l0 ) >= 1e3, "R$ " & FORMAT ( _l0 / 1e3, "#,0", "pt-BR" ) & " mil", "R$ " & FORMAT ( _l0, "#,0", "pt-BR" ) ) & "</text>" & "<text x='47.0' y='221' text-anchor='middle' font-size='10' font-weight='700' fill='#16212E'>Receita AA</text>" & "<text x='47.0' y='234' text-anchor='middle' font-size='9.5' font-weight='500' fill='#6C737D'>" & "mesmo intervalo" & "</text>" & "<rect x='121.0' y='" & FORMAT ( ( 206 - ( ( MAX ( _l0, _l1 ) ) - _lo ) * _sc ), "0.0", "en-US" ) & "' width='54' height='" & FORMAT ( MAX ( 1.5, ( 206 - ( ( MIN ( _l0, _l1 ) ) - _lo ) * _sc ) - ( 206 - ( ( MAX ( _l0, _l1 ) ) - _lo ) * _sc ) ), "0.0", "en-US" ) & "' rx='3' fill='" & IF ( _p >= 0, "#14804A", "#E31E24" ) & "'/>" & "<line x1='175.0' x2='222.0' y1='" & FORMAT ( ( 206 - ( ( _l1 ) - _lo ) * _sc ), "0.0", "en-US" ) & "' y2='" & FORMAT ( ( 206 - ( ( _l1 ) - _lo ) * _sc ), "0.0", "en-US" ) & "' stroke='#9AA3AE' stroke-width='1' stroke-dasharray='3 2'/>" & "<text x='148.0' y='" & FORMAT ( ( 206 - ( ( MAX ( _l0, _l1 ) ) - _lo ) * _sc ) - 6, "0.0", "en-US" ) & "' text-anchor='middle' font-size='11' font-weight='700' fill='#0B1F33'>" & IF ( ISBLANK ( _p ), "–", IF ( _p >= 0, "+", "−" ) & SWITCH ( TRUE (), ISBLANK ( ABS ( _p ) ), "–", ABS ( ABS ( _p ) ) >= 1e9, "R$ " & FORMAT ( ABS ( _p ) / 1e9, "#,0.00", "pt-BR" ) & " bi", ABS ( ABS ( _p ) ) >= 1e6, "R$ " & FORMAT ( ABS ( _p ) / 1e6, "#,0.0", "pt-BR" ) & " mi", ABS ( ABS ( _p ) ) >= 1e3, "R$ " & FORMAT ( ABS ( _p ) / 1e3, "#,0", "pt-BR" ) & " mil", "R$ " & FORMAT ( ABS ( _p ), "#,0", "pt-BR" ) ) ) & "</text>" & "<text x='148.0' y='221' text-anchor='middle' font-size='10' font-weight='700' fill='#16212E'>Preço</text>" & "<text x='148.0' y='234' text-anchor='middle' font-size='9.5' font-weight='500' fill='#6C737D'>" & IF ( ISBLANK ( DIVIDE ( _p, _l0 ) ), "–", FORMAT ( DIVIDE ( _p, _l0 ), "0.0%", "pt-BR" ) ) & "</text>" & "<rect x='222.0' y='" & FORMAT ( ( 206 - ( ( MAX ( _l1, _l2 ) ) - _lo ) * _sc ), "0.0", "en-US" ) & "' width='54' height='" & FORMAT ( MAX ( 1.5, ( 206 - ( ( MIN ( _l1, _l2 ) ) - _lo ) * _sc ) - ( 206 - ( ( MAX ( _l1, _l2 ) ) - _lo ) * _sc ) ), "0.0", "en-US" ) & "' rx='3' fill='" & IF ( _v >= 0, "#14804A", "#E31E24" ) & "'/>" & "<line x1='276.0' x2='323.0' y1='" & FORMAT ( ( 206 - ( ( _l2 ) - _lo ) * _sc ), "0.0", "en-US" ) & "' y2='" & FORMAT ( ( 206 - ( ( _l2 ) - _lo ) * _sc ), "0.0", "en-US" ) & "' stroke='#9AA3AE' stroke-width='1' stroke-dasharray='3 2'/>" & "<text x='249.0' y='" & FORMAT ( ( 206 - ( ( MAX ( _l1, _l2 ) ) - _lo ) * _sc ) - 6, "0.0", "en-US" ) & "' text-anchor='middle' font-size='11' font-weight='700' fill='#0B1F33'>" & IF ( ISBLANK ( _v ), "–", IF ( _v >= 0, "+", "−" ) & SWITCH ( TRUE (), ISBLANK ( ABS ( _v ) ), "–", ABS ( ABS ( _v ) ) >= 1e9, "R$ " & FORMAT ( ABS ( _v ) / 1e9, "#,0.00", "pt-BR" ) & " bi", ABS ( ABS ( _v ) ) >= 1e6, "R$ " & FORMAT ( ABS ( _v ) / 1e6, "#,0.0", "pt-BR" ) & " mi", ABS ( ABS ( _v ) ) >= 1e3, "R$ " & FORMAT ( ABS ( _v ) / 1e3, "#,0", "pt-BR" ) & " mil", "R$ " & FORMAT ( ABS ( _v ), "#,0", "pt-BR" ) ) ) & "</text>" & "<text x='249.0' y='221' text-anchor='middle' font-size='10' font-weight='700' fill='#16212E'>Volume</text>" & "<text x='249.0' y='234' text-anchor='middle' font-size='9.5' font-weight='500' fill='#6C737D'>" & IF ( ISBLANK ( DIVIDE ( _v, _l0 ) ), "–", FORMAT ( DIVIDE ( _v, _l0 ), "0.0%", "pt-BR" ) ) & "</text>" & "<rect x='323.0' y='" & FORMAT ( ( 206 - ( ( MAX ( _l2, _l3 ) ) - _lo ) * _sc ), "0.0", "en-US" ) & "' width='54' height='" & FORMAT ( MAX ( 1.5, ( 206 - ( ( MIN ( _l2, _l3 ) ) - _lo ) * _sc ) - ( 206 - ( ( MAX ( _l2, _l3 ) ) - _lo ) * _sc ) ), "0.0", "en-US" ) & "' rx='3' fill='" & IF ( _m >= 0, "#14804A", "#E31E24" ) & "'/>" & "<line x1='377.0' x2='424.0' y1='" & FORMAT ( ( 206 - ( ( _l3 ) - _lo ) * _sc ), "0.0", "en-US" ) & "' y2='" & FORMAT ( ( 206 - ( ( _l3 ) - _lo ) * _sc ), "0.0", "en-US" ) & "' stroke='#9AA3AE' stroke-width='1' stroke-dasharray='3 2'/>" & "<text x='350.0' y='" & FORMAT ( ( 206 - ( ( MAX ( _l2, _l3 ) ) - _lo ) * _sc ) - 6, "0.0", "en-US" ) & "' text-anchor='middle' font-size='11' font-weight='700' fill='#0B1F33'>" & IF ( ISBLANK ( _m ), "–", IF ( _m >= 0, "+", "−" ) & SWITCH ( TRUE (), ISBLANK ( ABS ( _m ) ), "–", ABS ( ABS ( _m ) ) >= 1e9, "R$ " & FORMAT ( ABS ( _m ) / 1e9, "#,0.00", "pt-BR" ) & " bi", ABS ( ABS ( _m ) ) >= 1e6, "R$ " & FORMAT ( ABS ( _m ) / 1e6, "#,0.0", "pt-BR" ) & " mi", ABS ( ABS ( _m ) ) >= 1e3, "R$ " & FORMAT ( ABS ( _m ) / 1e3, "#,0", "pt-BR" ) & " mil", "R$ " & FORMAT ( ABS ( _m ), "#,0", "pt-BR" ) ) ) & "</text>" & "<text x='350.0' y='221' text-anchor='middle' font-size='10' font-weight='700' fill='#16212E'>Mix</text>" & "<text x='350.0' y='234' text-anchor='middle' font-size='9.5' font-weight='500' fill='#6C737D'>" & IF ( ISBLANK ( DIVIDE ( _m, _l0 ) ), "–", FORMAT ( DIVIDE ( _m, _l0 ), "0.0%", "pt-BR" ) ) & "</text>" & "<rect x='424.0' y='" & FORMAT ( ( 206 - ( ( MAX ( _l3, _l4 ) ) - _lo ) * _sc ), "0.0", "en-US" ) & "' width='54' height='" & FORMAT ( MAX ( 1.5, ( 206 - ( ( MIN ( _l3, _l4 ) ) - _lo ) * _sc ) - ( 206 - ( ( MAX ( _l3, _l4 ) ) - _lo ) * _sc ) ), "0.0", "en-US" ) & "' rx='3' fill='" & IF ( _n >= 0, "#14804A", "#E31E24" ) & "'/>" & "<line x1='478.0' x2='525.0' y1='" & FORMAT ( ( 206 - ( ( _l4 ) - _lo ) * _sc ), "0.0", "en-US" ) & "' y2='" & FORMAT ( ( 206 - ( ( _l4 ) - _lo ) * _sc ), "0.0", "en-US" ) & "' stroke='#9AA3AE' stroke-width='1' stroke-dasharray='3 2'/>" & "<text x='451.0' y='" & FORMAT ( ( 206 - ( ( MAX ( _l3, _l4 ) ) - _lo ) * _sc ) - 6, "0.0", "en-US" ) & "' text-anchor='middle' font-size='11' font-weight='700' fill='#0B1F33'>" & IF ( ISBLANK ( _n ), "–", IF ( _n >= 0, "+", "−" ) & SWITCH ( TRUE (), ISBLANK ( ABS ( _n ) ), "–", ABS ( ABS ( _n ) ) >= 1e9, "R$ " & FORMAT ( ABS ( _n ) / 1e9, "#,0.00", "pt-BR" ) & " bi", ABS ( ABS ( _n ) ) >= 1e6, "R$ " & FORMAT ( ABS ( _n ) / 1e6, "#,0.0", "pt-BR" ) & " mi", ABS ( ABS ( _n ) ) >= 1e3, "R$ " & FORMAT ( ABS ( _n ) / 1e3, "#,0", "pt-BR" ) & " mil", "R$ " & FORMAT ( ABS ( _n ), "#,0", "pt-BR" ) ) ) & "</text>" & "<text x='451.0' y='221' text-anchor='middle' font-size='10' font-weight='700' fill='#16212E'>SKUs novos</text>" & "<text x='451.0' y='234' text-anchor='middle' font-size='9.5' font-weight='500' fill='#6C737D'>" & IF ( ISBLANK ( DIVIDE ( _n, _l0 ) ), "–", FORMAT ( DIVIDE ( _n, _l0 ), "0.0%", "pt-BR" ) ) & "</text>" & "<rect x='525.0' y='" & FORMAT ( ( 206 - ( ( MAX ( _l4, _l5 ) ) - _lo ) * _sc ), "0.0", "en-US" ) & "' width='54' height='" & FORMAT ( MAX ( 1.5, ( 206 - ( ( MIN ( _l4, _l5 ) ) - _lo ) * _sc ) - ( 206 - ( ( MAX ( _l4, _l5 ) ) - _lo ) * _sc ) ), "0.0", "en-US" ) & "' rx='3' fill='" & IF ( _d >= 0, "#14804A", "#E31E24" ) & "'/>" & "<line x1='579.0' x2='626.0' y1='" & FORMAT ( ( 206 - ( ( _l5 ) - _lo ) * _sc ), "0.0", "en-US" ) & "' y2='" & FORMAT ( ( 206 - ( ( _l5 ) - _lo ) * _sc ), "0.0", "en-US" ) & "' stroke='#9AA3AE' stroke-width='1' stroke-dasharray='3 2'/>" & "<text x='552.0' y='" & FORMAT ( ( 206 - ( ( MAX ( _l4, _l5 ) ) - _lo ) * _sc ) - 6, "0.0", "en-US" ) & "' text-anchor='middle' font-size='11' font-weight='700' fill='#0B1F33'>" & IF ( ISBLANK ( _d ), "–", IF ( _d >= 0, "+", "−" ) & SWITCH ( TRUE (), ISBLANK ( ABS ( _d ) ), "–", ABS ( ABS ( _d ) ) >= 1e9, "R$ " & FORMAT ( ABS ( _d ) / 1e9, "#,0.00", "pt-BR" ) & " bi", ABS ( ABS ( _d ) ) >= 1e6, "R$ " & FORMAT ( ABS ( _d ) / 1e6, "#,0.0", "pt-BR" ) & " mi", ABS ( ABS ( _d ) ) >= 1e3, "R$ " & FORMAT ( ABS ( _d ) / 1e3, "#,0", "pt-BR" ) & " mil", "R$ " & FORMAT ( ABS ( _d ), "#,0", "pt-BR" ) ) ) & "</text>" & "<text x='552.0' y='221' text-anchor='middle' font-size='10' font-weight='700' fill='#16212E'>Descontinuados</text>" & "<text x='552.0' y='234' text-anchor='middle' font-size='9.5' font-weight='500' fill='#6C737D'>" & IF ( ISBLANK ( DIVIDE ( _d, _l0 ) ), "–", FORMAT ( DIVIDE ( _d, _l0 ), "0.0%", "pt-BR" ) ) & "</text>" & "<rect x='626.0' y='" & FORMAT ( ( 206 - ( ( _l5 ) - _lo ) * _sc ), "0.0", "en-US" ) & "' width='54' height='" & FORMAT ( MAX ( 1.5, 206 - ( 206 - ( ( _l5 ) - _lo ) * _sc ) ), "0.0", "en-US" ) & "' rx='3' fill='" & "#0B1F33" & "'/>" & "<text x='653.0' y='" & FORMAT ( ( 206 - ( ( _l5 ) - _lo ) * _sc ) - 6, "0.0", "en-US" ) & "' text-anchor='middle' font-size='11' font-weight='700' fill='#0B1F33'>" & SWITCH ( TRUE (), ISBLANK ( _l5 ), "–", ABS ( _l5 ) >= 1e9, "R$ " & FORMAT ( _l5 / 1e9, "#,0.00", "pt-BR" ) & " bi", ABS ( _l5 ) >= 1e6, "R$ " & FORMAT ( _l5 / 1e6, "#,0.0", "pt-BR" ) & " mi", ABS ( _l5 ) >= 1e3, "R$ " & FORMAT ( _l5 / 1e3, "#,0", "pt-BR" ) & " mil", "R$ " & FORMAT ( _l5, "#,0", "pt-BR" ) ) & "</text>" & "<text x='653.0' y='221' text-anchor='middle' font-size='10' font-weight='700' fill='#16212E'>Receita atual</text>" & "<text x='653.0' y='234' text-anchor='middle' font-size='9.5' font-weight='500' fill='#6C737D'>" & IF ( ISBLANK ( DIVIDE ( _l5 - _l0, _l0 ) ), "–", FORMAT ( DIVIDE ( _l5 - _l0, _l0 ), "0.0%", "pt-BR" ) ) & "</text>" & "<text x='684' y='14' text-anchor='end' font-size='9.5' fill='#6C737D'>Eixo truncado para evidenciar os efeitos · percentuais sobre a receita do ano anterior</text></svg>" & "</div>" )
// formato: texto

// Matriz ABC × XYZ dinâmica. ABC pela receita do período sobre todo o portfólio (80% / 95%); XYZ pelo coeficiente de variação da quantidade mensal (X ≤ 0,30; Y ≤ 0,60; Z acima). Mostra só os SKUs do filtro de produto ativo.
[HTML | Heatmap ABC XYZ] =
VAR _lx = [XYZ Limite X]
VAR _ly = [XYZ Limite Y]
VAR _all =
    FILTER (
        ADDCOLUMNS (
            ALL ( dProduto[ProdutoID] ),
            "@r", CALCULATE ( [Receita Líquida], ALLEXCEPT ( dProduto, dProduto[ProdutoID] ) ),
            "@cv", CALCULATE ( [CV Demanda], ALLEXCEPT ( dProduto, dProduto[ProdutoID] ) )
        ),
        [@r] > 0
    )
VAR _tot = SUMX ( _all, [@r] )
VAR _cls =
    ADDCOLUMNS (
        _all,
        "@abc", VAR _r = [@r] VAR _antes = SUMX ( FILTER ( _all, [@r] > _r ), [@r] ) RETURN SWITCH ( TRUE (), _antes < 0.8 * _tot, "A", _antes < 0.95 * _tot, "B", "C" ),
        "@xyz", SWITCH ( TRUE (), ISBLANK ( [@cv] ), "n/d", [@cv] <= _lx, "X", [@cv] <= _ly, "Y", "Z" )
    )
VAR _vis = NATURALINNERJOIN ( _cls, VALUES ( dProduto[ProdutoID] ) )
VAR _totVis = SUMX ( _vis, [@r] )
VAR _nd = COUNTROWS ( FILTER ( _vis, [@xyz] = "n/d" ) ) + 0
VAR _nAX = COUNTROWS ( FILTER ( _vis, [@abc] = "A" && [@xyz] = "X" ) ) + 0
VAR _rAX = DIVIDE ( SUMX ( FILTER ( _vis, [@abc] = "A" && [@xyz] = "X" ), [@r] ), _totVis ) + 0
VAR _nAY = COUNTROWS ( FILTER ( _vis, [@abc] = "A" && [@xyz] = "Y" ) ) + 0
VAR _rAY = DIVIDE ( SUMX ( FILTER ( _vis, [@abc] = "A" && [@xyz] = "Y" ), [@r] ), _totVis ) + 0
VAR _nAZ = COUNTROWS ( FILTER ( _vis, [@abc] = "A" && [@xyz] = "Z" ) ) + 0
VAR _rAZ = DIVIDE ( SUMX ( FILTER ( _vis, [@abc] = "A" && [@xyz] = "Z" ), [@r] ), _totVis ) + 0
VAR _nBX = COUNTROWS ( FILTER ( _vis, [@abc] = "B" && [@xyz] = "X" ) ) + 0
VAR _rBX = DIVIDE ( SUMX ( FILTER ( _vis, [@abc] = "B" && [@xyz] = "X" ), [@r] ), _totVis ) + 0
VAR _nBY = COUNTROWS ( FILTER ( _vis, [@abc] = "B" && [@xyz] = "Y" ) ) + 0
VAR _rBY = DIVIDE ( SUMX ( FILTER ( _vis, [@abc] = "B" && [@xyz] = "Y" ), [@r] ), _totVis ) + 0
VAR _nBZ = COUNTROWS ( FILTER ( _vis, [@abc] = "B" && [@xyz] = "Z" ) ) + 0
VAR _rBZ = DIVIDE ( SUMX ( FILTER ( _vis, [@abc] = "B" && [@xyz] = "Z" ), [@r] ), _totVis ) + 0
VAR _nCX = COUNTROWS ( FILTER ( _vis, [@abc] = "C" && [@xyz] = "X" ) ) + 0
VAR _rCX = DIVIDE ( SUMX ( FILTER ( _vis, [@abc] = "C" && [@xyz] = "X" ), [@r] ), _totVis ) + 0
VAR _nCY = COUNTROWS ( FILTER ( _vis, [@abc] = "C" && [@xyz] = "Y" ) ) + 0
VAR _rCY = DIVIDE ( SUMX ( FILTER ( _vis, [@abc] = "C" && [@xyz] = "Y" ), [@r] ), _totVis ) + 0
VAR _nCZ = COUNTROWS ( FILTER ( _vis, [@abc] = "C" && [@xyz] = "Z" ) ) + 0
VAR _rCZ = DIVIDE ( SUMX ( FILTER ( _vis, [@abc] = "C" && [@xyz] = "Z" ), [@r] ), _totVis ) + 0
VAR _maxR = MAX ( MAX ( MAX ( MAX ( _rAX, _rAY ), MAX ( _rAZ, _rBX ) ), MAX ( MAX ( _rBY, _rBZ ), MAX ( _rCX, _rCY ) ) ), _rCZ )
RETURN [HTML | CSS] & "<div class='tk'>" & "<svg class='tk-sv' viewBox='0 0 420 262' preserveAspectRatio='xMidYMid meet' font-family='Montserrat,Segoe UI,Arial'>" & "<text x='108' y='14' text-anchor='middle' font-size='11' font-weight='800' fill='#0B1F33'>X <tspan font-weight='500' fill='#6C737D'>estável</tspan></text>" & "<text x='230' y='14' text-anchor='middle' font-size='11' font-weight='800' fill='#0B1F33'>Y <tspan font-weight='500' fill='#6C737D'>variável</tspan></text>" & "<text x='352' y='14' text-anchor='middle' font-size='11' font-weight='800' fill='#0B1F33'>Z <tspan font-weight='500' fill='#6C737D'>errática</tspan></text>" & "<text x='24' y='62' text-anchor='middle' font-size='20' font-weight='800' fill='#0B1F33'>A</text>" & "<rect x='50' y='24' width='116' height='64' rx='8' fill='#0B1F33' fill-opacity='" & FORMAT ( 0.06 + 0.94 * DIVIDE ( _rAX, _maxR, 0 ), "0.0", "en-US" ) & "'/>" & "<text x='108' y='54' text-anchor='middle' font-size='19' font-weight='800' fill='" & IF ( DIVIDE ( _rAX, _maxR, 0 ) > 0.45, "#FFFFFF", "#0B1F33" ) & "'>" & FORMAT ( _nAX, "#,0", "pt-BR" ) & "</text>" & "<text x='108' y='72' text-anchor='middle' font-size='10' font-weight='600' fill='" & IF ( DIVIDE ( _rAX, _maxR, 0 ) > 0.45, "#DCE3EA", "#3C4654" ) & "'>" & FORMAT ( _rAX, "0.0%", "pt-BR" ) & " da receita" & "</text>" & "<rect x='172' y='24' width='116' height='64' rx='8' fill='#0B1F33' fill-opacity='" & FORMAT ( 0.06 + 0.94 * DIVIDE ( _rAY, _maxR, 0 ), "0.0", "en-US" ) & "'/>" & "<text x='230' y='54' text-anchor='middle' font-size='19' font-weight='800' fill='" & IF ( DIVIDE ( _rAY, _maxR, 0 ) > 0.45, "#FFFFFF", "#0B1F33" ) & "'>" & FORMAT ( _nAY, "#,0", "pt-BR" ) & "</text>" & "<text x='230' y='72' text-anchor='middle' font-size='10' font-weight='600' fill='" & IF ( DIVIDE ( _rAY, _maxR, 0 ) > 0.45, "#DCE3EA", "#3C4654" ) & "'>" & FORMAT ( _rAY, "0.0%", "pt-BR" ) & " da receita" & "</text>" & "<rect x='294' y='24' width='116' height='64' rx='8' fill='#0B1F33' fill-opacity='" & FORMAT ( 0.06 + 0.94 * DIVIDE ( _rAZ, _maxR, 0 ), "0.0", "en-US" ) & "'/>" & "<text x='352' y='54' text-anchor='middle' font-size='19' font-weight='800' fill='" & IF ( DIVIDE ( _rAZ, _maxR, 0 ) > 0.45, "#FFFFFF", "#0B1F33" ) & "'>" & FORMAT ( _nAZ, "#,0", "pt-BR" ) & "</text>" & "<text x='352' y='72' text-anchor='middle' font-size='10' font-weight='600' fill='" & IF ( DIVIDE ( _rAZ, _maxR, 0 ) > 0.45, "#DCE3EA", "#3C4654" ) & "'>" & FORMAT ( _rAZ, "0.0%", "pt-BR" ) & " da receita" & "</text>" & "<text x='24' y='132' text-anchor='middle' font-size='20' font-weight='800' fill='#0B1F33'>B</text>" & "<rect x='50' y='94' width='116' height='64' rx='8' fill='#0B1F33' fill-opacity='" & FORMAT ( 0.06 + 0.94 * DIVIDE ( _rBX, _maxR, 0 ), "0.0", "en-US" ) & "'/>" & "<text x='108' y='124' text-anchor='middle' font-size='19' font-weight='800' fill='" & IF ( DIVIDE ( _rBX, _maxR, 0 ) > 0.45, "#FFFFFF", "#0B1F33" ) & "'>" & FORMAT ( _nBX, "#,0", "pt-BR" ) & "</text>" & "<text x='108' y='142' text-anchor='middle' font-size='10' font-weight='600' fill='" & IF ( DIVIDE ( _rBX, _maxR, 0 ) > 0.45, "#DCE3EA", "#3C4654" ) & "'>" & FORMAT ( _rBX, "0.0%", "pt-BR" ) & " da receita" & "</text>" & "<rect x='172' y='94' width='116' height='64' rx='8' fill='#0B1F33' fill-opacity='" & FORMAT ( 0.06 + 0.94 * DIVIDE ( _rBY, _maxR, 0 ), "0.0", "en-US" ) & "'/>" & "<text x='230' y='124' text-anchor='middle' font-size='19' font-weight='800' fill='" & IF ( DIVIDE ( _rBY, _maxR, 0 ) > 0.45, "#FFFFFF", "#0B1F33" ) & "'>" & FORMAT ( _nBY, "#,0", "pt-BR" ) & "</text>" & "<text x='230' y='142' text-anchor='middle' font-size='10' font-weight='600' fill='" & IF ( DIVIDE ( _rBY, _maxR, 0 ) > 0.45, "#DCE3EA", "#3C4654" ) & "'>" & FORMAT ( _rBY, "0.0%", "pt-BR" ) & " da receita" & "</text>" & "<rect x='294' y='94' width='116' height='64' rx='8' fill='#0B1F33' fill-opacity='" & FORMAT ( 0.06 + 0.94 * DIVIDE ( _rBZ, _maxR, 0 ), "0.0", "en-US" ) & "'/>" & "<text x='352' y='124' text-anchor='middle' font-size='19' font-weight='800' fill='" & IF ( DIVIDE ( _rBZ, _maxR, 0 ) > 0.45, "#FFFFFF", "#0B1F33" ) & "'>" & FORMAT ( _nBZ, "#,0", "pt-BR" ) & "</text>" & "<text x='352' y='142' text-anchor='middle' font-size='10' font-weight='600' fill='" & IF ( DIVIDE ( _rBZ, _maxR, 0 ) > 0.45, "#DCE3EA", "#3C4654" ) & "'>" & FORMAT ( _rBZ, "0.0%", "pt-BR" ) & " da receita" & "</text>" & "<text x='24' y='202' text-anchor='middle' font-size='20' font-weight='800' fill='#0B1F33'>C</text>" & "<rect x='50' y='164' width='116' height='64' rx='8' fill='#0B1F33' fill-opacity='" & FORMAT ( 0.06 + 0.94 * DIVIDE ( _rCX, _maxR, 0 ), "0.0", "en-US" ) & "'/>" & "<text x='108' y='194' text-anchor='middle' font-size='19' font-weight='800' fill='" & IF ( DIVIDE ( _rCX, _maxR, 0 ) > 0.45, "#FFFFFF", "#0B1F33" ) & "'>" & FORMAT ( _nCX, "#,0", "pt-BR" ) & "</text>" & "<text x='108' y='212' text-anchor='middle' font-size='10' font-weight='600' fill='" & IF ( DIVIDE ( _rCX, _maxR, 0 ) > 0.45, "#DCE3EA", "#3C4654" ) & "'>" & FORMAT ( _rCX, "0.0%", "pt-BR" ) & " da receita" & "</text>" & "<rect x='172' y='164' width='116' height='64' rx='8' fill='#0B1F33' fill-opacity='" & FORMAT ( 0.06 + 0.94 * DIVIDE ( _rCY, _maxR, 0 ), "0.0", "en-US" ) & "'/>" & "<text x='230' y='194' text-anchor='middle' font-size='19' font-weight='800' fill='" & IF ( DIVIDE ( _rCY, _maxR, 0 ) > 0.45, "#FFFFFF", "#0B1F33" ) & "'>" & FORMAT ( _nCY, "#,0", "pt-BR" ) & "</text>" & "<text x='230' y='212' text-anchor='middle' font-size='10' font-weight='600' fill='" & IF ( DIVIDE ( _rCY, _maxR, 0 ) > 0.45, "#DCE3EA", "#3C4654" ) & "'>" & FORMAT ( _rCY, "0.0%", "pt-BR" ) & " da receita" & "</text>" & "<rect x='294' y='164' width='116' height='64' rx='8' fill='#0B1F33' fill-opacity='" & FORMAT ( 0.06 + 0.94 * DIVIDE ( _rCZ, _maxR, 0 ), "0.0", "en-US" ) & "'/>" & "<text x='352' y='194' text-anchor='middle' font-size='19' font-weight='800' fill='" & IF ( DIVIDE ( _rCZ, _maxR, 0 ) > 0.45, "#FFFFFF", "#0B1F33" ) & "'>" & FORMAT ( _nCZ, "#,0", "pt-BR" ) & "</text>" & "<text x='352' y='212' text-anchor='middle' font-size='10' font-weight='600' fill='" & IF ( DIVIDE ( _rCZ, _maxR, 0 ) > 0.45, "#DCE3EA", "#3C4654" ) & "'>" & FORMAT ( _rCZ, "0.0%", "pt-BR" ) & " da receita" & "</text>" & "<text x='210' y='250' text-anchor='middle' font-size='9.5' fill='#6C737D'>" & "Número de SKUs por célula · intensidade pela receita · " & FORMAT ( _nd, "#,0", "pt-BR" ) & " SKUs sem amostra de 6 meses" & "</text></svg>" & "</div>"
// formato: texto

// Pareto do valor em excesso (acima de 120 dias de cobertura) por categoria: 10 maiores + Outros, com percentual acumulado. A soma das barras é igual ao excesso total do contexto.
[HTML | Pareto Excesso] =
VAR _s = [Data Último Snapshot]
VAR _lim = [Cobertura Excesso Dias]
VAR _t =
    ADDCOLUMNS (
        SUMMARIZE ( CALCULATETABLE ( fEstoque, REMOVEFILTERS ( dCalendario ), fEstoque[Data] = _s ), dProduto[Categoria], dProduto[ProdutoID], dFilial[FilialID] ),
        "@q", CALCULATE ( SUM ( fEstoque[EstoqueFinal] ), REMOVEFILTERS ( dCalendario ), fEstoque[Data] = _s ),
        "@v", CALCULATE ( SUM ( fEstoque[ValorEstoque] ), REMOVEFILTERS ( dCalendario ), fEstoque[Data] = _s ),
        "@d", DIVIDE ( CALCULATE ( SUM ( fVendas[Quantidade] ), REMOVEFILTERS ( dCalendario ), fVendas[DataVenda] > _s - 90, fVendas[DataVenda] <= _s ), 90 )
    )
VAR _t2 = ADDCOLUMNS ( _t, "@x", VAR _exc = [@q] - [@d] * _lim RETURN IF ( [@q] > 0 && _exc > 0, DIVIDE ( _exc, [@q] ) * [@v], 0 ) )
VAR _cat = FILTER ( GROUPBY ( _t2, dProduto[Categoria], "@e", SUMX ( CURRENTGROUP (), [@x] ) ), [@e] > 0 )
VAR _tot = SUMX ( _cat, [@e] )
VAR _top = TOPN ( 10, _cat, [@e], DESC, dProduto[Categoria], ASC )
VAR _topK =
    ADDCOLUMNS (
        _top,
        "@k", VAR _e = [@e] VAR _id = dProduto[Categoria] RETURN COUNTROWS ( FILTER ( _top, [@e] > _e || ( [@e] = _e && dProduto[Categoria] < _id ) ) ) + 1,
        "@lb", SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( dProduto[Categoria], "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" )
    )
VAR _sumTop = SUMX ( _top, [@e] )
VAR _b0 = FILTER ( UNION ( SELECTCOLUMNS ( _topK, "@k", [@k], "@e", [@e], "@lb", [@lb] ), ROW ( "@k", 11, "@e", _tot - _sumTop, "@lb", "Outros" ) ), [@e] > 0.5 )
VAR _bars = ADDCOLUMNS ( _b0, "@cum", VAR _k = [@k] RETURN DIVIDE ( SUMX ( FILTER ( _b0, [@k] <= _k ), [@e] ), _tot ) )
VAR _maxE = MAXX ( _bars, [@e] )
VAR _step = DIVIDE ( 492, COUNTROWS ( _bars ) )
RETURN
    IF ( _tot > 0, [HTML | CSS] & "<div class='tk'>" & "<svg class='tk-sv' viewBox='0 0 520 262' preserveAspectRatio='xMidYMid meet' font-family='Montserrat,Segoe UI,Arial'><line x1='10' y1='200' x2='510' y2='200' stroke='#C5CBD3'/>" & CONCATENATEX ( _bars,
        VAR _x = 14 + ( [@k] - 1 ) * _step + _step * 0.15
        VAR _h = DIVIDE ( [@e], _maxE ) * 150
        RETURN "<rect x='" & FORMAT ( _x, "0.0", "en-US" ) & "' y='" & FORMAT ( 200 - _h, "0.0", "en-US" ) & "' width='" & FORMAT ( _step * 0.7, "0.0", "en-US" ) & "' height='" & FORMAT ( MAX ( 1, _h ), "0.0", "en-US" ) & "' rx='3' fill='" & IF ( [@lb] = "Outros", "#9AA3AE", "#0B1F33" ) & "'/>"
            & "<text x='" & FORMAT ( _x + _step * 0.35, "0.0", "en-US" ) & "' y='" & FORMAT ( 200 - _h - 5, "0.0", "en-US" ) & "' text-anchor='middle' font-size='10' font-weight='700' fill='#0B1F33'>" & FORMAT ( [@e] / 1e6, "#,0.0", "pt-BR" ) & "</text>"
            & "<text x='" & FORMAT ( _x + _step * 0.35, "0.0", "en-US" ) & "' y='214' text-anchor='middle' font-size='9.5' font-weight='600' fill='#16212E'>" & [@lb] & "</text>",
        "", [@k], ASC ) & "<polyline fill='none' stroke='#E31E24' stroke-width='2' points='" & CONCATENATEX ( _bars, FORMAT ( 14 + ( [@k] - 0.5 ) * _step, "0.0", "en-US" ) & "," & FORMAT ( 200 - [@cum] * 150, "0.0", "en-US" ), " ", [@k], ASC ) & "'/>" & CONCATENATEX ( _bars, "<circle cx='" & FORMAT ( 14 + ( [@k] - 0.5 ) * _step, "0.0", "en-US" ) & "' cy='" & FORMAT ( 200 - [@cum] * 150, "0.0", "en-US" ) & "' r='3' fill='#E31E24'/><text x='" & FORMAT ( 14 + ( [@k] - 0.5 ) * _step, "0.0", "en-US" ) & "' y='" & FORMAT ( 200 - [@cum] * 150 - 7, "0.0", "en-US" ) & "' text-anchor='middle' font-size='9' font-weight='700' fill='#C8161C'>" & FORMAT ( [@cum], "0%", "pt-BR" ) & "</text>", "", [@k], ASC ) & "<text x='510' y='14' text-anchor='end' font-size='9.5' fill='#6C737D'>" & "Barras em R$ milhões · linha: % acumulado · maior categoria = " & FORMAT ( DIVIDE ( _maxE, _tot ), "0%", "pt-BR" ) & " do excesso" & "</text>" & "<text x='260' y='238' text-anchor='middle' font-size='9.5' fill='#6C737D'>" & "Excesso total de " & SWITCH ( TRUE (), ISBLANK ( _tot ), "–", ABS ( _tot ) >= 1e9, "R$ " & FORMAT ( _tot / 1e9, "#,0.00", "pt-BR" ) & " bi", ABS ( _tot ) >= 1e6, "R$ " & FORMAT ( _tot / 1e6, "#,0.0", "pt-BR" ) & " mi", ABS ( _tot ) >= 1e3, "R$ " & FORMAT ( _tot / 1e3, "#,0", "pt-BR" ) & " mil", "R$ " & FORMAT ( _tot, "#,0", "pt-BR" ) ) & " acima de " & _lim & " dias de cobertura · snapshot de " & FORMAT ( _s, "dd/MM/yyyy" ) & "</text></svg>" & "</div>",
        [HTML | CSS] & "<div class='tk' style='display:flex;align-items:center;justify-content:center;color:#6C737D;font-size:12px'>Sem excesso de estoque no contexto selecionado</div>" )
// formato: texto

// Tooltip de cliente: receita, margem, share estimado, frequência, mix, recência e tendência mensal.
[HTML | Tooltip Cliente] = [HTML | CSS] & "<div class='tk tk-tt'><div class='tk-tn'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SELECTEDVALUE ( dCliente[NomeFantasia], "Vários clientes" ), "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ) & "</div><div class='tk-ts'>" & SELECTEDVALUE ( dCliente[SegmentoRFV], "Segmentos diversos" ) & " · " & SELECTEDVALUE ( dCliente[TipoCliente], "tipos diversos" ) & " · " & SELECTEDVALUE ( dCliente[Cidade], "várias cidades" ) & "</div><div class='tk-tg'>" & "<div><span>Receita</span><b>" & SWITCH ( TRUE (), ISBLANK ( [Receita Líquida] ), "–", ABS ( [Receita Líquida] ) >= 1e9, "R$ " & FORMAT ( [Receita Líquida] / 1e9, "#,0.00", "pt-BR" ) & " bi", ABS ( [Receita Líquida] ) >= 1e6, "R$ " & FORMAT ( [Receita Líquida] / 1e6, "#,0.0", "pt-BR" ) & " mi", ABS ( [Receita Líquida] ) >= 1e3, "R$ " & FORMAT ( [Receita Líquida] / 1e3, "#,0", "pt-BR" ) & " mil", "R$ " & FORMAT ( [Receita Líquida], "#,0", "pt-BR" ) ) & "</b></div>" & "<div><span>MC %</span><b>" & IF ( ISBLANK ( [MC %] ), "–", FORMAT ( [MC %], "0.0%", "pt-BR" ) ) & "</b></div>" & "<div><span>Share est.</span><b>" & IF ( ISBLANK ( [Share Estimado %] ), "–", FORMAT ( [Share Estimado %], "0%", "pt-BR" ) ) & "</b></div>" & "<div><span>Frequência/mês</span><b>" & IF ( ISBLANK ( [Frequência Mensal] ), "–", FORMAT ( [Frequência Mensal], "0.0", "pt-BR" ) ) & "</b></div>" & "<div><span>Mix de SKUs</span><b>" & IF ( ISBLANK ( [Mix Médio SKUs] ), "–", FORMAT ( [Mix Médio SKUs], "0", "pt-BR" ) ) & "</b></div>" & "<div><span>Recência</span><b>" & IF ( ISBLANK ( [Recência Dias] ), "–", [Recência Dias] & " d" ) & "</b></div>" & "</div>" & SUBSTITUTE ( SUBSTITUTE ( [SVG | Spark Receita], "tk-sp", "tk-tp" ), "#0B1F33", "#FFFFFF" ) & "<div class='tk-tf'>" & "Receita mensal · gap estimado de " & SWITCH ( TRUE (), ISBLANK ( [Gap Potencial Estimado] ), "–", ABS ( [Gap Potencial Estimado] ) >= 1e9, "R$ " & FORMAT ( [Gap Potencial Estimado] / 1e9, "#,0.00", "pt-BR" ) & " bi", ABS ( [Gap Potencial Estimado] ) >= 1e6, "R$ " & FORMAT ( [Gap Potencial Estimado] / 1e6, "#,0.0", "pt-BR" ) & " mi", ABS ( [Gap Potencial Estimado] ) >= 1e3, "R$ " & FORMAT ( [Gap Potencial Estimado] / 1e3, "#,0", "pt-BR" ) & " mil", "R$ " & FORMAT ( [Gap Potencial Estimado], "#,0", "pt-BR" ) ) & " ao mês" & "</div></div>"
// formato: texto

// Tooltip de produto: saldo, cobertura, status, venda média diária, lead time, margem e demanda mensal.
[HTML | Tooltip Produto] = [HTML | CSS] & "<div class='tk tk-tt'><div class='tk-tn'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SELECTEDVALUE ( dProduto[Produto], "Vários produtos" ), "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ) & "</div><div class='tk-ts'>" & SELECTEDVALUE ( dProduto[SKU], "SKUs diversos" ) & " · " & SELECTEDVALUE ( dProduto[Categoria], "categorias diversas" ) & " · ABC " & COALESCE ( [Classe ABC], "–" ) & " / XYZ " & COALESCE ( [Classe XYZ], "–" ) & "</div><div class='tk-tg'>" & "<div><span>Saldo</span><b>" & IF ( ISBLANK ( [Estoque Qtd] ), "–", FORMAT ( [Estoque Qtd], "#,0", "pt-BR" ) ) & "</b></div>" & "<div><span>Cobertura</span><b>" & IF ( ISBLANK ( [Cobertura Dias] ), "–", FORMAT ( [Cobertura Dias], "#,0", "pt-BR" ) & " d" ) & "</b></div>" & "<div><span>Status</span><b>" & COALESCE ( [Status Estoque], "–" ) & "</b></div>" & "<div><span>Venda/dia</span><b>" & IF ( ISBLANK ( [Venda Média Diária] ), "–", FORMAT ( [Venda Média Diária], "0.0", "pt-BR" ) ) & "</b></div>" & "<div><span>Lead time</span><b>" & IF ( HASONEVALUE ( dProduto[ProdutoID] ), MAX ( dProduto[LeadTimePadraoDias] ) & " d", "–" ) & "</b></div>" & "<div><span>MC %</span><b>" & IF ( ISBLANK ( [MC %] ), "–", FORMAT ( [MC %], "0.0%", "pt-BR" ) ) & "</b></div>" & "</div>" & SUBSTITUTE ( SUBSTITUTE ( [SVG | Spark Quantidade], "tk-sp", "tk-tp" ), "#0B1F33", "#FFFFFF" ) & "<div class='tk-tf'>" & "Unidades vendidas por mês · snapshot de " & FORMAT ( [Data Último Snapshot], "dd/MM/yyyy" ) & "</div></div>"
// formato: texto

// Tooltip de fornecedor: OTIF, pontualidade, completude, lead time, atraso e score.
[HTML | Tooltip Fornecedor] = [HTML | CSS] & "<div class='tk tk-tt'><div class='tk-tn'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SELECTEDVALUE ( dFornecedor[Fornecedor], "Vários fornecedores" ), "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ) & "</div><div class='tk-ts'>" & SELECTEDVALUE ( dFornecedor[CategoriaPrincipal], "categorias diversas" ) & " · " & SELECTEDVALUE ( dFornecedor[UF], "várias UFs" ) & " · score " & FORMAT ( [Supplier Score], "0", "pt-BR" ) & "</div><div class='tk-tg'>" & "<div><span>OTIF</span><b>" & IF ( ISBLANK ( [OTIF %] ), "–", FORMAT ( [OTIF %], "0%", "pt-BR" ) ) & "</b></div>" & "<div><span>No prazo</span><b>" & IF ( ISBLANK ( [On Time %] ), "–", FORMAT ( [On Time %], "0%", "pt-BR" ) ) & "</b></div>" & "<div><span>Completo</span><b>" & IF ( ISBLANK ( [In Full %] ), "–", FORMAT ( [In Full %], "0%", "pt-BR" ) ) & "</b></div>" & "<div><span>Lead time</span><b>" & FORMAT ( [Lead Time Real], "0.0", "pt-BR" ) & " d" & "</b></div>" & "<div><span>Atraso médio</span><b>" & FORMAT ( [Atraso Médio], "0.0", "pt-BR" ) & " d" & "</b></div>" & "<div><span>Entregas</span><b>" & IF ( ISBLANK ( [Compras Entregues] ), "–", FORMAT ( [Compras Entregues], "#,0", "pt-BR" ) ) & "</b></div>" & "</div>" & SUBSTITUTE ( SUBSTITUTE ( [SVG | Spark OTIF], "tk-sp", "tk-tp" ), "#0B1F33", "#FFFFFF" ) & "<div class='tk-tf'>" & "OTIF mensal · score = 40% OTIF + 25% preço + 20% qualidade + 15% lead time" & "</div></div>"
// formato: texto

// Tooltip do ranking: vendedor, filial, categoria, canal ou segmento, com receita, meta (quando aplicável), variação anual, margem, clientes e ticket.
[HTML | Tooltip Vendedor] = [HTML | CSS] & "<div class='tk tk-tt'><div class='tk-tn'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( COALESCE ( SELECTEDVALUE ( dVendedor[Vendedor] ), SELECTEDVALUE ( dProduto[Categoria] ), SELECTEDVALUE ( fVendas[CanalVenda] ), SELECTEDVALUE ( dCliente[Segmento] ), SELECTEDVALUE ( dFilial[Filial] ), "Equipe comercial" ), "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ) & "</div><div class='tk-ts'>" & IF ( HASONEVALUE ( dVendedor[Vendedor] ), SELECTEDVALUE ( dVendedor[PerfilPerformance] ) & " · ", "" ) & "filial " & SELECTEDVALUE ( dFilial[Filial], "todas" ) & " · " & FORMAT ( [Período Início], "dd/MM/yy" ) & " a " & FORMAT ( [Período Fim], "dd/MM/yy" ) & "</div><div class='tk-tg'>" & "<div><span>Receita</span><b>" & SWITCH ( TRUE (), ISBLANK ( [Receita Líquida] ), "–", ABS ( [Receita Líquida] ) >= 1e9, "R$ " & FORMAT ( [Receita Líquida] / 1e9, "#,0.00", "pt-BR" ) & " bi", ABS ( [Receita Líquida] ) >= 1e6, "R$ " & FORMAT ( [Receita Líquida] / 1e6, "#,0.0", "pt-BR" ) & " mi", ABS ( [Receita Líquida] ) >= 1e3, "R$ " & FORMAT ( [Receita Líquida] / 1e3, "#,0", "pt-BR" ) & " mil", "R$ " & FORMAT ( [Receita Líquida], "#,0", "pt-BR" ) ) & "</b></div>" & "<div><span>Meta</span><b>" & IF ( ISFILTERED ( dProduto[Categoria] ) || ISFILTERED ( fVendas[CanalVenda] ) || ISFILTERED ( dCliente[Segmento] ), "n/a", IF ( ISBLANK ( [Atingimento Meta %] ), "–", FORMAT ( [Atingimento Meta %], "0.0%", "pt-BR" ) ) ) & "</b></div>" & "<div><span>vs AA</span><b>" & IF ( ISBLANK ( [Receita YoY %] ), "–", FORMAT ( [Receita YoY %], "+0.0%;-0.0%", "pt-BR" ) ) & "</b></div>" & "<div><span>MC %</span><b>" & IF ( ISBLANK ( [MC %] ), "–", FORMAT ( [MC %], "0.0%", "pt-BR" ) ) & "</b></div>" & "<div><span>Clientes</span><b>" & IF ( ISBLANK ( [Clientes Ativos] ), "–", FORMAT ( [Clientes Ativos], "#,0", "pt-BR" ) ) & "</b></div>" & "<div><span>Ticket</span><b>" & "R$ " & FORMAT ( [Ticket Médio], "#,0", "pt-BR" ) & "</b></div>" & "</div>" & SUBSTITUTE ( SUBSTITUTE ( [SVG | Spark Receita], "tk-sp", "tk-tp" ), "#0B1F33", "#FFFFFF" ) & "<div class='tk-tf'>" & "Receita mensal · meta só existe por vendedor e filial" & "</div></div>"
// formato: texto

// Linha dinâmica da página inicial: data de corte e dimensão da base.
[HTML | Landing Info] =
"<div style='font-family:Montserrat,Segoe UI,Arial,sans-serif;color:#C9D1DB;font-size:12.5px;font-weight:500;white-space:nowrap'>Dados realizados até <b style='color:#fff'>" & FORMAT ( [Data Corte], "dd/MM/yyyy" ) & "</b> · "
    & FORMAT ( COUNTROWS ( dFilial ), "0" ) & " filiais · " & FORMAT ( COUNTROWS ( dCliente ), "#,0", "pt-BR" ) & " clientes · " & FORMAT ( COUNTROWS ( dProduto ), "#,0", "pt-BR" ) & " SKUs · base sintética de portfólio</div>"
// formato: texto

// ======================================================================
// 11 UX
// ======================================================================

// Série realizada do gráfico principal conforme a métrica escolhida (faturamento, margem de contribuição ou volume).
[Hero Atual] = SWITCH ( SELECTEDVALUE ( pMetrica[MetricaID], 1 ), 1, [Receita Líquida], 2, [Margem Contribuição], 3, [Quantidade] )
// formato: SWITCH ( SELECTEDVALUE ( pMetrica[MetricaID], 1 ), 3, "#,0", """R$"" #,0" )

// Mesmo intervalo do ano anterior, truncado no corte.
[Hero Ano Anterior] = SWITCH ( SELECTEDVALUE ( pMetrica[MetricaID], 1 ), 1, [Receita Líquida LY], 2, [Margem Contribuição LY], 3, [Quantidade LY] )
// formato: SWITCH ( SELECTEDVALUE ( pMetrica[MetricaID], 1 ), 3, "#,0", """R$"" #,0" )

// Meta integral do mês. Disponível só para faturamento: a base não tem meta de margem de contribuição nem de volume.
[Hero Meta] = IF ( SELECTEDVALUE ( pMetrica[MetricaID], 1 ) = 1, [Meta Faturamento Mês Cheio] )
// formato: SWITCH ( SELECTEDVALUE ( pMetrica[MetricaID], 1 ), 3, "#,0", """R$"" #,0" )

// SIMULAÇÃO. Liga o último mês fechado à projeção de fechamento do mês do corte. Só para faturamento e em eixo mensal.
[Hero Projeção] =
VAR _c = [Data Corte]
VAR _mc = YEAR ( _c ) * 12 + MONTH ( _c )
VAR _m = MAX ( dCalendario[MesIndice] )
VAR _umMes = HASONEVALUE ( dCalendario[AnoMes] )
RETURN
    IF ( SELECTEDVALUE ( pMetrica[MetricaID], 1 ) = 1 && _umMes && _c < EOMONTH ( _c, 0 ),
        SWITCH ( _m, _mc, [Projeção Fechamento Mês], _mc - 1, [Receita Líquida] ) )
// formato: SWITCH ( SELECTEDVALUE ( pMetrica[MetricaID], 1 ), 3, "#,0", """R$"" #,0" )

// Marca o mês fechado de maior valor entre os meses exibidos.
[Hero Máximo] =
VAR _c = [Data Corte]
VAR _mc = YEAR ( _c ) * 12 + MONTH ( _c )
VAR _fechado = _c >= EOMONTH ( _c, 0 )
VAR _atual = [Hero Atual]
VAR _m = MAX ( dCalendario[MesIndice] )
VAR _t =
    FILTER (
        ADDCOLUMNS ( FILTER ( CALCULATETABLE ( VALUES ( dCalendario[MesIndice] ), ALLSELECTED ( dCalendario ) ), dCalendario[MesIndice] < _mc || ( dCalendario[MesIndice] = _mc && _fechado ) ), "@v", CALCULATE ( [Hero Atual], ALLEXCEPT ( dCalendario, dCalendario[MesIndice] ) ) ),
        NOT ISBLANK ( [@v] )
    )
VAR _max = MAXX ( _t, [@v] )
RETURN IF ( HASONEVALUE ( dCalendario[AnoMes] ) && _m <= _mc && ( _m < _mc || _fechado ) && _atual = _max, _atual )
// formato: SWITCH ( SELECTEDVALUE ( pMetrica[MetricaID], 1 ), 3, "#,0", """R$"" #,0" )

// Marca o mês fechado de menor valor entre os meses exibidos.
[Hero Mínimo] =
VAR _c = [Data Corte]
VAR _mc = YEAR ( _c ) * 12 + MONTH ( _c )
VAR _fechado = _c >= EOMONTH ( _c, 0 )
VAR _atual = [Hero Atual]
VAR _m = MAX ( dCalendario[MesIndice] )
VAR _t =
    FILTER (
        ADDCOLUMNS ( FILTER ( CALCULATETABLE ( VALUES ( dCalendario[MesIndice] ), ALLSELECTED ( dCalendario ) ), dCalendario[MesIndice] < _mc || ( dCalendario[MesIndice] = _mc && _fechado ) ), "@v", CALCULATE ( [Hero Atual], ALLEXCEPT ( dCalendario, dCalendario[MesIndice] ) ) ),
        NOT ISBLANK ( [@v] )
    )
VAR _min = MINX ( _t, [@v] )
RETURN IF ( HASONEVALUE ( dCalendario[AnoMes] ) && ( _m < _mc || _fechado ) && _atual = _min, _atual )
// formato: SWITCH ( SELECTEDVALUE ( pMetrica[MetricaID], 1 ), 3, "#,0", """R$"" #,0" )

// Marca meses fechados cuja queda contra o mês anterior é igual ou maior que o limiar escolhido (padrão 10%).
[Hero Queda Crítica] =
VAR _c = [Data Corte]
VAR _mc = YEAR ( _c ) * 12 + MONTH ( _c )
VAR _fechado = _c >= EOMONTH ( _c, 0 )
VAR _m = MAX ( dCalendario[MesIndice] )
VAR _atual = [Hero Atual]
VAR _ant = CALCULATE ( [Hero Atual], DATEADD ( dCalendario[Data], -1, MONTH ) )
VAR _var = DIVIDE ( _atual - _ant, _ant )
RETURN IF ( HASONEVALUE ( dCalendario[AnoMes] ) && ( _m < _mc || _fechado ) && NOT ISBLANK ( _ant ) && _var <= - [Limite Queda], _atual )
// formato: SWITCH ( SELECTEDVALUE ( pMetrica[MetricaID], 1 ), 3, "#,0", """R$"" #,0" )

// Variação contra o mesmo intervalo do mês anterior, para o tooltip do gráfico principal.
[Hero Variação Mês %] =
VAR _atual = [Hero Atual]
VAR _ant = CALCULATE ( [Hero Atual], DATEADD ( FILTER ( VALUES ( dCalendario[Data] ), dCalendario[Data] <= [Data Corte] ), -1, MONTH ) )
RETURN IF ( NOT ISBLANK ( _atual ) && NOT ISBLANK ( _ant ), DIVIDE ( _atual - _ant, _ant ) )
// formato: 0.0%;-0.0%;0.0%

[Hero Variação AA %] =
VAR _a = [Hero Atual]
VAR _b = [Hero Ano Anterior]
RETURN IF ( NOT ISBLANK ( _a ) && NOT ISBLANK ( _b ), DIVIDE ( _a - _b, _b ) )
// formato: 0.0%;-0.0%;0.0%

// Cor de barra: vermelho quando a receita cai contra o ano anterior, azul-marinho quando cresce, cinza sem base de comparação.
[UX | Cor Crescimento] =
VAR _y = [Receita YoY %]
RETURN SWITCH ( TRUE (), ISBLANK ( _y ), "#6C737D", _y < 0, "#E31E24", "#0B1F33" )
// formato: texto · oculta

// Cor por variação de MC %: vermelho ≤ −3 p.p., âmbar abaixo de zero, verde no positivo.
[UX | Cor Margem] =
VAR _pp = [MC Variação pp]
RETURN SWITCH ( TRUE (), ISBLANK ( _pp ), "#6C737D", _pp <= -3, "#E31E24", _pp < 0, "#E8A317", "#14804A" )
// formato: texto · oculta

// Cor da fonte do status de estoque.
[UX | Cor Status Estoque] = SWITCH ( [Status Estoque], "Ruptura", "#E31E24", "Crítico", "#C8161C", "Repor", "#B7791F", "Parado", "#6C737D", "Excesso", "#6C737D", "#14804A" )
// formato: texto · oculta

[UX | Cor Atingimento] =
VAR _a = [Atingimento Meta %]
RETURN SWITCH ( TRUE (), ISBLANK ( _a ), "#6C737D", _a >= 1, "#14804A", _a >= 0.95, "#B7791F", "#C8161C" )
// formato: texto · oculta

// Rótulo com valor e variação contra o ano anterior.
[UX | Rótulo Receita] =
VAR _v = [Receita Líquida]
VAR _p = [Receita YoY %]
RETURN IF ( NOT ISBLANK ( _v ), SWITCH ( TRUE (), ISBLANK ( _v ), "–", ABS ( _v ) >= 1e9, "R$ " & FORMAT ( _v / 1e9, "#,0.00", "pt-BR" ) & " bi", ABS ( _v ) >= 1e6, "R$ " & FORMAT ( _v / 1e6, "#,0.0", "pt-BR" ) & " mi", ABS ( _v ) >= 1e3, "R$ " & FORMAT ( _v / 1e3, "#,0", "pt-BR" ) & " mil", "R$ " & FORMAT ( _v, "#,0", "pt-BR" ) ) & " | " & IF ( ISBLANK ( _p ), "sem comparação", IF ( _p >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( _p ), "0.0%", "pt-BR" ) & " vs AA" ) )
// formato: texto

// Título dinâmico do gráfico principal.
[UX | Título Tendência] =
VAR _n = SWITCH ( SELECTEDVALUE ( pMetrica[MetricaID], 1 ), 1, "Faturamento líquido", 2, "Margem de contribuição", 3, "Volume em unidades" )
VAR _y = [Hero Variação AA %]
RETURN _n & IF ( ISBLANK ( _y ), ": evolução mensal", IF ( _y >= 0, " cresce ", " recua " ) & FORMAT ( ABS ( _y ), "0.0%", "pt-BR" ) & " contra o mesmo intervalo do ano anterior" )
// formato: texto
