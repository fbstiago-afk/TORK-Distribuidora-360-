// formato: texto · categoria de dados: ImageUrl

// Bullet de atingimento da meta proporcional: barra até 130%, marca vermelha em 100%. Verde ao atingir, âmbar de 95% a 100%, vermelho abaixo.
[IMG | Bullet Meta] =
VAR _v = [Atingimento Meta %]
VAR _max = 1.3
VAR _w = FORMAT ( MAX ( 0, MIN ( 1, DIVIDE ( _v, _max ) ) ) * 96, "0.0", "en-US" )
VAR _col = SWITCH ( TRUE (), _v >= 1, "rgb(20,128,74)", _v >= 0.95, "rgb(232,163,23)", "rgb(200,22,28)" )
VAR _lb = FORMAT ( _v, "0%", "pt-BR" )
VAR _tk = FORMAT ( MIN ( 1, DIVIDE ( 1, _max ) ) * 96 - 1, "0.0", "en-US" )
RETURN IF ( NOT ISBLANK ( _v ), "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='150' height='22' viewBox='0 0 150 22'><rect x='0' y='7' width='96' height='8' rx='4' fill='rgb(218,223,229)'/><rect x='0' y='7' width='" & _w & "' height='8' rx='4' fill='" & _col & "'/>" & "<rect x='" & _tk & "' y='3' width='2' height='16' fill='rgb(227,30,36)'/>" & "<text x='102' y='15.5' font-family='Segoe UI,Arial' font-size='11.5' font-weight='600' fill='rgb(22,33,46)'>" & _lb & "</text></svg>" )
// formato: texto · categoria de dados: ImageUrl

// Barra da margem de contribuição % (escala até 30%). Vermelha quando abaixo da MC % do mesmo intervalo do ano anterior.
[IMG | Barra MC %] =
VAR _v = [MC %]
VAR _max = 0.30
VAR _w = FORMAT ( MAX ( 0, MIN ( 1, DIVIDE ( _v, _max ) ) ) * 96, "0.0", "en-US" )
VAR _col = IF ( NOT ISBLANK ( [MC % LY] ) && _v < [MC % LY], "rgb(200,22,28)", "rgb(11,31,51)" )
VAR _lb = FORMAT ( _v, "0.0%", "pt-BR" )
RETURN IF ( NOT ISBLANK ( _v ), "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='150' height='22' viewBox='0 0 150 22'><rect x='0' y='7' width='96' height='8' rx='4' fill='rgb(218,223,229)'/><rect x='0' y='7' width='" & _w & "' height='8' rx='4' fill='" & _col & "'/>" & "<text x='102' y='15.5' font-family='Segoe UI,Arial' font-size='11.5' font-weight='600' fill='rgb(22,33,46)'>" & _lb & "</text></svg>" )
// formato: texto · categoria de dados: ImageUrl

// Barra do share of wallet estimado (escala até 100%). Valor acima de 100% indica potencial subestimado.
[IMG | Barra Share] =
VAR _v = [Share Estimado %]
VAR _max = 1
VAR _w = FORMAT ( MAX ( 0, MIN ( 1, DIVIDE ( _v, _max ) ) ) * 96, "0.0", "en-US" )
VAR _col = IF ( _v > 1, "rgb(108,115,125)", "rgb(11,31,51)" )
VAR _lb = FORMAT ( _v, "0%", "pt-BR" )
RETURN IF ( NOT ISBLANK ( _v ), "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='150' height='22' viewBox='0 0 150 22'><rect x='0' y='7' width='96' height='8' rx='4' fill='rgb(218,223,229)'/><rect x='0' y='7' width='" & _w & "' height='8' rx='4' fill='" & _col & "'/>" & "<text x='102' y='15.5' font-family='Segoe UI,Arial' font-size='11.5' font-weight='600' fill='rgb(22,33,46)'>" & _lb & "</text></svg>" )
// formato: texto · categoria de dados: ImageUrl

// Barra de cobertura em dias (escala até 120). Marca vermelha no lead time padrão do fornecedor. Vermelha quando a cobertura é menor que o lead time.
[IMG | Barra Cobertura] =
VAR _v = [Cobertura Dias]
VAR _max = 120
VAR _w = FORMAT ( MAX ( 0, MIN ( 1, DIVIDE ( _v, _max ) ) ) * 96, "0.0", "en-US" )
VAR _col = IF ( _v < MAX ( dProduto[LeadTimePadraoDias] ), "rgb(200,22,28)", IF ( _v > 120, "rgb(108,115,125)", "rgb(11,31,51)" ) )
VAR _lb = FORMAT ( _v, "#,0", "pt-BR" ) & " d"
VAR _tk = FORMAT ( MIN ( 1, DIVIDE ( MAX ( dProduto[LeadTimePadraoDias] ), _max ) ) * 96 - 1, "0.0", "en-US" )
RETURN IF ( NOT ISBLANK ( _v ), "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='150' height='22' viewBox='0 0 150 22'><rect x='0' y='7' width='96' height='8' rx='4' fill='rgb(218,223,229)'/><rect x='0' y='7' width='" & _w & "' height='8' rx='4' fill='" & _col & "'/>" & "<rect x='" & _tk & "' y='3' width='2' height='16' fill='rgb(227,30,36)'/>" & "<text x='102' y='15.5' font-family='Segoe UI,Arial' font-size='11.5' font-weight='600' fill='rgb(22,33,46)'>" & _lb & "</text></svg>" )
// formato: texto · categoria de dados: ImageUrl

// Barra de cobertura × lead time apenas para linhas críticas (ruptura ou abaixo da segurança).
[IMG | Barra Cobertura Crítico] = IF ( [Estoque Linha Crítica] = 1, [IMG | Barra Cobertura] )
// formato: texto · categoria de dados: ImageUrl

// Barra de OTIF. Marca vermelha na referência de 80%. Vermelha abaixo de 50%, âmbar abaixo de 80%.
[IMG | Barra OTIF] =
VAR _v = [OTIF %]
VAR _max = 1
VAR _w = FORMAT ( MAX ( 0, MIN ( 1, DIVIDE ( _v, _max ) ) ) * 96, "0.0", "en-US" )
VAR _col = SWITCH ( TRUE (), _v >= 0.8, "rgb(20,128,74)", _v >= 0.5, "rgb(232,163,23)", "rgb(200,22,28)" )
VAR _lb = FORMAT ( _v, "0%", "pt-BR" )
VAR _tk = FORMAT ( MIN ( 1, DIVIDE ( 0.8, _max ) ) * 96 - 1, "0.0", "en-US" )
RETURN IF ( NOT ISBLANK ( _v ), "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='150' height='22' viewBox='0 0 150 22'><rect x='0' y='7' width='96' height='8' rx='4' fill='rgb(218,223,229)'/><rect x='0' y='7' width='" & _w & "' height='8' rx='4' fill='" & _col & "'/>" & "<rect x='" & _tk & "' y='3' width='2' height='16' fill='rgb(227,30,36)'/>" & "<text x='102' y='15.5' font-family='Segoe UI,Arial' font-size='11.5' font-weight='600' fill='rgb(22,33,46)'>" & _lb & "</text></svg>" )
// formato: texto · categoria de dados: ImageUrl

// Barra de penetração da categoria na base de clientes ativos.
[IMG | Barra Penetração] =
VAR _v = [Penetração Categoria %]
VAR _max = 1
VAR _w = FORMAT ( MAX ( 0, MIN ( 1, DIVIDE ( _v, _max ) ) ) * 96, "0.0", "en-US" )
VAR _col = "rgb(11,31,51)"
VAR _lb = FORMAT ( _v, "0%", "pt-BR" )
RETURN IF ( NOT ISBLANK ( _v ), "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='150' height='22' viewBox='0 0 150 22'><rect x='0' y='7' width='96' height='8' rx='4' fill='rgb(218,223,229)'/><rect x='0' y='7' width='" & _w & "' height='8' rx='4' fill='" & _col & "'/>" & "<text x='102' y='15.5' font-family='Segoe UI,Arial' font-size='11.5' font-weight='600' fill='rgb(22,33,46)'>" & _lb & "</text></svg>" )
// formato: texto · categoria de dados: ImageUrl

// Barra do Supplier Score (0 a 100).
[IMG | Barra Score] =
VAR _v = [Supplier Score]
VAR _max = 100
VAR _w = FORMAT ( MAX ( 0, MIN ( 1, DIVIDE ( _v, _max ) ) ) * 96, "0.0", "en-US" )
VAR _col = SWITCH ( TRUE (), _v >= 75, "rgb(20,128,74)", _v >= 60, "rgb(11,31,51)", "rgb(200,22,28)" )
VAR _lb = FORMAT ( _v, "0", "pt-BR" )
RETURN IF ( NOT ISBLANK ( _v ), "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='150' height='22' viewBox='0 0 150 22'><rect x='0' y='7' width='96' height='8' rx='4' fill='rgb(218,223,229)'/><rect x='0' y='7' width='" & _w & "' height='8' rx='4' fill='" & _col & "'/>" & "<text x='102' y='15.5' font-family='Segoe UI,Arial' font-size='11.5' font-weight='600' fill='rgb(22,33,46)'>" & _lb & "</text></svg>" )
// formato: texto · categoria de dados: ImageUrl

// Cabeçalho da página Visão Executiva: título, pergunta de negócio, período efetivo, modo e microindicador.
[HTML | Cabeçalho Executiva] =
VAR _per = FORMAT ( [Período Início], "dd/MM/yy" ) & " a " & FORMAT ( [Período Fim], "dd/MM/yy" )
VAR _modo = IF ( SELECTEDVALUE ( pModo[ModoID], 1 ) = 2, "demonstração com horizonte sintético", "realizado até o corte" )
VAR _mi = IF ( ISBLANK ( [Atingimento Meta %] ), "–", FORMAT ( [Atingimento Meta %], "0.0%", "pt-BR" ) )
RETURN
    [HTML | CSS] & "<div class='tk tk-hd'><div class='tk-hb'></div><div style='min-width:0'><div class='tk-ht'>Visão Executiva</div><div class='tk-hs'>O que mudou e onde agir? · " & _per & " · " & _modo & "</div></div><div class='tk-hm'><span>Atingimento da meta</span><b>" & _mi & "</b></div></div>"
// formato: texto

// Cabeçalho da página Comercial &amp; Clientes: título, pergunta de negócio, período efetivo, modo e microindicador.
[HTML | Cabeçalho Comercial] =
VAR _per = FORMAT ( [Período Início], "dd/MM/yy" ) & " a " & FORMAT ( [Período Fim], "dd/MM/yy" )
VAR _modo = IF ( SELECTEDVALUE ( pModo[ModoID], 1 ) = 2, "demonstração com horizonte sintético", "realizado até o corte" )
VAR _mi = IF ( ISBLANK ( [Positivação %] ), "–", FORMAT ( [Positivação %], "0.0%", "pt-BR" ) )
RETURN
    [HTML | CSS] & "<div class='tk tk-hd'><div class='tk-hb'></div><div style='min-width:0'><div class='tk-ht'>Comercial &amp; Clientes</div><div class='tk-hs'>Quem cresce, cai ou destrói margem? · " & _per & " · " & _modo & "</div></div><div class='tk-hm'><span>Positivação</span><b>" & _mi & "</b></div></div>"
// formato: texto

// Cabeçalho da página Estoque &amp; Supply: título, pergunta de negócio, período efetivo, modo e microindicador.
[HTML | Cabeçalho Estoque] =
VAR _per = FORMAT ( [Período Início], "dd/MM/yy" ) & " a " & FORMAT ( [Período Fim], "dd/MM/yy" )
VAR _modo = IF ( SELECTEDVALUE ( pModo[ModoID], 1 ) = 2, "demonstração com horizonte sintético", "realizado até o corte" )
VAR _mi = IF ( ISBLANK ( [Data Último Snapshot] ), "–", FORMAT ( [Data Último Snapshot], "dd/MM/yyyy" ) )
RETURN
    [HTML | CSS] & "<div class='tk tk-hd'><div class='tk-hb'></div><div style='min-width:0'><div class='tk-ht'>Estoque &amp; Supply</div><div class='tk-hs'>Onde faltará ou sobrará produto? · " & _per & " · " & _modo & "</div></div><div class='tk-hm'><span>Snapshot de estoque</span><b>" & _mi & "</b></div></div>"
// formato: texto

// Cabeçalho da página Rentabilidade &amp; Ações: título, pergunta de negócio, período efetivo, modo e microindicador.
[HTML | Cabeçalho Rentabilidade] =
VAR _per = FORMAT ( [Período Início], "dd/MM/yy" ) & " a " & FORMAT ( [Período Fim], "dd/MM/yy" )
VAR _modo = IF ( SELECTEDVALUE ( pModo[ModoID], 1 ) = 2, "demonstração com horizonte sintético", "realizado até o corte" )
VAR _mi = IF ( ISBLANK ( [MC %] ), "–", FORMAT ( [MC %], "0.0%", "pt-BR" ) )
RETURN
    [HTML | CSS] & "<div class='tk tk-hd'><div class='tk-hb'></div><div style='min-width:0'><div class='tk-ht'>Rentabilidade &amp; Ações</div><div class='tk-hs'>O que fazer agora? · " & _per & " · " & _modo & "</div></div><div class='tk-hm'><span>Margem de contribuição</span><b>" & _mi & "</b></div></div>"
// formato: texto

// Barra de filtros ativos: período efetivo, filial, vendedor, categoria, cliente, fornecedor (quando filtrado), data de corte e aviso de dados sintéticos futuros. Seleção múltipla aparece como contagem.
[HTML | Filtros Ativos] =
VAR _c = [Data Corte]
VAR _fp = ISFILTERED ( dCalendario )
VAR _hp = "<span class='tk-cp" & IF ( _fp, " on", "" ) & "'><b>PERÍODO</b>" & FORMAT ( [Período Início], "dd/MM/yy" ) & " a " & FORMAT ( [Período Fim], "dd/MM/yy" ) & "</span>"
VAR _fFilial = ISFILTERED ( dFilial[Filial] )
VAR _tFilial =
    IF ( _fFilial,
        IF ( HASONEVALUE ( dFilial[Filial] ), SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SELECTEDVALUE ( dFilial[Filial] ), "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), COUNTROWS ( VALUES ( dFilial[Filial] ) ) & " selecionadas" ),
        "Todas" )
VAR _hFilial = "<span class='tk-cp" & IF ( _fFilial, " on", "" ) & "'><b>FILIAL</b>" & _tFilial & "</span>"
VAR _fVendedor = ISFILTERED ( dVendedor[Vendedor] )
VAR _tVendedor =
    IF ( _fVendedor,
        IF ( HASONEVALUE ( dVendedor[Vendedor] ), SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SELECTEDVALUE ( dVendedor[Vendedor] ), "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), COUNTROWS ( VALUES ( dVendedor[Vendedor] ) ) & " selecionados" ),
        "Todos" )
VAR _hVendedor = "<span class='tk-cp" & IF ( _fVendedor, " on", "" ) & "'><b>VENDEDOR</b>" & _tVendedor & "</span>"
VAR _fCategoria = ISFILTERED ( dProduto[Categoria] )
VAR _tCategoria =
    IF ( _fCategoria,
        IF ( HASONEVALUE ( dProduto[Categoria] ), SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SELECTEDVALUE ( dProduto[Categoria] ), "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), COUNTROWS ( VALUES ( dProduto[Categoria] ) ) & " selecionadas" ),
        "Todas" )
VAR _hCategoria = "<span class='tk-cp" & IF ( _fCategoria, " on", "" ) & "'><b>CATEGORIA</b>" & _tCategoria & "</span>"
VAR _fCliente = ISFILTERED ( dCliente[NomeFantasia] )
VAR _tCliente =
    IF ( _fCliente,
        IF ( HASONEVALUE ( dCliente[NomeFantasia] ), SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SELECTEDVALUE ( dCliente[NomeFantasia] ), "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), COUNTROWS ( VALUES ( dCliente[NomeFantasia] ) ) & " selecionados" ),
        "Todos" )
VAR _hCliente = "<span class='tk-cp" & IF ( _fCliente, " on", "" ) & "'><b>CLIENTE</b>" & _tCliente & "</span>"
VAR _fFornecedor = ISFILTERED ( dFornecedor[Fornecedor] )
VAR _tFornecedor =
    IF ( _fFornecedor,
        IF ( HASONEVALUE ( dFornecedor[Fornecedor] ), SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SELECTEDVALUE ( dFornecedor[Fornecedor] ), "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), COUNTROWS ( VALUES ( dFornecedor[Fornecedor] ) ) & " selecionados" ),
        "Todos" )
VAR _hFornecedor = "<span class='tk-cp" & IF ( _fFornecedor, " on", "" ) & "'><b>FORNECEDOR</b>" & _tFornecedor & "</span>"
VAR _hFornecedor2 = IF ( _fFornecedor, _hFornecedor, "" )
VAR _hc = "<span class='tk-cp'><b>CORTE</b>" & FORMAT ( _c, "dd/MM/yyyy" ) & "</span>"
VAR _demo = SELECTEDVALUE ( pModo[ModoID], 1 ) = 2
VAR _fut = MAX ( dCalendario[Data] ) > _c
VAR _hm =
    SWITCH ( TRUE (),
        _demo, "<span class='tk-cp wn'><b>MODO</b>Demonstração: inclui dados sintéticos futuros</span>",
        _fut && _fp, "<span class='tk-cp wn'><b>AVISO</b>Datas após o corte não entram no realizado</span>",
        "" )
RETURN [HTML | CSS] & "<div class='tk tk-ch'>" & _hp & _hFilial & _hVendedor & _hCategoria & _hCliente & _hFornecedor2 & _hc & _hm & "</div>"
// formato: texto

// Faixa de KPIs da Visão Executiva: faturamento, margem de contribuição, meta, projeção, clientes, cobertura e inadimplência. Uma única medida para um único visual.
[HTML | KPIs Executiva] =
[HTML | CSS] & "<div class='tk tk-row'>"
    & "<div class='tk-kpi" & "'><div class='tk-l'>Faturamento líquido</div><div class='tk-v'>" & SWITCH ( TRUE (), ISBLANK ( [Receita Líquida] ), "–", ABS ( [Receita Líquida] ) >= 1e9, "R$ " & FORMAT ( [Receita Líquida] / 1e9, "#,0.00", "pt-BR" ) & " bi", ABS ( [Receita Líquida] ) >= 1e6, "R$ " & FORMAT ( [Receita Líquida] / 1e6, "#,0.0", "pt-BR" ) & " mi", ABS ( [Receita Líquida] ) >= 1e3, "R$ " & FORMAT ( [Receita Líquida] / 1e3, "#,0", "pt-BR" ) & " mil", "R$ " & FORMAT ( [Receita Líquida], "#,0", "pt-BR" ) ) & "</div><div class='tk-d " & SWITCH ( TRUE (), ISBLANK ( [Receita YoY %] ), "nt", [Receita YoY %] >= 0, "up", "dn" ) & "'>" & IF ( ISBLANK ( [Receita YoY %] ), "sem base de comparação", IF ( [Receita YoY %] >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( [Receita YoY %] ), "0.0%", "pt-BR" ) & " vs AA" ) & "</div>" & [SVG | Spark Receita] & "</div>"
    & "<div class='tk-kpi" & IF ( [MC Variação pp] <= -3, " al", "" ) & "'><div class='tk-l'>Margem de contribuição</div><div class='tk-v'>" & SWITCH ( TRUE (), ISBLANK ( [Margem Contribuição] ), "–", ABS ( [Margem Contribuição] ) >= 1e9, "R$ " & FORMAT ( [Margem Contribuição] / 1e9, "#,0.00", "pt-BR" ) & " bi", ABS ( [Margem Contribuição] ) >= 1e6, "R$ " & FORMAT ( [Margem Contribuição] / 1e6, "#,0.0", "pt-BR" ) & " mi", ABS ( [Margem Contribuição] ) >= 1e3, "R$ " & FORMAT ( [Margem Contribuição] / 1e3, "#,0", "pt-BR" ) & " mil", "R$ " & FORMAT ( [Margem Contribuição], "#,0", "pt-BR" ) ) & "</div><div class='tk-d " & SWITCH ( TRUE (), ISBLANK ( [MC Variação pp] ), "nt", [MC Variação pp] >= 0, "up", "dn" ) & "'>" & FORMAT ( [MC %], "0.0%", "pt-BR" ) & " · " & IF ( ISBLANK ( [MC Variação pp] ), "sem base de comparação", IF ( [MC Variação pp] >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( [MC Variação pp] ), "0.0", "pt-BR" ) & " p.p. vs AA" ) & "</div>" & [SVG | Spark MC %] & "</div>"
    & "<div class='tk-kpi" & SWITCH ( TRUE (), ISBLANK ( [Atingimento Meta %] ), "", [Atingimento Meta %] >= 1, " ok", [Atingimento Meta %] >= 0.95, " wn", " al" ) & "'><div class='tk-l'>Meta do período</div><div class='tk-v'>" & IF ( ISBLANK ( [Atingimento Meta %] ), "–", FORMAT ( [Atingimento Meta %], "0.0%", "pt-BR" ) ) & "</div><div class='tk-d " & SWITCH ( TRUE (), ISBLANK ( [Gap Meta] ), "nt", [Gap Meta] >= 0, "up", "dn" ) & "'>" & IF ( ISBLANK ( [Gap Meta] ), "sem meta no contexto", IF ( [Gap Meta] >= 0, "▲ ", "▼ " ) & SWITCH ( TRUE (), ISBLANK ( ABS ( [Gap Meta] ) ), "–", ABS ( ABS ( [Gap Meta] ) ) >= 1e9, "R$ " & FORMAT ( ABS ( [Gap Meta] ) / 1e9, "#,0.00", "pt-BR" ) & " bi", ABS ( ABS ( [Gap Meta] ) ) >= 1e6, "R$ " & FORMAT ( ABS ( [Gap Meta] ) / 1e6, "#,0.0", "pt-BR" ) & " mi", ABS ( ABS ( [Gap Meta] ) ) >= 1e3, "R$ " & FORMAT ( ABS ( [Gap Meta] ) / 1e3, "#,0", "pt-BR" ) & " mil", "R$ " & FORMAT ( ABS ( [Gap Meta] ), "#,0", "pt-BR" ) ) & " vs meta proporcional" ) & "</div>" & "<div class='tk-pg'><i style='width:" & FORMAT ( MAX ( 0, MIN ( 1, DIVIDE ( [Atingimento Meta %], 1.25 ) ) ) * 100, "0", "en-US" ) & "%'></i><b style='left:" & FORMAT ( 0.8 * 100, "0", "en-US" ) & "%'></b></div>" & "</div>"
    & "<div class='tk-kpi" & "'><div class='tk-l'>Projeção do mês do corte</div><div class='tk-v'>" & SWITCH ( TRUE (), ISBLANK ( [Projeção Fechamento Mês] ), "–", ABS ( [Projeção Fechamento Mês] ) >= 1e9, "R$ " & FORMAT ( [Projeção Fechamento Mês] / 1e9, "#,0.00", "pt-BR" ) & " bi", ABS ( [Projeção Fechamento Mês] ) >= 1e6, "R$ " & FORMAT ( [Projeção Fechamento Mês] / 1e6, "#,0.0", "pt-BR" ) & " mi", ABS ( [Projeção Fechamento Mês] ) >= 1e3, "R$ " & FORMAT ( [Projeção Fechamento Mês] / 1e3, "#,0", "pt-BR" ) & " mil", "R$ " & FORMAT ( [Projeção Fechamento Mês], "#,0", "pt-BR" ) ) & "</div><div class='tk-d " & IF ( [Projeção vs Meta %] >= 1, "up", "dn" ) & "'>" & FORMAT ( [Projeção vs Meta %], "0.0%", "pt-BR" ) & " da meta de " & FORMAT ( [Data Corte], "MMM/yy", "pt-BR" ) & "</div>" & "<div class='tk-e'>" & "Simulação: ritmo dos últimos 60 dias" & "</div>" & "</div>"
    & "<div class='tk-kpi" & "'><div class='tk-l'>Clientes ativos</div><div class='tk-v'>" & IF ( ISBLANK ( [Clientes Ativos] ), "–", FORMAT ( [Clientes Ativos], "#,0", "pt-BR" ) ) & "</div><div class='tk-d " & SWITCH ( TRUE (), ISBLANK ( [Clientes Ativos YoY %] ), "nt", [Clientes Ativos YoY %] >= 0, "up", "dn" ) & "'>" & IF ( ISBLANK ( [Clientes Ativos YoY %] ), "sem base de comparação", IF ( [Clientes Ativos YoY %] >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( [Clientes Ativos YoY %] ), "0.0%", "pt-BR" ) & " vs AA" ) & "</div>" & [SVG | Spark Clientes] & "</div>"
    & "<div class='tk-kpi" & IF ( [Ruptura Observada %] >= 0.05, " wn", "" ) & "'><div class='tk-l'>Cobertura de estoque</div><div class='tk-v'>" & IF ( ISBLANK ( [Cobertura Dias] ), "–", FORMAT ( [Cobertura Dias], "#,0", "pt-BR" ) & " dias" ) & "</div><div class='tk-d " & IF ( [Ruptura Observada %] >= 0.05, "dn", "nt" ) & "'>" & FORMAT ( [Itens em Ruptura], "#,0", "pt-BR" ) & " itens zerados (" & FORMAT ( [Ruptura Observada %], "0.0%", "pt-BR" ) & ")" & "</div>" & "<div class='tk-e'>" & "Snapshot de " & FORMAT ( [Data Último Snapshot], "dd/MM/yyyy" ) & "</div>" & "</div>"
    & "<div class='tk-kpi" & IF ( [Vencido %] >= 0.3, " al", "" ) & "'><div class='tk-l'>Inadimplência vencida</div><div class='tk-v'>" & SWITCH ( TRUE (), ISBLANK ( [Vencido] ), "–", ABS ( [Vencido] ) >= 1e9, "R$ " & FORMAT ( [Vencido] / 1e9, "#,0.00", "pt-BR" ) & " bi", ABS ( [Vencido] ) >= 1e6, "R$ " & FORMAT ( [Vencido] / 1e6, "#,0.0", "pt-BR" ) & " mi", ABS ( [Vencido] ) >= 1e3, "R$ " & FORMAT ( [Vencido] / 1e3, "#,0", "pt-BR" ) & " mil", "R$ " & FORMAT ( [Vencido], "#,0", "pt-BR" ) ) & "</div><div class='tk-d " & IF ( [Vencido %] >= 0.3, "dn", "wr" ) & "'>" & FORMAT ( [Vencido %], "0.0%", "pt-BR" ) & " do saldo em aberto" & "</div>" & "<div class='tk-e'>" & "Posição em " & FORMAT ( [Data Corte], "dd/MM/yyyy" ) & " · DSO " & FORMAT ( [DSO], "0", "pt-BR" ) & " d" & "</div>" & "</div>"
    & "</div>"
// formato: texto

// Faixa de KPIs de Comercial & Clientes.
[HTML | KPIs Comercial] =
[HTML | CSS] & "<div class='tk tk-row'>"
    & "<div class='tk-kpi" & "'><div class='tk-l'>Clientes ativos</div><div class='tk-v'>" & IF ( ISBLANK ( [Clientes Ativos] ), "–", FORMAT ( [Clientes Ativos], "#,0", "pt-BR" ) ) & "</div><div class='tk-d " & SWITCH ( TRUE (), ISBLANK ( [Clientes Ativos YoY %] ), "nt", [Clientes Ativos YoY %] >= 0, "up", "dn" ) & "'>" & IF ( ISBLANK ( [Clientes Ativos YoY %] ), "sem base de comparação", IF ( [Clientes Ativos YoY %] >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( [Clientes Ativos YoY %] ), "0.0%", "pt-BR" ) & " vs AA" ) & "</div>" & [SVG | Spark Clientes] & "</div>"
    & "<div class='tk-kpi" & "'><div class='tk-l'>Novos</div><div class='tk-v'>" & IF ( ISBLANK ( [Clientes Novos] + 0 ), "–", FORMAT ( [Clientes Novos] + 0, "#,0", "pt-BR" ) ) & "</div><div class='tk-d " & "nt" & "'>" & "primeira compra no período" & "</div>" & [SVG | Spark Novos] & "</div>"
    & "<div class='tk-kpi" & "'><div class='tk-l'>Reativados</div><div class='tk-v'>" & IF ( ISBLANK ( [Clientes Reativados] ), "–", FORMAT ( [Clientes Reativados], "#,0", "pt-BR" ) ) & "</div><div class='tk-d " & "nt" & "'>" & "voltaram após " & [Dias Inatividade] & " dias ou mais" & "</div>" & "</div>"
    & "<div class='tk-kpi" & IF ( DIVIDE ( [Clientes Inativos], [Clientes Carteira] ) >= 0.1, " al", "" ) & "'><div class='tk-l'>Inativos</div><div class='tk-v'>" & IF ( ISBLANK ( [Clientes Inativos] ), "–", FORMAT ( [Clientes Inativos], "#,0", "pt-BR" ) ) & "</div><div class='tk-d " & IF ( DIVIDE ( [Clientes Inativos], [Clientes Carteira] ) >= 0.1, "dn", "nt" ) & "'>" & "sem compra há mais de " & [Dias Inatividade] & " dias" & "</div>" & "<div class='tk-e'>" & FORMAT ( DIVIDE ( [Clientes Inativos], [Clientes Carteira] ), "0.0%", "pt-BR" ) & " da carteira" & "</div>" & "</div>"
    & "<div class='tk-kpi" & "'><div class='tk-l'>Positivação</div><div class='tk-v'>" & IF ( ISBLANK ( [Positivação %] ), "–", FORMAT ( [Positivação %], "0.0%", "pt-BR" ) ) & "</div><div class='tk-d " & "nt" & "'>" & FORMAT ( [Clientes Ativos], "#,0", "pt-BR" ) & " de " & FORMAT ( [Clientes Carteira], "#,0", "pt-BR" ) & " na carteira" & "</div>" & "<div class='tk-pg'><i style='width:" & FORMAT ( MAX ( 0, MIN ( 1, [Positivação %] ) ) * 100, "0", "en-US" ) & "%'></i><b style='left:" & FORMAT ( 1 * 100, "0", "en-US" ) & "%'></b></div>" & "</div>"
    & "<div class='tk-kpi" & "'><div class='tk-l'>Frequência</div><div class='tk-v'>" & IF ( ISBLANK ( [Frequência Mensal] ), "–", FORMAT ( [Frequência Mensal], "0.0", "pt-BR" ) ) & "</div><div class='tk-d " & "nt" & "'>" & "pedidos por cliente ativo ao mês" & "</div>" & "</div>"
    & "<div class='tk-kpi" & "'><div class='tk-l'>Ticket médio</div><div class='tk-v'>" & IF ( ISBLANK ( [Ticket Médio] ), "–", "R$ " & FORMAT ( [Ticket Médio], "#,0", "pt-BR" ) ) & "</div><div class='tk-d " & "nt" & "'>" & "receita líquida por pedido" & "</div>" & [SVG | Spark Ticket] & "</div>"
    & "<div class='tk-kpi" & "'><div class='tk-l'>Mix médio</div><div class='tk-v'>" & IF ( ISBLANK ( [Mix Médio SKUs] ), "–", FORMAT ( [Mix Médio SKUs], "0.0", "pt-BR" ) ) & "</div><div class='tk-d " & "nt" & "'>" & "SKUs distintos por cliente" & "</div>" & "<div class='tk-e'>" & FORMAT ( [Categorias por Cliente], "0.0", "pt-BR" ) & " categorias por cliente" & "</div>" & "</div>"
    & "</div>"
// formato: texto

// Faixa de KPIs de Estoque & Supply. Saldos sempre no último snapshot semanal.
[HTML | KPIs Estoque] =
[HTML | CSS] & "<div class='tk tk-row'>"
    & "<div class='tk-kpi" & "'><div class='tk-l'>Valor em estoque</div><div class='tk-v'>" & SWITCH ( TRUE (), ISBLANK ( [Estoque Valor] ), "–", ABS ( [Estoque Valor] ) >= 1e9, "R$ " & FORMAT ( [Estoque Valor] / 1e9, "#,0.00", "pt-BR" ) & " bi", ABS ( [Estoque Valor] ) >= 1e6, "R$ " & FORMAT ( [Estoque Valor] / 1e6, "#,0.0", "pt-BR" ) & " mi", ABS ( [Estoque Valor] ) >= 1e3, "R$ " & FORMAT ( [Estoque Valor] / 1e3, "#,0", "pt-BR" ) & " mil", "R$ " & FORMAT ( [Estoque Valor], "#,0", "pt-BR" ) ) & "</div><div class='tk-d " & "nt" & "'>" & "snapshot de " & FORMAT ( [Data Último Snapshot], "dd/MM/yyyy" ) & "</div>" & [SVG | Spark Estoque Valor] & "</div>"
    & "<div class='tk-kpi" & "'><div class='tk-l'>Cobertura</div><div class='tk-v'>" & IF ( ISBLANK ( [Cobertura Dias] ), "–", FORMAT ( [Cobertura Dias], "#,0", "pt-BR" ) & " dias" ) & "</div><div class='tk-d " & "nt" & "'>" & "sobre o CMV dos últimos 90 dias" & "</div>" & [SVG | Spark Cobertura] & "</div>"
    & "<div class='tk-kpi" & "'><div class='tk-l'>Giro anual</div><div class='tk-v'>" & IF ( ISBLANK ( [Giro Anual] ), "–", FORMAT ( [Giro Anual], "0.0", "pt-BR" ) & "x" ) & "</div><div class='tk-d " & "nt" & "'>" & "CMV 12 meses ÷ estoque médio" & "</div>" & "</div>"
    & "<div class='tk-kpi" & IF ( [Ruptura Observada %] >= 0.05, " al", "" ) & "'><div class='tk-l'>Ruptura observada</div><div class='tk-v'>" & IF ( ISBLANK ( [Ruptura Observada %] ), "–", FORMAT ( [Ruptura Observada %], "0.0%", "pt-BR" ) ) & "</div><div class='tk-d " & IF ( [Ruptura Observada %] >= 0.05, "dn", "nt" ) & "'>" & FORMAT ( [Itens em Ruptura], "#,0", "pt-BR" ) & " SKU × filial zerados" & "</div>" & "<div class='tk-e'>" & FORMAT ( [Itens Abaixo Segurança], "#,0", "pt-BR" ) & " abaixo da segurança" & "</div>" & "</div>"
    & "<div class='tk-kpi" & "'><div class='tk-l'>Excesso de estoque</div><div class='tk-v'>" & SWITCH ( TRUE (), ISBLANK ( [Estoque Excesso Valor] ), "–", ABS ( [Estoque Excesso Valor] ) >= 1e9, "R$ " & FORMAT ( [Estoque Excesso Valor] / 1e9, "#,0.00", "pt-BR" ) & " bi", ABS ( [Estoque Excesso Valor] ) >= 1e6, "R$ " & FORMAT ( [Estoque Excesso Valor] / 1e6, "#,0.0", "pt-BR" ) & " mi", ABS ( [Estoque Excesso Valor] ) >= 1e3, "R$ " & FORMAT ( [Estoque Excesso Valor] / 1e3, "#,0", "pt-BR" ) & " mil", "R$ " & FORMAT ( [Estoque Excesso Valor], "#,0", "pt-BR" ) ) & "</div><div class='tk-d " & "wr" & "'>" & FORMAT ( DIVIDE ( [Estoque Excesso Valor], [Estoque Valor] ), "0.0%", "pt-BR" ) & " do estoque acima de 120 d" & "</div>" & "<div class='tk-e'>" & "Parado 90 dias: " & SWITCH ( TRUE (), ISBLANK ( [Estoque Parado Valor] ), "–", ABS ( [Estoque Parado Valor] ) >= 1e9, "R$ " & FORMAT ( [Estoque Parado Valor] / 1e9, "#,0.00", "pt-BR" ) & " bi", ABS ( [Estoque Parado Valor] ) >= 1e6, "R$ " & FORMAT ( [Estoque Parado Valor] / 1e6, "#,0.0", "pt-BR" ) & " mi", ABS ( [Estoque Parado Valor] ) >= 1e3, "R$ " & FORMAT ( [Estoque Parado Valor] / 1e3, "#,0", "pt-BR" ) & " mil", "R$ " & FORMAT ( [Estoque Parado Valor], "#,0", "pt-BR" ) ) & "</div>" & "</div>"
    & "<div class='tk-kpi" & "'><div class='tk-l'>Compras em aberto</div><div class='tk-v'>" & SWITCH ( TRUE (), ISBLANK ( [Compras Pendentes Valor] ), "–", ABS ( [Compras Pendentes Valor] ) >= 1e9, "R$ " & FORMAT ( [Compras Pendentes Valor] / 1e9, "#,0.00", "pt-BR" ) & " bi", ABS ( [Compras Pendentes Valor] ) >= 1e6, "R$ " & FORMAT ( [Compras Pendentes Valor] / 1e6, "#,0.0", "pt-BR" ) & " mi", ABS ( [Compras Pendentes Valor] ) >= 1e3, "R$ " & FORMAT ( [Compras Pendentes Valor] / 1e3, "#,0", "pt-BR" ) & " mil", "R$ " & FORMAT ( [Compras Pendentes Valor], "#,0", "pt-BR" ) ) & "</div><div class='tk-d " & "nt" & "'>" & FORMAT ( [Compras Pendentes Pedidos], "#,0", "pt-BR" ) & " pedidos a receber no corte" & "</div>" & "</div>"
    & "<div class='tk-kpi" & IF ( [OTIF %] < 0.6, " al", "" ) & "'><div class='tk-l'>OTIF</div><div class='tk-v'>" & IF ( ISBLANK ( [OTIF %] ), "–", FORMAT ( [OTIF %], "0.0%", "pt-BR" ) ) & "</div><div class='tk-d " & SWITCH ( TRUE (), ISBLANK ( ( [OTIF %] - [OTIF % LY] ) * 100 ), "nt", ( [OTIF %] - [OTIF % LY] ) * 100 >= 0, "up", "dn" ) & "'>" & IF ( ISBLANK ( ( [OTIF %] - [OTIF % LY] ) * 100 ), "sem base de comparação", IF ( ( [OTIF %] - [OTIF % LY] ) * 100 >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( ( [OTIF %] - [OTIF % LY] ) * 100 ), "0.0", "pt-BR" ) & " p.p. vs AA" ) & "</div>" & "<div class='tk-e'>" & "No prazo " & FORMAT ( [On Time %], "0%", "pt-BR" ) & " · completo " & FORMAT ( [In Full %], "0%", "pt-BR" ) & "</div>" & [SVG | Spark OTIF] & "</div>"
    & "<div class='tk-kpi" & "'><div class='tk-l'>Lead time real</div><div class='tk-v'>" & IF ( ISBLANK ( [Lead Time Real] ), "–", FORMAT ( [Lead Time Real], "0.0", "pt-BR" ) & " dias" ) & "</div><div class='tk-d " & SWITCH ( TRUE (), ISBLANK ( DIVIDE ( [Lead Time Real] - [Lead Time Real LY], [Lead Time Real LY] ) ), "nt", DIVIDE ( [Lead Time Real] - [Lead Time Real LY], [Lead Time Real LY] ) >= 0, "dn", "up" ) & "'>" & IF ( ISBLANK ( DIVIDE ( [Lead Time Real] - [Lead Time Real LY], [Lead Time Real LY] ) ), "sem base de comparação", IF ( DIVIDE ( [Lead Time Real] - [Lead Time Real LY], [Lead Time Real LY] ) >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( DIVIDE ( [Lead Time Real] - [Lead Time Real LY], [Lead Time Real LY] ) ), "0.0%", "pt-BR" ) & " vs AA" ) & "</div>" & "<div class='tk-e'>" & "Atraso médio " & FORMAT ( [Atraso Médio], "0.0", "pt-BR" ) & " d" & "</div>" & [SVG | Spark Lead Time] & "</div>"
    & "</div>"
// formato: texto

// Faixa de KPIs de Rentabilidade. Margem de contribuição operacional, não EBITDA.
[HTML | KPIs Rentabilidade] =
[HTML | CSS] & "<div class='tk tk-row'>"
    & "<div class='tk-kpi" & "'><div class='tk-l'>Receita bruta</div><div class='tk-v'>" & SWITCH ( TRUE (), ISBLANK ( [Receita Bruta] ), "–", ABS ( [Receita Bruta] ) >= 1e9, "R$ " & FORMAT ( [Receita Bruta] / 1e9, "#,0.00", "pt-BR" ) & " bi", ABS ( [Receita Bruta] ) >= 1e6, "R$ " & FORMAT ( [Receita Bruta] / 1e6, "#,0.0", "pt-BR" ) & " mi", ABS ( [Receita Bruta] ) >= 1e3, "R$ " & FORMAT ( [Receita Bruta] / 1e3, "#,0", "pt-BR" ) & " mil", "R$ " & FORMAT ( [Receita Bruta], "#,0", "pt-BR" ) ) & "</div><div class='tk-d " & "nt" & "'>" & "a preço de tabela" & "</div>" & [SVG | Spark Receita Bruta] & "</div>"
    & "<div class='tk-kpi" & "'><div class='tk-l'>Desconto médio</div><div class='tk-v'>" & IF ( ISBLANK ( [Desconto %] ), "–", FORMAT ( [Desconto %], "0.0%", "pt-BR" ) ) & "</div><div class='tk-d " & SWITCH ( TRUE (), ISBLANK ( ( [Desconto %] - [Desconto % LY] ) * 100 ), "nt", ( [Desconto %] - [Desconto % LY] ) * 100 >= 0, "dn", "up" ) & "'>" & IF ( ISBLANK ( ( [Desconto %] - [Desconto % LY] ) * 100 ), "sem base de comparação", IF ( ( [Desconto %] - [Desconto % LY] ) * 100 >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( ( [Desconto %] - [Desconto % LY] ) * 100 ), "0.0", "pt-BR" ) & " p.p. vs AA" ) & "</div>" & "<div class='tk-e'>" & SWITCH ( TRUE (), ISBLANK ( [Descontos] ), "–", ABS ( [Descontos] ) >= 1e9, "R$ " & FORMAT ( [Descontos] / 1e9, "#,0.00", "pt-BR" ) & " bi", ABS ( [Descontos] ) >= 1e6, "R$ " & FORMAT ( [Descontos] / 1e6, "#,0.0", "pt-BR" ) & " mi", ABS ( [Descontos] ) >= 1e3, "R$ " & FORMAT ( [Descontos] / 1e3, "#,0", "pt-BR" ) & " mil", "R$ " & FORMAT ( [Descontos], "#,0", "pt-BR" ) ) & "</div>" & [SVG | Spark Desconto %] & "</div>"
    & "<div class='tk-kpi" & "'><div class='tk-l'>Receita líquida</div><div class='tk-v'>" & SWITCH ( TRUE (), ISBLANK ( [Receita Líquida] ), "–", ABS ( [Receita Líquida] ) >= 1e9, "R$ " & FORMAT ( [Receita Líquida] / 1e9, "#,0.00", "pt-BR" ) & " bi", ABS ( [Receita Líquida] ) >= 1e6, "R$ " & FORMAT ( [Receita Líquida] / 1e6, "#,0.0", "pt-BR" ) & " mi", ABS ( [Receita Líquida] ) >= 1e3, "R$ " & FORMAT ( [Receita Líquida] / 1e3, "#,0", "pt-BR" ) & " mil", "R$ " & FORMAT ( [Receita Líquida], "#,0", "pt-BR" ) ) & "</div><div class='tk-d " & SWITCH ( TRUE (), ISBLANK ( [Receita YoY %] ), "nt", [Receita YoY %] >= 0, "up", "dn" ) & "'>" & IF ( ISBLANK ( [Receita YoY %] ), "sem base de comparação", IF ( [Receita YoY %] >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( [Receita YoY %] ), "0.0%", "pt-BR" ) & " vs AA" ) & "</div>" & [SVG | Spark Receita] & "</div>"
    & "<div class='tk-kpi" & IF ( ( [Margem Bruta %] - [Margem Bruta % LY] ) * 100 <= -3, " al", "" ) & "'><div class='tk-l'>Margem bruta</div><div class='tk-v'>" & IF ( ISBLANK ( [Margem Bruta %] ), "–", FORMAT ( [Margem Bruta %], "0.0%", "pt-BR" ) ) & "</div><div class='tk-d " & SWITCH ( TRUE (), ISBLANK ( ( [Margem Bruta %] - [Margem Bruta % LY] ) * 100 ), "nt", ( [Margem Bruta %] - [Margem Bruta % LY] ) * 100 >= 0, "up", "dn" ) & "'>" & IF ( ISBLANK ( ( [Margem Bruta %] - [Margem Bruta % LY] ) * 100 ), "sem base de comparação", IF ( ( [Margem Bruta %] - [Margem Bruta % LY] ) * 100 >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( ( [Margem Bruta %] - [Margem Bruta % LY] ) * 100 ), "0.0", "pt-BR" ) & " p.p. vs AA" ) & "</div>" & "<div class='tk-e'>" & SWITCH ( TRUE (), ISBLANK ( [Margem Bruta] ), "–", ABS ( [Margem Bruta] ) >= 1e9, "R$ " & FORMAT ( [Margem Bruta] / 1e9, "#,0.00", "pt-BR" ) & " bi", ABS ( [Margem Bruta] ) >= 1e6, "R$ " & FORMAT ( [Margem Bruta] / 1e6, "#,0.0", "pt-BR" ) & " mi", ABS ( [Margem Bruta] ) >= 1e3, "R$ " & FORMAT ( [Margem Bruta] / 1e3, "#,0", "pt-BR" ) & " mil", "R$ " & FORMAT ( [Margem Bruta], "#,0", "pt-BR" ) ) & "</div>" & [SVG | Spark Margem Bruta %] & "</div>"
    & "<div class='tk-kpi" & "'><div class='tk-l'>Frete</div><div class='tk-v'>" & IF ( ISBLANK ( DIVIDE ( [Frete], [Receita Líquida] ) ), "–", FORMAT ( DIVIDE ( [Frete], [Receita Líquida] ), "0.0%", "pt-BR" ) ) & "</div><div class='tk-d " & "nt" & "'>" & SWITCH ( TRUE (), ISBLANK ( [Frete] ), "–", ABS ( [Frete] ) >= 1e9, "R$ " & FORMAT ( [Frete] / 1e9, "#,0.00", "pt-BR" ) & " bi", ABS ( [Frete] ) >= 1e6, "R$ " & FORMAT ( [Frete] / 1e6, "#,0.0", "pt-BR" ) & " mi", ABS ( [Frete] ) >= 1e3, "R$ " & FORMAT ( [Frete] / 1e3, "#,0", "pt-BR" ) & " mil", "R$ " & FORMAT ( [Frete], "#,0", "pt-BR" ) ) & " rateados" & "</div>" & [SVG | Spark Frete %] & "</div>"
    & "<div class='tk-kpi" & "'><div class='tk-l'>Comissão</div><div class='tk-v'>" & IF ( ISBLANK ( DIVIDE ( [Comissão], [Receita Líquida] ) ), "–", FORMAT ( DIVIDE ( [Comissão], [Receita Líquida] ), "0.0%", "pt-BR" ) ) & "</div><div class='tk-d " & "nt" & "'>" & SWITCH ( TRUE (), ISBLANK ( [Comissão] ), "–", ABS ( [Comissão] ) >= 1e9, "R$ " & FORMAT ( [Comissão] / 1e9, "#,0.00", "pt-BR" ) & " bi", ABS ( [Comissão] ) >= 1e6, "R$ " & FORMAT ( [Comissão] / 1e6, "#,0.0", "pt-BR" ) & " mi", ABS ( [Comissão] ) >= 1e3, "R$ " & FORMAT ( [Comissão] / 1e3, "#,0", "pt-BR" ) & " mil", "R$ " & FORMAT ( [Comissão], "#,0", "pt-BR" ) ) & " no período" & "</div>" & [SVG | Spark Comissão %] & "</div>"
    & "<div class='tk-kpi" & IF ( [MC Variação pp] <= -3, " al", "" ) & "'><div class='tk-l'>Margem de contribuição</div><div class='tk-v'>" & SWITCH ( TRUE (), ISBLANK ( [Margem Contribuição] ), "–", ABS ( [Margem Contribuição] ) >= 1e9, "R$ " & FORMAT ( [Margem Contribuição] / 1e9, "#,0.00", "pt-BR" ) & " bi", ABS ( [Margem Contribuição] ) >= 1e6, "R$ " & FORMAT ( [Margem Contribuição] / 1e6, "#,0.0", "pt-BR" ) & " mi", ABS ( [Margem Contribuição] ) >= 1e3, "R$ " & FORMAT ( [Margem Contribuição] / 1e3, "#,0", "pt-BR" ) & " mil", "R$ " & FORMAT ( [Margem Contribuição], "#,0", "pt-BR" ) ) & "</div><div class='tk-d " & SWITCH ( TRUE (), ISBLANK ( [MC YoY %] ), "nt", [MC YoY %] >= 0, "up", "dn" ) & "'>" & IF ( ISBLANK ( [MC YoY %] ), "sem base de comparação", IF ( [MC YoY %] >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( [MC YoY %] ), "0.0%", "pt-BR" ) & " vs AA" ) & "</div>" & "<div class='tk-e'>" & FORMAT ( [MC %], "0.0%", "pt-BR" ) & " da receita líquida · " & IF ( ISBLANK ( [MC Variação pp] ), "sem base de comparação", IF ( [MC Variação pp] >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( [MC Variação pp] ), "0.0", "pt-BR" ) & " p.p. vs AA" ) & "</div>" & [SVG | Spark MC] & "</div>"
    & "</div>"
// formato: texto

// Quatro alertas de maior severidade entre meta, margem, estoque, inadimplência, supply e concentração. Limiares: meta <95% crítico, <100% atenção; MC ≤ −3 p.p. crítico, ≤ −1 atenção; ruptura ≥8% crítico, ≥4% atenção; vencido ≥30% do aberto crítico, ≥15% atenção; OTIF <60% crítico, <80% atenção; top 10 ≥40% crítico, ≥25% atenção.
[HTML | Insights Executiva] =
VAR _fim = [Período Fim]
-- 1. Meta
VAR _at = [Atingimento Meta %]
VAR _gap = [Gap Meta]
VAR _s1 = SWITCH ( TRUE (), ISBLANK ( _at ), -1, _at < 0.95, 3, _at < 1, 2, 0 )
VAR _proj = [Projeção Fechamento Mês]
VAR _h1 = "<div class='tk-al s" & FORMAT ( _s1, "0" ) & "'><div class='tk-ai'>" & SWITCH ( _s1, 3, "Crítico", 2, "Atenção", 1, "Info", "Positivo" ) & "</div><div style='min-width:0'><div class='tk-at'>" & "Meta: " & FORMAT ( _at, "0.0%", "pt-BR" ) & " do proporcional ao período" & "</div><div class='tk-ax'>" & IF ( _gap >= 0, "Excedente de ", "Gap de " ) & SWITCH ( TRUE (), ISBLANK ( ABS ( _gap ) ), "–", ABS ( ABS ( _gap ) ) >= 1e9, "R$ " & FORMAT ( ABS ( _gap ) / 1e9, "#,0.00", "pt-BR" ) & " bi", ABS ( ABS ( _gap ) ) >= 1e6, "R$ " & FORMAT ( ABS ( _gap ) / 1e6, "#,0.0", "pt-BR" ) & " mi", ABS ( ABS ( _gap ) ) >= 1e3, "R$ " & FORMAT ( ABS ( _gap ) / 1e3, "#,0", "pt-BR" ) & " mil", "R$ " & FORMAT ( ABS ( _gap ), "#,0", "pt-BR" ) ) & " até " & FORMAT ( _fim, "dd/MM/yyyy" ) & ". Projeção de " & FORMAT ( [Data Corte], "MMMM", "pt-BR" ) & ": " & SWITCH ( TRUE (), ISBLANK ( _proj ), "–", ABS ( _proj ) >= 1e9, "R$ " & FORMAT ( _proj / 1e9, "#,0.00", "pt-BR" ) & " bi", ABS ( _proj ) >= 1e6, "R$ " & FORMAT ( _proj / 1e6, "#,0.0", "pt-BR" ) & " mi", ABS ( _proj ) >= 1e3, "R$ " & FORMAT ( _proj / 1e3, "#,0", "pt-BR" ) & " mil", "R$ " & FORMAT ( _proj, "#,0", "pt-BR" ) ) & " (" & FORMAT ( [Projeção vs Meta %], "0.0%", "pt-BR" ) & " da meta do mês)." & "</div><div class='tk-ag'>Observado + simulação <i>→ Comercial &amp; Clientes</i></div></div></div>"
-- 2. Margem
VAR _pp = [MC Variação pp]
VAR _imp = [Impacto Margem]
VAR _s2 = SWITCH ( TRUE (), ISBLANK ( _pp ), -1, _pp <= -3, 3, _pp <= -1, 2, _pp >= 1, 0, 1 )
VAR _cats = TOPN ( 1, FILTER ( ADDCOLUMNS ( VALUES ( dProduto[Categoria] ), "@i", [Impacto Margem], "@p", [MC Variação pp] ), NOT ISBLANK ( [@i] ) ), [@i], ASC )
VAR _catN = MAXX ( _cats, dProduto[Categoria] )
VAR _catP = MAXX ( _cats, [@p] )
VAR _h2 = "<div class='tk-al s" & FORMAT ( _s2, "0" ) & "'><div class='tk-ai'>" & SWITCH ( _s2, 3, "Crítico", 2, "Atenção", 1, "Info", "Positivo" ) & "</div><div style='min-width:0'><div class='tk-at'>" & "Margem de contribuição: " & FORMAT ( [MC %], "0.0%", "pt-BR" ) & " (" & FORMAT ( _pp, "+0.0;-0.0", "pt-BR" ) & " p.p. vs AA)" & "</div><div class='tk-ax'>" & "Efeito de " & SWITCH ( TRUE (), ISBLANK ( _imp ), "–", ABS ( _imp ) >= 1e9, "R$ " & FORMAT ( _imp / 1e9, "#,0.00", "pt-BR" ) & " bi", ABS ( _imp ) >= 1e6, "R$ " & FORMAT ( _imp / 1e6, "#,0.0", "pt-BR" ) & " mi", ABS ( _imp ) >= 1e3, "R$ " & FORMAT ( _imp / 1e3, "#,0", "pt-BR" ) & " mil", "R$ " & FORMAT ( _imp, "#,0", "pt-BR" ) ) & " sobre a receita do período. Maior perda em " & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _catN, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ) & " (" & FORMAT ( _catP, "+0.0;-0.0", "pt-BR" ) & " p.p.)." & "</div><div class='tk-ag'>Observado <i>→ Rentabilidade &amp; Ações</i></div></div></div>"
-- 3. Estoque
VAR _rup = [Ruptura Observada %]
VAR _s3 = SWITCH ( TRUE (), ISBLANK ( _rup ), -1, _rup >= 0.08, 3, _rup >= 0.04, 2, 1 )
VAR _h3 = "<div class='tk-al s" & FORMAT ( _s3, "0" ) & "'><div class='tk-ai'>" & SWITCH ( _s3, 3, "Crítico", 2, "Atenção", 1, "Info", "Positivo" ) & "</div><div style='min-width:0'><div class='tk-at'>" & "Ruptura: " & FORMAT ( [Itens em Ruptura], "#,0", "pt-BR" ) & " SKU × filial zerados (" & FORMAT ( _rup, "0.0%", "pt-BR" ) & ")" & "</div><div class='tk-ax'>" & "Snapshot de " & FORMAT ( [Data Último Snapshot], "dd/MM/yyyy" ) & ". " & FORMAT ( [Itens Cobertura < Lead Time], "#,0", "pt-BR" ) & " itens com cobertura menor que o lead time e " & SWITCH ( TRUE (), ISBLANK ( [Estoque Excesso Valor] ), "–", ABS ( [Estoque Excesso Valor] ) >= 1e9, "R$ " & FORMAT ( [Estoque Excesso Valor] / 1e9, "#,0.00", "pt-BR" ) & " bi", ABS ( [Estoque Excesso Valor] ) >= 1e6, "R$ " & FORMAT ( [Estoque Excesso Valor] / 1e6, "#,0.0", "pt-BR" ) & " mi", ABS ( [Estoque Excesso Valor] ) >= 1e3, "R$ " & FORMAT ( [Estoque Excesso Valor] / 1e3, "#,0", "pt-BR" ) & " mil", "R$ " & FORMAT ( [Estoque Excesso Valor], "#,0", "pt-BR" ) ) & " acima de 120 dias." & "</div><div class='tk-ag'>Observado <i>→ Estoque &amp; Supply</i></div></div></div>"
-- 4. Inadimplência
VAR _vp = [Vencido %]
VAR _s4 = SWITCH ( TRUE (), ISBLANK ( _vp ), -1, _vp >= 0.3, 3, _vp >= 0.15, 2, 1 )
VAR _h4 = "<div class='tk-al s" & FORMAT ( _s4, "0" ) & "'><div class='tk-ai'>" & SWITCH ( _s4, 3, "Crítico", 2, "Atenção", 1, "Info", "Positivo" ) & "</div><div style='min-width:0'><div class='tk-at'>" & "Inadimplência: " & SWITCH ( TRUE (), ISBLANK ( [Vencido] ), "–", ABS ( [Vencido] ) >= 1e9, "R$ " & FORMAT ( [Vencido] / 1e9, "#,0.00", "pt-BR" ) & " bi", ABS ( [Vencido] ) >= 1e6, "R$ " & FORMAT ( [Vencido] / 1e6, "#,0.0", "pt-BR" ) & " mi", ABS ( [Vencido] ) >= 1e3, "R$ " & FORMAT ( [Vencido] / 1e3, "#,0", "pt-BR" ) & " mil", "R$ " & FORMAT ( [Vencido], "#,0", "pt-BR" ) ) & " vencidos (" & FORMAT ( _vp, "0.0%", "pt-BR" ) & " do aberto)" & "</div><div class='tk-ax'>" & "Posição em " & FORMAT ( [Data Corte], "dd/MM/yyyy" ) & ". " & SWITCH ( TRUE (), ISBLANK ( [Vencido > 90 dias] ), "–", ABS ( [Vencido > 90 dias] ) >= 1e9, "R$ " & FORMAT ( [Vencido > 90 dias] / 1e9, "#,0.00", "pt-BR" ) & " bi", ABS ( [Vencido > 90 dias] ) >= 1e6, "R$ " & FORMAT ( [Vencido > 90 dias] / 1e6, "#,0.0", "pt-BR" ) & " mi", ABS ( [Vencido > 90 dias] ) >= 1e3, "R$ " & FORMAT ( [Vencido > 90 dias] / 1e3, "#,0", "pt-BR" ) & " mil", "R$ " & FORMAT ( [Vencido > 90 dias], "#,0", "pt-BR" ) ) & " vencidos há mais de 90 dias. DSO de " & FORMAT ( [DSO], "0", "pt-BR" ) & " dias." & "</div><div class='tk-ag'>Observado <i>→ Comercial &amp; Clientes</i></div></div></div>"
-- 5. Supply
VAR _ot = [OTIF %]
VAR _s5 = SWITCH ( TRUE (), ISBLANK ( _ot ), -1, _ot < 0.6, 3, _ot < 0.8, 2, 0 )
VAR _forn = TOPN ( 1, FILTER ( ADDCOLUMNS ( VALUES ( dFornecedor[Fornecedor] ), "@a", [Atraso Médio], "@n", [Compras Entregues] ), [@n] >= 30 ), [@a], DESC )
VAR _h5 = "<div class='tk-al s" & FORMAT ( _s5, "0" ) & "'><div class='tk-ai'>" & SWITCH ( _s5, 3, "Crítico", 2, "Atenção", 1, "Info", "Positivo" ) & "</div><div style='min-width:0'><div class='tk-at'>" & "OTIF de fornecedores: " & FORMAT ( _ot, "0.0%", "pt-BR" ) & "</div><div class='tk-ax'>" & "No prazo " & FORMAT ( [On Time %], "0%", "pt-BR" ) & ", completo " & FORMAT ( [In Full %], "0%", "pt-BR" ) & ". Maior atraso médio: " & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( MAXX ( _forn, dFornecedor[Fornecedor] ), "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ) & " (" & FORMAT ( MAXX ( _forn, [@a] ), "0.0", "pt-BR" ) & " dias)." & "</div><div class='tk-ag'>Observado <i>→ Estoque &amp; Supply</i></div></div></div>"
-- 6. Concentração
VAR _cc = [Concentração Top 10 %]
VAR _s6 = SWITCH ( TRUE (), ISBLANK ( _cc ), -1, _cc >= 0.4, 3, _cc >= 0.25, 2, 0 )
VAR _h6 = "<div class='tk-al s" & FORMAT ( _s6, "0" ) & "'><div class='tk-ai'>" & SWITCH ( _s6, 3, "Crítico", 2, "Atenção", 1, "Info", "Positivo" ) & "</div><div style='min-width:0'><div class='tk-at'>" & "Concentração: 10 maiores clientes somam " & FORMAT ( _cc, "0.0%", "pt-BR" ) & " da receita" & "</div><div class='tk-ax'>" & "Share of wallet estimado de " & FORMAT ( [Share Estimado %], "0%", "pt-BR" ) & " nos clientes ativos e gap estimado de " & SWITCH ( TRUE (), ISBLANK ( [Gap Potencial Estimado] ), "–", ABS ( [Gap Potencial Estimado] ) >= 1e9, "R$ " & FORMAT ( [Gap Potencial Estimado] / 1e9, "#,0.00", "pt-BR" ) & " bi", ABS ( [Gap Potencial Estimado] ) >= 1e6, "R$ " & FORMAT ( [Gap Potencial Estimado] / 1e6, "#,0.0", "pt-BR" ) & " mi", ABS ( [Gap Potencial Estimado] ) >= 1e3, "R$ " & FORMAT ( [Gap Potencial Estimado] / 1e3, "#,0", "pt-BR" ) & " mil", "R$ " & FORMAT ( [Gap Potencial Estimado], "#,0", "pt-BR" ) ) & " ao mês." & "</div><div class='tk-ag'>Observado + estimado <i>→ Comercial &amp; Clientes</i></div></div></div>"
VAR _todos =
    UNION (
        ROW ( "@o", _s1 * 10 + 6, "@h", _h1 ), ROW ( "@o", _s2 * 10 + 5, "@h", _h2 ), ROW ( "@o", _s3 * 10 + 4, "@h", _h3 ),
        ROW ( "@o", _s4 * 10 + 3, "@h", _h4 ), ROW ( "@o", _s5 * 10 + 2, "@h", _h5 ), ROW ( "@o", _s6 * 10 + 1, "@h", _h6 )
    )
VAR _vis = TOPN ( 4, FILTER ( _todos, [@o] >= 0 ), [@o], DESC )
RETURN [HTML | CSS] & "<div class='tk tk-ins'>" & CONCATENATEX ( _vis, [@h], "", [@o], DESC ) & "</div>"
// formato: texto

// Quatro ações prioritárias entre ruptura, margem, cross-sell, potencial e inadimplência. Prioridade padrão = impacto em R$ × confiança (observado 0,9; estimado 0,6 ou 0,4; hipotético 0,3) × urgência ÷ 3. Ordenação alternável por impacto, urgência ou confiança.
[HTML | Decision Center] =
VAR _ord = SELECTEDVALUE ( pOrdem[OrdemID], 1 )
-- 1. Ruptura
VAR _i1 = [Receita em Risco Ruptura]
VAR _u1 = 3
VAR _c1 = 0.6
-- 2. Margem
VAR _pp = [MC Variação pp]
VAR _i2 = IF ( [Impacto Margem] < 0, - [Impacto Margem] )
VAR _u2 = IF ( _pp <= -3, 3, 2 )
VAR _c2 = 0.9
VAR _cats = TOPN ( 1, FILTER ( ADDCOLUMNS ( VALUES ( dProduto[Categoria] ), "@i", [Impacto Margem], "@p", [MC Variação pp] ), NOT ISBLANK ( [@i] ) ), [@i], ASC )
VAR _catN = MAXX ( _cats, dProduto[Categoria] )
-- 3. Cross-sell
VAR _cs = TOPN ( 1, ADDCOLUMNS ( VALUES ( dProduto[Categoria] ), "@x", [Cross-sell Potencial Hipotético], "@n", [Clientes Sem a Categoria], "@p", [Penetração Categoria %] ), [@x], DESC )
VAR _i3 = DIVIDE ( MAXX ( _cs, [@x] ), [Meses no Período] )
VAR _u3 = 1
VAR _c3 = 0.3
-- 4. Potencial
VAR _i4 = [Gap Potencial Estimado]
VAR _u4 = 1
VAR _c4 = 0.4
-- 5. Inadimplência
VAR _i5 = [Vencido > 90 dias]
VAR _u5 = 2
VAR _c5 = 0.9
VAR _t0 =
    UNION (
        ROW ( "@id", 1, "@i", _i1, "@u", _u1, "@c", _c1 ), ROW ( "@id", 2, "@i", _i2, "@u", _u2, "@c", _c2 ), ROW ( "@id", 3, "@i", _i3, "@u", _u3, "@c", _c3 ),
        ROW ( "@id", 4, "@i", _i4, "@u", _u4, "@c", _c4 ), ROW ( "@id", 5, "@i", _i5, "@u", _u5, "@c", _c5 )
    )
VAR _t1 = ADDCOLUMNS ( _t0, "@k", SWITCH ( _ord, 2, [@u] * 1e12 + [@i] * [@c], 3, [@c] * 1e12 + [@i], [@i] * [@c] * [@u] / 3 ) )
VAR _t2 = ADDCOLUMNS ( _t1, "@r", VAR _k = [@k] RETURN COUNTROWS ( FILTER ( _t1, [@k] > _k ) ) + 1 )
VAR _r1 = MAXX ( FILTER ( _t2, [@id] = 1 ), [@r] )
VAR _r2 = MAXX ( FILTER ( _t2, [@id] = 2 ), [@r] )
VAR _r3 = MAXX ( FILTER ( _t2, [@id] = 3 ), [@r] )
VAR _r4 = MAXX ( FILTER ( _t2, [@id] = 4 ), [@r] )
VAR _r5 = MAXX ( FILTER ( _t2, [@id] = 5 ), [@r] )
VAR _h1 = "<div class='tk-dk" & IF ( _r1 = 1, " p1", IF ( _r1 = 2, " p2", "" ) ) & "'><div class='tk-dp'><span>" & "Estimado · urgência alta" & "</span><em>" & "Prioridade " & FORMAT ( _r1, "0" ) & "</em></div><div class='tk-dt'>" & "Risco de ruptura" & "</div><div class='tk-di'>" & IF ( ISBLANK ( _i1 ), "não estimado", SWITCH ( TRUE (), ISBLANK ( _i1 ), "–", ABS ( _i1 ) >= 1e9, "R$ " & FORMAT ( _i1 / 1e9, "#,0.00", "pt-BR" ) & " bi", ABS ( _i1 ) >= 1e6, "R$ " & FORMAT ( _i1 / 1e6, "#,0.0", "pt-BR" ) & " mi", ABS ( _i1 ) >= 1e3, "R$ " & FORMAT ( _i1 / 1e3, "#,0", "pt-BR" ) & " mil", "R$ " & FORMAT ( _i1, "#,0", "pt-BR" ) ) ) & "</div><div class='tk-dl'>Evidência</div><div class='tk-dx'>" & FORMAT ( [Itens Cobertura < Lead Time], "#,0", "pt-BR" ) & " SKU × filial com cobertura menor que o lead time e " & FORMAT ( [Itens em Ruptura], "#,0", "pt-BR" ) & " zerados no snapshot de " & FORMAT ( [Data Último Snapshot], "dd/MM/yyyy" ) & ". Impacto: dias descobertos × receita diária de 90 dias." & "</div><div class='tk-dl'>Ação sugerida</div><div class='tk-dx'>" & "Antecipar pedidos dos itens críticos de curva A e remanejar saldo entre filiais." & "</div><div class='tk-dl'>Responsável sugerido</div><div class='tk-dx'>" & "Supply e Compras" & "</div></div>"
VAR _h2 = "<div class='tk-dk" & IF ( _r2 = 1, " p1", IF ( _r2 = 2, " p2", "" ) ) & "'><div class='tk-dp'><span>" & "Observado · urgência " & IF ( _u2 = 3, "alta", "média" ) & "</span><em>" & "Prioridade " & FORMAT ( _r2, "0" ) & "</em></div><div class='tk-dt'>" & "Queda de margem" & "</div><div class='tk-di'>" & IF ( ISBLANK ( _i2 ), "não estimado", SWITCH ( TRUE (), ISBLANK ( _i2 ), "–", ABS ( _i2 ) >= 1e9, "R$ " & FORMAT ( _i2 / 1e9, "#,0.00", "pt-BR" ) & " bi", ABS ( _i2 ) >= 1e6, "R$ " & FORMAT ( _i2 / 1e6, "#,0.0", "pt-BR" ) & " mi", ABS ( _i2 ) >= 1e3, "R$ " & FORMAT ( _i2 / 1e3, "#,0", "pt-BR" ) & " mil", "R$ " & FORMAT ( _i2, "#,0", "pt-BR" ) ) ) & "</div><div class='tk-dl'>Evidência</div><div class='tk-dx'>" & "MC de " & FORMAT ( [MC %], "0.0%", "pt-BR" ) & " contra " & FORMAT ( [MC % LY], "0.0%", "pt-BR" ) & " no ano anterior (" & FORMAT ( _pp, "+0.0;-0.0", "pt-BR" ) & " p.p.). Maior perda em " & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _catN, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ) & "." & "</div><div class='tk-dl'>Ação sugerida</div><div class='tk-dx'>" & "Revisar repasse de custo e política de desconto em " & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _catN, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ) & "." & "</div><div class='tk-dl'>Responsável sugerido</div><div class='tk-dx'>" & "Pricing e Diretoria Comercial" & "</div></div>"
VAR _h3 = "<div class='tk-dk" & IF ( _r3 = 1, " p1", IF ( _r3 = 2, " p2", "" ) ) & "'><div class='tk-dp'><span>" & "Hipotético · urgência baixa" & "</span><em>" & "Prioridade " & FORMAT ( _r3, "0" ) & "</em></div><div class='tk-dt'>" & "Cross-sell" & "</div><div class='tk-di'>" & IF ( ISBLANK ( _i3 ), "não estimado", SWITCH ( TRUE (), ISBLANK ( _i3 ), "–", ABS ( _i3 ) >= 1e9, "R$ " & FORMAT ( _i3 / 1e9, "#,0.00", "pt-BR" ) & " bi", ABS ( _i3 ) >= 1e6, "R$ " & FORMAT ( _i3 / 1e6, "#,0.0", "pt-BR" ) & " mi", ABS ( _i3 ) >= 1e3, "R$ " & FORMAT ( _i3 / 1e3, "#,0", "pt-BR" ) & " mil", "R$ " & FORMAT ( _i3, "#,0", "pt-BR" ) ) & " ao mês" ) & "</div><div class='tk-dl'>Evidência</div><div class='tk-dx'>" & FORMAT ( MAXX ( _cs, [@n] ), "#,0", "pt-BR" ) & " clientes ativos não compram " & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( MAXX ( _cs, dProduto[Categoria] ), "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ) & " (penetração de " & FORMAT ( MAXX ( _cs, [@p] ), "0%", "pt-BR" ) & "). Premissa: metade da receita média mensal por comprador." & "</div><div class='tk-dl'>Ação sugerida</div><div class='tk-dx'>" & "Campanha dirigida de " & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( MAXX ( _cs, dProduto[Categoria] ), "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ) & " para a base que já compra outras linhas." & "</div><div class='tk-dl'>Responsável sugerido</div><div class='tk-dx'>" & "Vendedores e Marketing" & "</div></div>"
VAR _h4 = "<div class='tk-dk" & IF ( _r4 = 1, " p1", IF ( _r4 = 2, " p2", "" ) ) & "'><div class='tk-dp'><span>" & "Estimado · urgência baixa" & "</span><em>" & "Prioridade " & FORMAT ( _r4, "0" ) & "</em></div><div class='tk-dt'>" & "Potencial comercial" & "</div><div class='tk-di'>" & IF ( ISBLANK ( _i4 ), "não estimado", SWITCH ( TRUE (), ISBLANK ( _i4 ), "–", ABS ( _i4 ) >= 1e9, "R$ " & FORMAT ( _i4 / 1e9, "#,0.00", "pt-BR" ) & " bi", ABS ( _i4 ) >= 1e6, "R$ " & FORMAT ( _i4 / 1e6, "#,0.0", "pt-BR" ) & " mi", ABS ( _i4 ) >= 1e3, "R$ " & FORMAT ( _i4 / 1e3, "#,0", "pt-BR" ) & " mil", "R$ " & FORMAT ( _i4, "#,0", "pt-BR" ) ) & " ao mês" ) & "</div><div class='tk-dl'>Evidência</div><div class='tk-dx'>" & "Share of wallet estimado de " & FORMAT ( [Share Estimado %], "0%", "pt-BR" ) & ". Gap de " & SWITCH ( TRUE (), ISBLANK ( [Gap Potencial Estimado] ), "–", ABS ( [Gap Potencial Estimado] ) >= 1e9, "R$ " & FORMAT ( [Gap Potencial Estimado] / 1e9, "#,0.00", "pt-BR" ) & " bi", ABS ( [Gap Potencial Estimado] ) >= 1e6, "R$ " & FORMAT ( [Gap Potencial Estimado] / 1e6, "#,0.0", "pt-BR" ) & " mi", ABS ( [Gap Potencial Estimado] ) >= 1e3, "R$ " & FORMAT ( [Gap Potencial Estimado] / 1e3, "#,0", "pt-BR" ) & " mil", "R$ " & FORMAT ( [Gap Potencial Estimado], "#,0", "pt-BR" ) ) & " ao mês contra o potencial cadastral, que é hipótese e não mercado medido." & "</div><div class='tk-dl'>Ação sugerida</div><div class='tk-dx'>" & "Priorizar visitas aos clientes de maior gap com margem acima da média." & "</div><div class='tk-dl'>Responsável sugerido</div><div class='tk-dx'>" & "Gerência Comercial" & "</div></div>"
VAR _h5 = "<div class='tk-dk" & IF ( _r5 = 1, " p1", IF ( _r5 = 2, " p2", "" ) ) & "'><div class='tk-dp'><span>" & "Observado · urgência média" & "</span><em>" & "Prioridade " & FORMAT ( _r5, "0" ) & "</em></div><div class='tk-dt'>" & "Inadimplência antiga" & "</div><div class='tk-di'>" & IF ( ISBLANK ( _i5 ), "não estimado", SWITCH ( TRUE (), ISBLANK ( _i5 ), "–", ABS ( _i5 ) >= 1e9, "R$ " & FORMAT ( _i5 / 1e9, "#,0.00", "pt-BR" ) & " bi", ABS ( _i5 ) >= 1e6, "R$ " & FORMAT ( _i5 / 1e6, "#,0.0", "pt-BR" ) & " mi", ABS ( _i5 ) >= 1e3, "R$ " & FORMAT ( _i5 / 1e3, "#,0", "pt-BR" ) & " mil", "R$ " & FORMAT ( _i5, "#,0", "pt-BR" ) ) ) & "</div><div class='tk-dl'>Evidência</div><div class='tk-dx'>" & "Títulos vencidos há mais de 90 dias em " & FORMAT ( [Data Corte], "dd/MM/yyyy" ) & ". Vencido total de " & SWITCH ( TRUE (), ISBLANK ( [Vencido] ), "–", ABS ( [Vencido] ) >= 1e9, "R$ " & FORMAT ( [Vencido] / 1e9, "#,0.00", "pt-BR" ) & " bi", ABS ( [Vencido] ) >= 1e6, "R$ " & FORMAT ( [Vencido] / 1e6, "#,0.0", "pt-BR" ) & " mi", ABS ( [Vencido] ) >= 1e3, "R$ " & FORMAT ( [Vencido] / 1e3, "#,0", "pt-BR" ) & " mil", "R$ " & FORMAT ( [Vencido], "#,0", "pt-BR" ) ) & " (" & FORMAT ( [Vencido %], "0%", "pt-BR" ) & " do aberto)." & "</div><div class='tk-dl'>Ação sugerida</div><div class='tk-dx'>" & "Rever limite de crédito e condicionar novos pedidos à regularização." & "</div><div class='tk-dl'>Responsável sugerido</div><div class='tk-dx'>" & "Financeiro e Crédito" & "</div></div>"
VAR _html = UNION ( ROW ( "@r", _r1, "@h", _h1 ), ROW ( "@r", _r2, "@h", _h2 ), ROW ( "@r", _r3, "@h", _h3 ), ROW ( "@r", _r4, "@h", _h4 ), ROW ( "@r", _r5, "@h", _h5 ) )
RETURN [HTML | CSS] & "<div class='tk tk-dc' style='height:100vh'>" & CONCATENATEX ( FILTER ( _html, [@r] <= 4 ), [@h], "", [@r], ASC ) & "</div>"
// formato: texto

// Cascata da economia da venda: receita bruta − descontos = receita líquida − CMV = margem bruta − frete − comissão = margem de contribuição. Sem impostos nem despesas fixas, que a base não tem.
[HTML | Waterfall Margem] =
VAR _rb = [Receita Bruta]
VAR _ds = [Descontos]
VAR _rl = [Receita Líquida]
VAR _cmv = [CMV]
VAR _mb = [Margem Bruta]
VAR _fr = [Frete]
VAR _co = [Comissão]
VAR _mc = [Margem Contribuição]
VAR _sc = DIVIDE ( 160, _rb )
RETURN
    IF ( ISBLANK ( _rb ), [HTML | CSS] & "<div class='tk' style='display:flex;align-items:center;justify-content:center;color:#6C737D;font-size:12px'>Sem vendas no contexto selecionado</div>",
        [HTML | CSS] & "<div class='tk'>" & "<svg class='tk-sv' viewBox='0 0 700 250' preserveAspectRatio='xMidYMid meet' font-family='Montserrat,Segoe UI,Arial'><line x1='16' y1='206' x2='684' y2='206' stroke='#C5CBD3' stroke-width='1'/>" & "<rect x='20.0' y='" & FORMAT ( ( 206 - ( _rb ) * _sc ), "0.0", "en-US" ) & "' width='54' height='" & FORMAT ( MAX ( 1.5, 206 - ( 206 - ( _rb ) * _sc ) ), "0.0", "en-US" ) & "' rx='3' fill='" & "#0B1F33" & "'/>" & "<line x1='74.0' x2='106.6' y1='" & FORMAT ( ( 206 - ( _rb ) * _sc ), "0.0", "en-US" ) & "' y2='" & FORMAT ( ( 206 - ( _rb ) * _sc ), "0.0", "en-US" ) & "' stroke='#9AA3AE' stroke-width='1' stroke-dasharray='3 2'/>" & "<text x='47.0' y='" & FORMAT ( ( 206 - ( _rb ) * _sc ) - 6, "0.0", "en-US" ) & "' text-anchor='middle' font-size='11' font-weight='700' fill='#0B1F33'>" & SWITCH ( TRUE (), ISBLANK ( _rb ), "–", ABS ( _rb ) >= 1e9, "R$ " & FORMAT ( _rb / 1e9, "#,0.00", "pt-BR" ) & " bi", ABS ( _rb ) >= 1e6, "R$ " & FORMAT ( _rb / 1e6, "#,0.0", "pt-BR" ) & " mi", ABS ( _rb ) >= 1e3, "R$ " & FORMAT ( _rb / 1e3, "#,0", "pt-BR" ) & " mil", "R$ " & FORMAT ( _rb, "#,0", "pt-BR" ) ) & "</text>" & "<text x='47.0' y='221' text-anchor='middle' font-size='10' font-weight='700' fill='#16212E'>Receita bruta</text>" & "<text x='47.0' y='234' text-anchor='middle' font-size='9.5' font-weight='500' fill='#6C737D'>" & "100%" & "</text>" & "<rect x='106.6' y='" & FORMAT ( ( 206 - ( _rb ) * _sc ), "0.0", "en-US" ) & "' width='54' height='" & FORMAT ( MAX ( 1.5, ( 206 - ( _rl ) * _sc ) - ( 206 - ( _rb ) * _sc ) ), "0.0", "en-US" ) & "' rx='3' fill='" & "#E31E24" & "'/>" & "<line x1='160.6' x2='193.1' y1='" & FORMAT ( ( 206 - ( _rl ) * _sc ), "0.0", "en-US" ) & "' y2='" & FORMAT ( ( 206 - ( _rl ) * _sc ), "0.0", "en-US" ) & "' stroke='#9AA3AE' stroke-width='1' stroke-dasharray='3 2'/>" & "<text x='133.6' y='" & FORMAT ( ( 206 - ( _rb ) * _sc ) - 6, "0.0", "en-US" ) & "' text-anchor='middle' font-size='11' font-weight='700' fill='#0B1F33'>" & "−" & SWITCH ( TRUE (), ISBLANK ( _ds ), "–", ABS ( _ds ) >= 1e9, "R$ " & FORMAT ( _ds / 1e9, "#,0.00", "pt-BR" ) & " bi", ABS ( _ds ) >= 1e6, "R$ " & FORMAT ( _ds / 1e6, "#,0.0", "pt-BR" ) & " mi", ABS ( _ds ) >= 1e3, "R$ " & FORMAT ( _ds / 1e3, "#,0", "pt-BR" ) & " mil", "R$ " & FORMAT ( _ds, "#,0", "pt-BR" ) ) & "</text>" & "<text x='133.6' y='221' text-anchor='middle' font-size='10' font-weight='700' fill='#16212E'>Descontos</text>" & "<text x='133.6' y='234' text-anchor='middle' font-size='9.5' font-weight='500' fill='#6C737D'>" & IF ( ISBLANK ( DIVIDE ( _ds, _rb ) ), "–", FORMAT ( DIVIDE ( _ds, _rb ), "0.0%", "pt-BR" ) ) & "</text>" & "<rect x='193.1' y='" & FORMAT ( ( 206 - ( _rl ) * _sc ), "0.0", "en-US" ) & "' width='54' height='" & FORMAT ( MAX ( 1.5, 206 - ( 206 - ( _rl ) * _sc ) ), "0.0", "en-US" ) & "' rx='3' fill='" & "#3D5571" & "'/>" & "<line x1='247.1' x2='279.7' y1='" & FORMAT ( ( 206 - ( _rl ) * _sc ), "0.0", "en-US" ) & "' y2='" & FORMAT ( ( 206 - ( _rl ) * _sc ), "0.0", "en-US" ) & "' stroke='#9AA3AE' stroke-width='1' stroke-dasharray='3 2'/>" & "<text x='220.1' y='" & FORMAT ( ( 206 - ( _rl ) * _sc ) - 6, "0.0", "en-US" ) & "' text-anchor='middle' font-size='11' font-weight='700' fill='#0B1F33'>" & SWITCH ( TRUE (), ISBLANK ( _rl ), "–", ABS ( _rl ) >= 1e9, "R$ " & FORMAT ( _rl / 1e9, "#,0.00", "pt-BR" ) & " bi", ABS ( _rl ) >= 1e6, "R$ " & FORMAT ( _rl / 1e6, "#,0.0", "pt-BR" ) & " mi", ABS ( _rl ) >= 1e3, "R$ " & FORMAT ( _rl / 1e3, "#,0", "pt-BR" ) & " mil", "R$ " & FORMAT ( _rl, "#,0", "pt-BR" ) ) & "</text>" & "<text x='220.1' y='221' text-anchor='middle' font-size='10' font-weight='700' fill='#16212E'>Receita líquida</text>" & "<text x='220.1' y='234' text-anchor='middle' font-size='9.5' font-weight='500' fill='#6C737D'>" & IF ( ISBLANK ( DIVIDE ( _rl, _rb ) ), "–", FORMAT ( DIVIDE ( _rl, _rb ), "0.0%", "pt-BR" ) ) & "</text>" & "<rect x='279.7' y='" & FORMAT ( ( 206 - ( _rl ) * _sc ), "0.0", "en-US" ) & "' width='54' height='" & FORMAT ( MAX ( 1.5, ( 206 - ( _mb ) * _sc ) - ( 206 - ( _rl ) * _sc ) ), "0.0", "en-US" ) & "' rx='3' fill='" & "#E31E24" & "'/>" & "<line x1='333.7' x2='366.3' y1='" & FORMAT ( ( 206 - ( _mb ) * _sc ), "0.0", "en-US" ) & "' y2='" & FORMAT ( ( 206 - ( _mb ) * _sc ), "0.0", "en-US" ) & "' stroke='#9AA3AE' stroke-width='1' stroke-dasharray='3 2'/>" & "<text x='306.7' y='" & FORMAT ( ( 206 - ( _rl ) * _sc ) - 6, "0.0", "en-US" ) & "' text-anchor='middle' font-size='11' font-weight='700' fill='#0B1F33'>" & "−" & SWITCH ( TRUE (), ISBLANK ( _cmv ), "–", ABS ( _cmv ) >= 1e9, "R$ " & FORMAT ( _cmv / 1e9, "#,0.00", "pt-BR" ) & " bi", ABS ( _cmv ) >= 1e6, "R$ " & FORMAT ( _cmv / 1e6, "#,0.0", "pt-BR" ) & " mi", ABS ( _cmv ) >= 1e3, "R$ " & FORMAT ( _cmv / 1e3, "#,0", "pt-BR" ) & " mil", "R$ " & FORMAT ( _cmv, "#,0", "pt-BR" ) ) & "</text>" & "<text x='306.7' y='221' text-anchor='middle' font-size='10' font-weight='700' fill='#16212E'>CMV</text>" & "<text x='306.7' y='234' text-anchor='middle' font-size='9.5' font-weight='500' fill='#6C737D'>" & IF ( ISBLANK ( DIVIDE ( _cmv, _rb ) ), "–", FORMAT ( DIVIDE ( _cmv, _rb ), "0.0%", "pt-BR" ) ) & "</text>" & "<rect x='366.3' y='" & FORMAT ( ( 206 - ( _mb ) * _sc ), "0.0", "en-US" ) & "' width='54' height='" & FORMAT ( MAX ( 1.5, 206 - ( 206 - ( _mb ) * _sc ) ), "0.0", "en-US" ) & "' rx='3' fill='" & "#3D5571" & "'/>" & "<line x1='420.3' x2='452.9' y1='" & FORMAT ( ( 206 - ( _mb ) * _sc ), "0.0", "en-US" ) & "' y2='" & FORMAT ( ( 206 - ( _mb ) * _sc ), "0.0", "en-US" ) & "' stroke='#9AA3AE' stroke-width='1' stroke-dasharray='3 2'/>" & "<text x='393.3' y='" & FORMAT ( ( 206 - ( _mb ) * _sc ) - 6, "0.0", "en-US" ) & "' text-anchor='middle' font-size='11' font-weight='700' fill='#0B1F33'>" & SWITCH ( TRUE (), ISBLANK ( _mb ), "–", ABS ( _mb ) >= 1e9, "R$ " & FORMAT ( _mb / 1e9, "#,0.00", "pt-BR" ) & " bi", ABS ( _mb ) >= 1e6, "R$ " & FORMAT ( _mb / 1e6, "#,0.0", "pt-BR" ) & " mi", ABS ( _mb ) >= 1e3, "R$ " & FORMAT ( _mb / 1e3, "#,0", "pt-BR" 